<div class="page-content page-width">
  <h1 class="page-content__title">{{ page.title }}</h1>
  <div class="page-content__body rte">
    {{ page.content }}
  </div>
</div>

{% stylesheet %}
  .page-content {
    padding: 48px 0 80px;
    max-width: 800px;
  }

  .page-content__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .page-content__body {
    line-height: 1.8;
    font-size: 0.9375rem;
    color: #444;
  }

  .page-content__body h2 {
    font-size: 1.375rem;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    color: #111;
  }

  .page-content__body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 24px;
    margin-bottom: 8px;
    color: #222;
  }

  .page-content__body p {
    margin-bottom: 16px;
  }

  .page-content__body ul,
  .page-content__body ol {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .page-content__body li {
    margin-bottom: 8px;
  }

  .page-content__body a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page-content__body a:hover {
    color: #555;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
