{%- liquid
  assign newsletter_heading = section.settings.newsletter_heading
  assign newsletter_subtext = section.settings.newsletter_subtext
  assign about_heading = section.settings.about_heading
  assign about_text = section.settings.about_text
  assign contact_heading = section.settings.contact_heading
  assign contact_text = section.settings.contact_text
  assign contact_url = section.settings.contact_url
  assign show_newsletter = section.settings.show_newsletter
  assign show_social = section.settings.show_social
  assign show_payment = section.settings.show_payment
-%}

<footer class="footer-wtn" data-section-id="{{ section.id }}">
  {%- if show_newsletter -%}
    <div class="footer-wtn__newsletter full-width">
      <div class="footer-wtn__newsletter-inner page-width">
        <div class="footer-wtn__newsletter-content">
          <h2 class="footer-wtn__newsletter-title">{{ newsletter_heading }}</h2>
          <p class="footer-wtn__newsletter-text">{{ newsletter_subtext }}</p>
        </div>
        <div class="footer-wtn__newsletter-form">
          {% form 'customer', id: 'FooterNewsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer-wtn__newsletter-field">
              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required
                autocomplete="email"
                class="footer-wtn__newsletter-input"
              >
              <button type="submit" class="footer-wtn__newsletter-btn">
                {{ section.settings.newsletter_button_text }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="footer-wtn__main full-width">
    <div class="footer-wtn__main-inner page-width">
      <div class="footer-wtn__columns">
        {%- comment -%} Contact column {%- endcomment -%}
        <div class="footer-wtn__col footer-wtn__col--contact">
          <h3 class="footer-wtn__col-title">{{ contact_heading }}</h3>
          <a href="{{ contact_url }}" class="footer-wtn__contact-link">
            <span class="footer-wtn__contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" fill="currentColor"/>
              </svg>
            </span>
            <span class="footer-wtn__contact-label">{{ section.settings.contact_link_text }}</span>
          </a>
          <p class="footer-wtn__contact-desc">{{ contact_text }}</p>
        </div>

        {%- comment -%} About column {%- endcomment -%}
        <div class="footer-wtn__col footer-wtn__col--about">
          <h3 class="footer-wtn__col-title">{{ about_heading }}</h3>
          <p class="footer-wtn__about-text">{{ about_text }}</p>
          <h4 class="footer-wtn__col-subtitle">{{ section.settings.about_links_heading }}</h4>
          <ul class="footer-wtn__link-list">
            {%- for link in section.settings.menu_about.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Services column {%- endcomment -%}
        {%- liquid
          assign faq_url = routes.root_url | append: 'pages/faq'
          assign has_faq_link = false
          for link in section.settings.menu_services.links
            assign menu_link_title = link.title | downcase
            if link.url contains '/pages/faq' or menu_link_title == 'faq'
              assign has_faq_link = true
              break
            endif
          endfor
        -%}
        <div class="footer-wtn__col footer-wtn__col--services">
          <h3 class="footer-wtn__col-title">{{ section.settings.services_heading }}</h3>
          <ul class="footer-wtn__link-list">
            {%- for link in section.settings.menu_services.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
            {%- unless has_faq_link -%}
              <li><a href="{{ faq_url }}">FAQ</a></li>
            {%- endunless -%}
          </ul>
        </div>

        {%- comment -%} Collections column {%- endcomment -%}
        <div class="footer-wtn__col footer-wtn__col--collections">
          <h3 class="footer-wtn__col-title">{{ section.settings.collections_heading }}</h3>
          <ul class="footer-wtn__link-list">
            {%- for link in section.settings.menu_collections.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Social column {%- endcomment -%}
        {%- if show_social -%}
          <div class="footer-wtn__col footer-wtn__col--social">
            <h3 class="footer-wtn__col-title">{{ section.settings.social_heading }}</h3>
            <div class="footer-wtn__social-icons">
              {%- if settings.social_instagram_link != blank -%}
                <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05A6.34 6.34 0 003.15 15.3a6.34 6.34 0 0010.86 4.48c1.77-1.77 2.63-4.16 2.63-6.29V9.4a8.16 8.16 0 004.95 1.67V7.63a4.83 4.83 0 01-2-.94z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_twitter_link != blank -%}
                <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.174.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="footer-wtn__bottom full-width">
    <div class="footer-wtn__bottom-inner page-width">
      <div class="footer-wtn__legal">
        {%- for link in section.settings.menu_legal.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- unless forloop.last -%}<span class="footer-wtn__legal-sep"></span>{%- endunless -%}
        {%- endfor -%}
      </div>

      {%- if show_payment -%}
        <div class="footer-wtn__payment">
          <span class="footer-wtn__payment-label">{{ section.settings.payment_heading }}</span>
          <div class="footer-wtn__payment-icons">
            {% for type in shop.enabled_payment_types %}
              {{ type | payment_type_svg_tag }}
            {% endfor %}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_carriers -%}
        <div class="footer-wtn__carriers">
          <span class="footer-wtn__carriers-label">{{ section.settings.carriers_heading }}</span>
          <div class="footer-wtn__carriers-icons">
            {%- if section.settings.carrier_image != blank -%}
              <img
                src="{{ section.settings.carrier_image | image_url: width: 80 }}"
                alt="DHL"
                width="80"
                height="auto"
                loading="lazy"
              >
            {%- else -%}
              <span class="footer-wtn__carrier-placeholder">DHL</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="footer-wtn__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Resell Lausanne",
  "class": "footer-wtn-section",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Afficher la newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Titre newsletter",
      "default": "La newsletter Resell Lausanne"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Sous-titre newsletter",
      "default": "Rejoignez la team et bénéficiez de 10 CHF offerts sur votre première commande dès 150.- d'achat."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Placeholder email",
      "default": "Votre adresse e-mail"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Texte bouton",
      "default": "S'inscrire"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Titre contact",
      "default": "Nous contacter"
    },
    {
      "type": "text",
      "id": "contact_link_text",
      "label": "Texte lien contact",
      "default": "Portail de contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "URL contact"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Description contact",
      "default": "Notre équipe s'engage à vous répondre en 24 à 48h ouvrées."
    },
    {
      "type": "header",
      "content": "À propos"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "Titre à propos",
      "default": "À propos de Resell Lausanne"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Texte à propos",
      "default": "Resell Lausanne a pour mission de donner la possibilité à tous les amateurs, les passionnés et les curieux de sneakers et streetwear d'acheter les produits limités qui leur plaisent en toute confiance."
    },
    {
      "type": "text",
      "id": "about_links_heading",
      "label": "Titre liens à propos",
      "default": "En savoir plus"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "Menu À propos"
    },
    {
      "type": "header",
      "content": "Services"
    },
    {
      "type": "text",
      "id": "services_heading",
      "label": "Titre services",
      "default": "Nos services"
    },
    {
      "type": "link_list",
      "id": "menu_services",
      "label": "Menu Services"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "text",
      "id": "collections_heading",
      "label": "Titre collections",
      "default": "Nos collections"
    },
    {
      "type": "link_list",
      "id": "menu_collections",
      "label": "Menu Collections"
    },
    {
      "type": "header",
      "content": "Réseaux sociaux"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Afficher réseaux sociaux",
      "default": true
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Titre réseaux sociaux",
      "default": "Retrouvez nous sur"
    },
    {
      "type": "header",
      "content": "Barre inférieure"
    },
    {
      "type": "link_list",
      "id": "menu_legal",
      "label": "Menu mentions légales"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Afficher moyens de paiement",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Titre paiement",
      "default": "Moyens de paiement"
    },
    {
      "type": "checkbox",
      "id": "show_carriers",
      "label": "Afficher transporteurs",
      "default": true
    },
    {
      "type": "text",
      "id": "carriers_heading",
      "label": "Titre transporteurs",
      "default": "Transporteurs"
    },
    {
      "type": "image_picker",
      "id": "carrier_image",
      "label": "Image transporteur"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
