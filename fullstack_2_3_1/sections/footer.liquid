<footer
  class="footer rl-footer-premium footer--grid color-{{ section.settings.color_scheme }} {% if section.settings.show_top_border %}footer--top-border{% endif %}"
  data-ref="footer"
>
  <div class="rl-footer-top">
    <div class="rl-footer-grid rl-footer-grid--top">
      {% content_for 'blocks' %}
    </div>
  </div>

  <template id="rl-footer-acc-tpl">
    <div class="rl-footer-mobile-accordions" aria-hidden="false">
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.contact_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-contact' %}</div>
      </details>
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.about_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-about' %}</div>
      </details>
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.learn_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-brand-links' %}</div>
      </details>
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.brands_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-marques-links' %}</div>
      </details>
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.services_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-aide-links' %}</div>
      </details>
      <details class="rl-footer-acc">
        <summary class="rl-footer-acc__summary">
          <span>{{ 'rl_footer.social_heading' | t }}</span>
          <svg class="rl-footer-acc__chevron" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="rl-footer-acc__body">{% render 'footer-resell-social-column' %}</div>
      </details>
    </div>
  </template>
  <script>
    (function(){
      if(window.matchMedia('(min-width:768px)').matches)return;
      var t=document.getElementById('rl-footer-acc-tpl');
      if(t){t.parentNode.insertBefore(t.content,t);t.remove();}
    })();
  </script>

  <div class="rl-footer-bottom">
    <div class="rl-footer-grid rl-footer-grid--bottom">
      <div class="rl-footer-bottom__legal">
        {% content_for 'block', type: '_footer-policy-list', id: 'footer-policy-list' %}
      </div>
      <div class="rl-footer-bottom__meta">
        {% content_for 'block', type: '_footer-bottom-bar', id: 'footer-bottom-bar' %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:footer",
  "class": "footer-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_footer-bottom-bar"
    },
    {
      "type": "_footer-policy-list"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "color-scheme-3"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "t:show_top_border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "t:footer_1",
      "settings": {
        "color_scheme": "scheme-3",
        "show_top_border": false
      }
    }
  ]
}
{% endschema %}
