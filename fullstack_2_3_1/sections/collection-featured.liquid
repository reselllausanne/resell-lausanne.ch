{% if section.settings.collection %}
  {% liquid
    assign collection = section.settings.collection | default: collections.all

    assign collection_products = collection.products

    if template.name == 'cart'
      for cart_item in cart.items
        assign collection_products = collection_products | reject: 'id', cart_item.product.id
      endfor
    endif

    assign rl_slider_layout = section.settings.rl_slider_layout | default: 'default'
    if rl_slider_layout == 'default' and section.settings.layout_type == 'slider'
      assign rl_ac_fb = section.settings.additional_class | default: ''
      if rl_ac_fb contains 'rl-pdp-product-slider'
        assign rl_slider_layout = 'pdp'
      elsif rl_ac_fb contains 'rl-home-collection-rail'
        assign rl_slider_layout = 'home_rail'
      endif
    endif

    assign rl_pdp_slider = false
    assign rl_home_rail = false
    if rl_slider_layout == 'pdp'
      assign rl_pdp_slider = true
    elsif rl_slider_layout == 'home_rail'
      assign rl_home_rail = true
    endif
    assign rl_home_rail_early = rl_home_rail
    assign rl_arrow_rail = false
    if rl_pdp_slider or rl_home_rail
      assign rl_arrow_rail = true
    endif
  %}

  <div
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id }}"
    {% endif %}
    class="
      collection-featured color-{{ section.settings.color_scheme }}
      {%- if section.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
      {%- if section.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
      {%- if rl_pdp_slider %} rl-pdp-product-slider{% endif -%}
      {%- if rl_home_rail %} rl-home-collection-rail{% endif -%}
      {%- if section.settings.additional_class != blank %} {{ section.settings.additional_class }}{% endif -%}
    "
    style="
      --margin-top: {{ section.settings.margin_top }}px;
      --margin-bottom: {{ section.settings.margin_bottom }}px
    "
  >
    {%- if rl_home_rail_early -%}
      <style>
        #shopify-section-{{ section.id }} .product-card .product-card-media-gallery-block,
        #shopify-section-{{ section.id }} product-card-media-gallery.product-card-media-gallery-block {
          aspect-ratio: unset !important;
          height: auto !important;
          min-height: 0 !important;
          padding: 0 !important;
          background: transparent !important;
          display: block !important;
        }

        #shopify-section-{{ section.id }} .splide__slide,
        #shopify-section-{{ section.id }} .splide__slide > .slide,
        #shopify-section-{{ section.id }} product-card {
          height: auto !important;
          min-height: 0 !important;
        }
      </style>
    {%- endif -%}
    <div
      class="collection-featured__inner page-width"
      style="
        --padding-top: {{ section.settings.padding_top }}px;
        --padding-bottom: {{ section.settings.padding_bottom }}px
      "
    >
      {% if rl_arrow_rail %}
        <div class="collection-featured__railBlock">
      {% endif %}

      <div class="collection-featured__headerRow">
        <div class="collection-featured__headerLeft">
          {% content_for 'blocks' %}
        </div>
      </div>

      {% if section.settings.layout_type == 'grid' %}
        <div
          class="collection-featured__grid"
          style="
            --grid-columns: {{ section.settings.grid_columns }};
            --grid-columns-mobile: {{ section.settings.grid_columns_mobile }};
          "
        >
          {% for product in collection_products limit: section.settings.max_products %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
          {% endfor %}
        </div>
      {% elsif section.settings.layout_type == 'slider' %}
        {% capture slides %}
        {% for product in collection_products limit: section.settings.max_products %}
          <li class="splide__slide">
            <div class="slide" style="--gap: 0px; --margin-top: 0px; --margin-bottom: 0px;">
              {% # theme-check-disable %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}
            </div>
          </li>
        {% endfor %}
      {% endcapture %}

        {% liquid
          assign slider_no_drag_extra = ''
          if rl_home_rail or rl_pdp_slider
            assign slider_gap = 16
            assign slider_no_drag_extra = '.product-card .splide, .product-card .splide *, .product-card slider-component, .product-card slider-component *'
          elsif settings.grids_vertical_gap == 'very_small'
            assign slider_gap = 5
          elsif settings.grids_vertical_gap == 'small'
            assign slider_gap = 8
          elsif settings.grids_vertical_gap == 'normal'
            assign slider_gap = 16
          elsif settings.grids_vertical_gap == 'larger'
            assign slider_gap = 32
          elsif settings.grids_vertical_gap == 'largest'
            assign slider_gap = 48
          else
            assign slider_gap = 16
          endif
        %}

        {% render 'slider',
          block: section,
          slides: slides,
          gap: slider_gap,
          per_page_desktop: section.settings.slider_items,
          per_page_mobile: section.settings.slider_items_mobile,
          show_arrows: section.settings.show_arrows,
          arrows_button_style: section.settings.arrows_button_style,
          show_pagination: section.settings.show_pagination,
          rewind: section.settings.rewind,
          no_drag_extra: slider_no_drag_extra,
          disable_bleed: rl_arrow_rail,
          omit_end: rl_arrow_rail,
          auto_height: false
        %}
      {% endif %}

      {% if rl_arrow_rail %}
        </div>
      {% endif %}

      {% if rl_arrow_rail %}
        <script>
          (function () {
            var section = document.getElementById('shopify-section-{{ section.id }}');
            if (!section) return;

            function configureSplide() {
              var root = section.querySelector('[data-ref="main-slider"]');
              var splide = root && root.splide;
              if (!splide) return false;

              var mql = window.matchMedia('(min-width: 768px)');
              var apply = function () {
                if (mql.matches) {
                  splide.options.drag = false;
                  if (splide.Components && splide.Components.Drag) {
                    splide.Components.Drag.disable(true);
                  }
                } else {
                  splide.options.drag = true;
                  if (splide.Components && splide.Components.Drag) {
                    splide.Components.Drag.disable(false);
                  }
                }
              };

              apply();
              mql.addEventListener('change', apply);
              return true;
            }

            if (!configureSplide()) {
              var tries = 0;
              var timer = setInterval(function () {
                tries += 1;
                if (configureSplide() || tries > 40) clearInterval(timer);
              }, 100);
            }
          })();
        </script>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .collection-featured {
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  shopify-visual-preview-block-list .collection-featured .splide__arrow {
    display: none !important;
  }

  .collection-featured__inner {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .collection-featured__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
    column-gap: var(--grid-gap-vertical);
    row-gap: var(--grid-gap-horizontal);
  }

  @media (width > 750px) {
    .collection-featured__grid {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }
  }

  .collection-featured.rl-pdp-recommendations .product-card .product-card-media-gallery-block:not(:has(.splide)) {
    aspect-ratio: 4 / 5;
    width: 100%;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .collection-featured.rl-pdp-recommendations .product-card .product-card-media-gallery-block:not(:has(.splide)) .product-card-media-gallery__media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    background: transparent;
  }

  .collection-featured.rl-pdp-recommendations .product-card .product-media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-featured.rl-pdp-recommendations .product-card .product-media img {
    aspect-ratio: unset !important;
    width: auto !important;
    max-width: 92%;
    height: auto;
    max-height: 92%;
    object-fit: contain;
  }

  .collection-featured__railBlock {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    position: relative;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide,
  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide {
    overflow-x: clip;
    overflow-y: visible;
    position: static;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__inner,
  .collection-featured.rl-home-collection-rail .collection-featured__inner {
    overflow: visible;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__headerRow,
  .collection-featured.rl-home-collection-rail .collection-featured__headerRow {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    position: relative;
    padding-right: 104px;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__arrows,
  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__arrows {
    position: absolute;
    top: 0;
    right: 0;
    left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 6;
    margin: 0;
    width: auto;
    height: auto;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__arrows {
    top: -33px;
  }

  @media (width <= 750px) {
    .collection-featured.rl-pdp-product-slider .collection-featured__headerRow,
    .collection-featured.rl-home-collection-rail .collection-featured__headerRow {
      margin-bottom: 12px;
      padding-right: 88px;
    }
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__arrows > .splide__arrow,
  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__arrows > .splide__arrow {
    width: 45px !important;
    min-width: 45px !important;
    max-width: 45px !important;
    height: 45px !important;
    min-height: 45px !important;
    max-height: 45px !important;
    inline-size: 45px !important;
    block-size: 45px !important;
    border-radius: 4px;
    background: #fff;
    border: 1px solid #ccc;
    color: #080808;
    opacity: 1;
  }

  .collection-featured.rl-home-collection-rail {
    margin-top: 80px;
    margin-bottom: 0;
  }

  /* Home + PDP sliders: page-x gutter, grid-based card width, 16px slide gap (resize-safe) */
  .collection-featured.rl-home-collection-rail .collection-featured__inner,
  .collection-featured.rl-pdp-product-slider .collection-featured__inner {
    width: 100%;
    max-width: none !important;
    box-sizing: border-box;
    padding-left: var(--page-x) !important;
    padding-right: var(--page-x) !important;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__inner {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component,
  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component {
    width: 100%;
    min-width: 0;
    display: block;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track,
  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track {
    overflow: hidden;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list,
  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list {
    gap: 0 !important;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list > .splide__slide,
  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list > .splide__slide {
    flex: 0 0 auto;
    width: calc(var(--grid-column) * 3 + var(--grid-gap) * 2) !important;
    margin-right: 16px !important;
    height: auto !important;
    min-height: 0 !important;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list > .splide__slide:last-child,
  .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list > .splide__slide:last-child {
    margin-right: 0 !important;
  }

  .collection-featured.rl-home-collection-rail .splide__slide > .slide,
  .collection-featured.rl-pdp-product-slider .splide__slide > .slide {
    height: auto !important;
    min-height: 0 !important;
  }

  .collection-featured.rl-home-collection-rail product-card,
  .collection-featured.rl-pdp-product-slider product-card {
    gap: 8px !important;
    --gap: 8px !important;
    height: auto !important;
    min-height: 0 !important;
  }

  .collection-featured.rl-pdp-product-slider .product-card h2,
  .collection-featured.rl-pdp-product-slider .product-card-group h2,
  .collection-featured.rl-pdp-product-slider .text-block h2 {
    margin: 0 !important;
    font-size: 13px !important;
    line-height: 17px !important;
    font-weight: 500 !important;
    letter-spacing: normal !important;
  }

  .collection-featured.rl-pdp-product-slider .product-card .price-container,
  .collection-featured.rl-pdp-product-slider .product-card .price-container .price,
  .collection-featured.rl-pdp-product-slider .product-card .price-container .price-from,
  .collection-featured.rl-pdp-product-slider .product-card .price-container .compare-at-price {
    font-size: 13px !important;
    line-height: 17px !important;
  }

  .collection-featured.rl-pdp-product-slider .product-card-group {
    gap: 4px !important;
    --gap: 4px !important;
    min-height: 0 !important;
  }

  .collection-featured.rl-pdp-recommendations .price-container .price-from {
    font-size: 13px;
    font-weight: 400;
    line-height: 17px;
    color: #4d4d4d;
    opacity: 1;
  }

  .collection-featured.rl-pdp-recommendations .price-container .price {
    font-size: 13px;
    font-weight: 400;
    line-height: 17px;
    letter-spacing: normal;
    color: #4956ed;
  }

  .collection-featured.rl-pdp-recommendations .price-container .compare-at-price {
    font-size: 13px;
    font-weight: 400;
    line-height: 17px;
    color: #4d4d4d;
    opacity: 1;
  }

  .collection-featured.rl-pdp-product-slider .collection-featured__headerLeft h3 {
    margin: 0;
    font-size: 13px;
    line-height: 17px;
    font-weight: 500;
  }

  .collection-featured.rl-home-collection-rail .product-card .product-card-media-gallery-block,
  .collection-featured.rl-home-collection-rail product-card-media-gallery.product-card-media-gallery-block {
    aspect-ratio: unset !important;
    min-height: 0 !important;
    height: auto !important;
    padding: 0 !important;
    background: transparent !important;
    display: block !important;
  }

  .collection-featured.rl-home-collection-rail .product-card-media-gallery__media {
    aspect-ratio: 1 / 1 !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
    background: #f5f5f5;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-featured.rl-home-collection-rail .product-card-media-gallery__media .product-media {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    --ratio: 1 / 1 !important;
    aspect-ratio: unset !important;
  }

  .collection-featured.rl-home-collection-rail .product-card-media-gallery__media .product-media img {
    aspect-ratio: unset !important;
    width: 82% !important;
    height: 82% !important;
    max-width: 82% !important;
    max-height: 82% !important;
    object-fit: contain !important;
    display: block;
  }

  .collection-featured.rl-home-collection-rail .product-card h2,
  .collection-featured.rl-home-collection-rail .product-card-group h2,
  .collection-featured.rl-home-collection-rail .text-block h2 {
    margin: 0 !important;
    font-size: 13px !important;
    line-height: 17px !important;
    font-weight: 500 !important;
    letter-spacing: normal !important;
  }

  .collection-featured.rl-home-collection-rail .product-card .price-container,
  .collection-featured.rl-home-collection-rail .product-card .price-container .price,
  .collection-featured.rl-home-collection-rail .product-card .price-container .price-from,
  .collection-featured.rl-home-collection-rail .product-card .price-container .compare-at-price {
    font-size: 13px !important;
    line-height: 17px !important;
  }

  .collection-featured.rl-home-collection-rail .product-card-group {
    gap: 4px !important;
    --gap: 4px !important;
    min-height: 0 !important;
  }

  @media (width >= 768px) {
    .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track,
    .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track {
      overflow-x: hidden !important;
      overflow-y: hidden;
      touch-action: pan-y;
    }

    .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list,
    .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track > .splide__list {
      will-change: transform;
    }
  }

  @media (width < 768px) {
    .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track,
    .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .collection-featured.rl-home-collection-rail .collection-featured__railBlock > slider-component > .splide > .splide__track::-webkit-scrollbar,
    .collection-featured.rl-pdp-product-slider .collection-featured__railBlock > slider-component > .splide > .splide__track::-webkit-scrollbar {
      display: none;
    }
  }

  .collection-featured.rl-home-collection-rail .text-block.rl-home-cf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    flex-wrap: wrap;
  }

  .collection-featured.rl-home-collection-rail .text-block.rl-home-cf-head p {
    margin: 0;
  }

  .collection-featured.rl-home-collection-rail .text-block.rl-home-cf-head a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .collection-featured.rl-home-collection-rail .collection-featured__headerLeft h3 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.15rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .collection-featured.rl-home-collection-rail .text-block.rl-home-cf-head a {
    font-size: 0.92rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:collection_featured",
  "disabled_on": {
    "groups": ["header", "footer", "custom.cart_drawer", "custom.breadcrumbs"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:max_products",
      "min": 2,
      "max": 20,
      "default": 8,
      "step": 1
    },
    {
      "type": "header",
      "content": "t:layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:layout_type",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "t:grid" },
        { "value": "slider", "label": "t:slider" }
      ]
    },
    {
      "type": "header",
      "content": "t:grid",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "t:grid_columns_desktop",
      "min": 2,
      "max": 5,
      "default": 4,
      "step": 1,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "t:grid_columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:slider",
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "slider_items",
      "label": "t:slider_items",
      "min": 2,
      "max": 5,
      "default": 4,
      "step": 1,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "select",
      "id": "slider_items_mobile",
      "label": "t:slider_items_mobile",
