<script src="{{ 'product-card.js' | asset_url }}" type="module"></script>
<script src="{{ 'quick-add.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-recommendations.js' | asset_url }}" type="module"></script>

<product-recommendations
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id }}"
  {% endif %}
  class="
    product-recommendations color-{{ section.settings.color_scheme }}
    {%- if section.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
    {%- if section.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
    {{ section.settings.additional_class }}
  "
  style="
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px
  "
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div
    class="product-recommendations__inner page-width"
    style="
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div
        class="product-recommendations__grid"
        style="
          --grid-columns: {{ section.settings.grid_columns }};
          --grid-columns-mobile: {{ section.settings.grid_columns_mobile }};
        "
      >
        {% for product in recommendations.products limit: section.settings.max_products %}
          {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
        {% endfor %}
      </div>
    {% else %}
      {%- comment -%}
        SEO SSR fallback: render static <a> links so non-JS crawlers (Ahrefs, Bingbot, social previews)
        always see in-page links to related products. Removes "orphan product" issue on PDPs.
        Hydration: when the JS module fetches real recommendations, it replaces innerHTML and removes this block.
      {%- endcomment -%}
      {%- liquid
        # Visible count for real users mirrors the setting; the SSR fallback renders
        # more static links so crawlers see wider internal linking (JS replaces it on load).
        assign fallback_limit = section.settings.max_products | default: 4
        assign fallback_render = 12
        assign fallback_products = ''
        assign fallback_ids = ''
        assign fallback_collections = ''
        assign current_id_str = product.id | append: ''

        # Per-product offset seed → each PDP links to DIFFERENT neighbours in its
        # collections. Across the catalog this forms a link "ring" so deep-catalog
        # products are no longer orphaned (0 incoming internal links).
        assign link_seed = product.id | modulo: 23
        assign link_seed_alt = product.id | modulo: 13 | plus: 7

        assign primary_collection_handle = ''
        if product.metafields.custom.primary_collection_handle != blank
          assign primary_collection_handle = product.metafields.custom.primary_collection_handle.value | default: product.metafields.custom.primary_collection_handle | append: '' | strip
        endif
        if primary_collection_handle == blank
          capture auto_collection_handle
            render 'product-breadcrumb-auto-handle'
          endcapture
          assign auto_collection_handle = auto_collection_handle | strip
          if auto_collection_handle != blank
            assign primary_collection_handle = auto_collection_handle
          endif
        endif

        assign primary_collection = collections[primary_collection_handle]
        if primary_collection != blank and primary_collection.products_count > 0
          assign fallback_collections = fallback_collections | append: primary_collection.handle | append: '|'
          for p in primary_collection.products offset: link_seed limit: 8
            assign pid_str = p.id | append: ''
            unless pid_str == current_id_str or fallback_ids contains pid_str
              assign fallback_ids = fallback_ids | append: pid_str | append: '|'
              assign fallback_products = fallback_products | append: p.handle | append: '|'
            endunless
          endfor
          for p in primary_collection.products offset: link_seed_alt limit: 6
            assign pid_str = p.id | append: ''
            unless pid_str == current_id_str or fallback_ids contains pid_str
              assign fallback_ids = fallback_ids | append: pid_str | append: '|'
              assign fallback_products = fallback_products | append: p.handle | append: '|'
            endunless
          endfor
        endif

        if product.collections.size > 0
          for col in product.collections limit: 4
            unless col.handle == 'all' or col.handle == 'frontpage'
              assign fallback_collections = fallback_collections | append: col.handle | append: '|'
              for p in col.products offset: link_seed limit: 5
                assign pid_str = p.id | append: ''
                unless pid_str == current_id_str or fallback_ids contains pid_str
                  assign fallback_ids = fallback_ids | append: pid_str | append: '|'
                  assign fallback_products = fallback_products | append: p.handle | append: '|'
                endunless
              endfor
            endunless
          endfor
        endif

        if product.vendor != blank
          assign vendor_handle = product.vendor | handleize
          assign vendor_collection = collections[vendor_handle]
          if vendor_collection != blank and vendor_collection.products.size > 0
            assign fallback_collections = fallback_collections | append: vendor_collection.handle | append: '|'
            for p in vendor_collection.products offset: link_seed limit: 6
              assign pid_str = p.id | append: ''
              unless pid_str == current_id_str or fallback_ids contains pid_str
                assign fallback_ids = fallback_ids | append: pid_str | append: '|'
                assign fallback_products = fallback_products | append: p.handle | append: '|'
              endunless
            endfor
          endif
        endif

        assign fallback_handles = fallback_products | split: '|' | uniq
        assign fallback_collection_handles = fallback_collections | split: '|' | uniq
      -%}

      {%- if fallback_handles.size > 0 -%}
        <h2 class="product-recommendations__title product-recommendations__fallback-title">
          {{- 'recommendations.related_products' | t | default: 'Vous pourriez aussi aimer' -}}
        </h2>
        <ul
          class="product-recommendations__fallback"
          aria-label="Produits similaires"
          data-rl-recos-fallback
        >
          {%- for handle in fallback_handles limit: fallback_render -%}
            {%- assign rel_p = all_products[handle] -%}
            {%- if rel_p != blank and rel_p.handle != blank -%}
              {%- comment -%} Links past the visible count stay crawlable but hidden from users (JS replaces this block on load). {%- endcomment -%}
              <li class="product-recommendations__fallback-item{% if forloop.index0 >= fallback_limit %} product-recommendations__fallback-item--overflow{% endif %}">
                <a class="product-recommendations__fallback-link" href="{{ rel_p.url }}">
                  {%- if rel_p.featured_media != blank -%}
                    <img
                      class="product-recommendations__fallback-img"
                      src="{{ rel_p.featured_media.preview_image | image_url: width: 400 }}"
                      alt="{{ rel_p.title | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {%- endif -%}
                  <span class="product-recommendations__fallback-text">
                    {%- if rel_p.vendor != blank -%}
                      <span class="product-recommendations__fallback-vendor">{{ rel_p.vendor | escape }}</span>
                    {%- endif -%}
                    <span class="product-recommendations__fallback-title-text">{{ rel_p.title | escape }}</span>
                    {%- if rel_p.price != blank -%}
                      <span class="product-recommendations__fallback-price">{{ rel_p.price | money }}</span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%}
        Crawler-only collection link block: hidden from users (display:none), kept in DOM so Ahrefs / Googlebot
        see PDP → parent PLP and sibling collection links. Directly reduces "orphan collection" signals.
        JS hydration replaces the entire `<product-recommendations>` innerHTML, so this disappears for real users.
      {%- endcomment -%}
      {%- if fallback_collection_handles.size > 0 -%}
        <nav class="product-recommendations__crawler-collections" aria-hidden="true" data-rl-crawler-collections>
          {%- for chandle in fallback_collection_handles limit: 6 -%}
            {%- assign rel_col = collections[chandle] -%}
            {%- if rel_col != blank and rel_col.handle != blank and rel_col.products_count > 0 -%}
              <a class="product-recommendations__crawler-collection-link" href="{{ rel_col.url }}">{{ rel_col.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {% endif %}
  </div>
</product-recommendations>

{% stylesheet %}
  .product-recommendations {
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    display: block;
  }

  .product-recommendations__inner {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background-color: var(--color-background);
  }

  .product-recommendations__title {
    margin-bottom: var(--margin-lg);
  }

  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
    column-gap: var(--grid-gap-vertical);
    row-gap: var(--grid-gap-horizontal);
  }

  .product-recommendations__fallback-title {
    margin: 0 0 20px;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-recommendations__fallback {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 16px;
    row-gap: 24px;
  }

  .product-recommendations__fallback-item {
    min-width: 0;
  }

  /* Extra internal links for crawlers only — kept in the DOM (crawlable) but
     hidden from users so the visible grid stays one clean row before JS hydration. */
  .product-recommendations__fallback-item--overflow {
    display: none;
  }

  .product-recommendations__crawler-collections {
    display: none;
  }

  .product-recommendations__fallback-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .product-recommendations__fallback-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: rgb(255 255 255);
    border-radius: 8px;
  }

  .product-recommendations__fallback-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    line-height: 1.35;
  }

  .product-recommendations__fallback-vendor {
    color: rgb(0 0 0 / 55%);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-recommendations__fallback-price {
    font-weight: 500;
  }

  @media (width >= 750px) {
    .product-recommendations__fallback {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .rl-pdp-recommendations .product-recommendations__title {
    margin-bottom: 24px;
  }

  .rl-pdp-recommendations .product-recommendations__grid {
    column-gap: 20px;
    row-gap: 28px;
  }

  @media (width > 750px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    .rl-pdp-recommendations .product-recommendations__inner {
      --rl-lower-gutter: clamp(48px, 8vw, 128px);
      width: 100%;
      max-width: none !important;
      padding-inline: var(--rl-lower-gutter) !important;
      box-sizing: border-box;
    }

    .rl-pdp-recommendations .product-recommendations__grid {
      column-gap: 16px;
      row-gap: 24px;
    }

    .rl-pdp-recommendations .product-card-media-gallery__media .product-media img {
      object-fit: contain;
      background: rgb(255 255 255);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "_product-card"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:max_products",
      "min": 2,
      "max": 4,
      "default": 4,
      "step": 1
    },
    {
      "type": "header",
      "content": "t:grid"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "t:grid_columns_desktop",
      "min": 2,
      "max": 4,
      "default": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "t:grid_columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "header",
      "content": "t:paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:anchor_id",
      "info": "t:anchor_id_info"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:product_recommendations",
      "category": "t:products",
      "settings": {
        "max_products": 4,
        "grid_columns": 4,
        "grid_columns_mobile": "2",
        "margin_top": 50,
        "margin_bottom": 50
      },
      "blocks": [
        {
          "id": "product-card",
          "type": "_product-card",
          "static": true,
          "settings": {
            "wrap_in_card": false,
            "color_scheme": "",
            "layout_gap": 15
          },
          "blocks": [
            {
              "type": "_product-card-media-gallery",
              "name": "t:product_card_gallery",
              "settings": {
                "show_slider": false,
                "media_rounded": true,
                "media_ratio": "adapt"
              },
              "blocks": []
            },
            {
              "type": "_product-card-group",
              "name": "t:group",
              "settings": {
                "wrap_in_card": false,
                "color_scheme": "",
                "layout_direction_desktop": "column",
                "layout_gap_desktop": 5,
                "layout_wrap_desktop": "nowrap",
                "layout_justify_desktop": "flex-start",
                "layout_align_items_desktop": "flex-start",
                "same_as_desktop": true,
                "layout_direction_mobile": "column",
                "layout_gap_mobile": 10,
                "layout_wrap_mobile": "nowrap",
                "layout_justify_mobile": "flex-start",
                "layout_align_items_mobile": "flex-start",
                "margin_top": 0,
                "margin_bottom": 0
              },
              "blocks": [
                {
                  "type": "text",
                  "name": "t:text",
                  "settings": {
                    "text": "<h2>{{ closest.product.title }}</h2>",
                    "text_style": "paragraph",
                    "font_weight": 500,
                    "alignment": "left",
                    "margin_top": 0,
                    "margin_bottom": 0
                  }
                },
                {
                  "type": "product-price",
                  "name": "t:product_price",
                  "settings": {
                    "product": "{{ closest.product }}",
                    "sales_badge": "amount",
                    "show_sales_badge_text": false,
                    "text_style": "paragraph"
                  }
                },
                {
                  "type": "rating-stars",
                  "name": "t:rating_stars",
                  "settings": {
                    "product": "{{ closest.product }}",
                    "rating": 4.5,
                    "show_review_count": true,
                    "review_count": 123,
                    "link": "",
                    "margin_top": 0,
                    "margin_bottom": 0
                  }
                },
                {
                  "type": "_product-card-swatches",
                  "name": "t:swatches",
                  "settings": {
                    "swatches_size": "small",
                    "swatches_rounded": true
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
