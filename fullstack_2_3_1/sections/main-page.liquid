{% if section.settings.hide_header_and_footer %}
  <style>
    .shopify-section-group-header-group,
    .shopify-section-group-footer-group,
    .shopify-section-group-custom-prefooter {
      display: none !important;
    }
  </style>
{% endif %}

{% assign is_resell_faq_page = false %}
{% assign is_resell_content_page = false %}
{% assign is_resell_contact_page = false %}
{% assign is_resell_size_guide_page = false %}
{% assign is_resell_return_request_page = false %}
{% assign is_resell_return_policy_page = false %}
{% assign is_resell_wishlist_page = false %}
{% assign is_resell_legal_page = false %}
{% assign resell_legal_key = blank %}
{% assign page_title_downcase = page.title | downcase %}
{% assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase %}
{% assign locale_base = locale_iso | split: '-' | first %}

{% if page.handle == 'faq'
  or page.handle == 'faq-resell-lausanne'
  or request.path contains '/pages/faq'
  or page_title_downcase == 'faq'
%}
  {% assign is_resell_faq_page = true %}
{% elsif page.handle == 'notre-concept' or request.path contains '/pages/notre-concept' %}
  {% assign is_resell_content_page = true %}
  {% assign resell_content_page_type = 'notre-concept' %}
{% elsif page.handle == 'authenticite' or request.path contains '/pages/authenticite' %}
  {% assign is_resell_content_page = true %}
  {% assign resell_content_page_type = 'authenticite' %}
{% elsif page.handle == 'paiement-securise' or request.path contains '/pages/paiement-securise' %}
  {% assign is_resell_content_page = true %}
  {% assign resell_content_page_type = 'paiement-securise' %}
{% elsif page.handle == 'notre-processus-d-authentification' or request.path contains '/pages/notre-processus-d-authentification' %}
  {% assign is_resell_content_page = true %}
  {% assign resell_content_page_type = 'processus-authentification' %}
{% elsif page.handle == 'redaction' or page.handle == 'auteur' or page.handle == 'author' or request.path contains '/pages/redaction' %}
  {% assign is_resell_content_page = true %}
  {% assign resell_content_page_type = 'redaction' %}
{% elsif page.handle == 'contact' or request.path contains '/pages/contact' %}
  {% assign is_resell_contact_page = true %}
{% elsif page.handle == 'livraison'
  or page.handle == 'livraison-delais'
  or page.handle == 'faq-livraison'
  or request.path contains '/pages/livraison'
%}
  {% assign is_resell_faq_page = true %}
  {% assign faq_active_category = 'livraison' %}
{% elsif page.handle == 'guide-des-tailles'
  or request.path contains '/pages/guide-des-tailles'
%}
  {% assign is_resell_size_guide_page = true %}
{% elsif page.handle == 'demande-retour'
  or request.path contains '/pages/demande-retour'
%}
  {% assign is_resell_return_request_page = true %}
{% elsif page.handle == 'politique-de-retour'
  or page.handle == 'echanges-remboursements'
  or request.path contains '/pages/politique-de-retour'
  or request.path contains '/pages/echanges-remboursements'
%}
  {% assign is_resell_return_policy_page = true %}
{% elsif page.handle == 'conditions-generales-vente'
  or page.handle == 'conditions-generales-de-vente'
  or page.handle == 'cgv'
  or request.path contains '/pages/conditions-generales-vente'
  or request.path contains '/pages/conditions-generales-de-vente'
%}
  {% assign is_resell_legal_page = true %}
  {% assign resell_legal_key = 'cgv' %}
{% elsif page.handle == 'mentions-legales'
  or request.path contains '/pages/mentions-legales'
%}
  {% assign is_resell_legal_page = true %}
  {% assign resell_legal_key = 'mentions' %}
{% elsif page.handle == 'politique-de-confidentialite'
  or request.path contains '/pages/politique-de-confidentialite'
%}
  {% assign is_resell_legal_page = true %}
  {% assign resell_legal_key = 'privacy' %}
{% elsif page.handle == 'conditions-generales-utilisation'
  or page.handle == 'conditions-generales-d-utilisation'
  or request.path contains '/pages/conditions-generales-utilisation'
%}
  {% assign is_resell_legal_page = true %}
  {% assign resell_legal_key = 'cgu' %}
{% elsif page.handle == 'liste-de-souhaits'
  or page.handle == 'wishlist'
  or request.path contains '/pages/liste-de-souhaits'
  or request.path contains '/pages/wishlist'
%}
  {% assign is_resell_wishlist_page = true %}
{% endif %}

<div
  class="
    main-page
    {% if is_resell_wishlist_page %}main-page--wishlist{% endif %}
    {% if is_resell_legal_page or is_resell_faq_page %}main-page--faq-shell{% endif %}
    main-page--{{ section.settings.layout_type }}
    main-page--{{ section.settings.layout_flex_direction_desktop }}-desktop
    {% if section.settings.same_as_desktop == false %}
      main-page--{{ section.settings.layout_flex_direction_mobile }}-mobile
    {% else %}
      main-page--{{ section.settings.layout_flex_direction_desktop }}-mobile
    {% endif %}
    color-{{ section.settings.color_scheme }}
  "
  style="
    --direction: {{ section.settings.layout_flex_direction_desktop }};
    --wrap: {{ section.settings.layout_wrap_desktop }};
    --justify: {{ section.settings.layout_flex_justify_desktop }};
    --align_items: {{ section.settings.layout_flex_align_items_desktop }};
    --grid-columns: {{ section.settings.layout_grid_columns_desktop }};
    --gap: {{ section.settings.layout_gap_desktop }}px;
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.same_as_desktop == false -%}
    --direction-mobile: {{ section.settings.layout_flex_direction_mobile }};
    --wrap-mobile: {{ section.settings.layout_wrap_mobile }};
    --justify-mobile: {{ section.settings.layout_flex_justify_mobile }};
    --align_items-mobile: {{ section.settings.layout_flex_align_items_mobile }};
    --grid-columns-mobile: {{ section.settings.layout_grid_columns_mobile }};
    --gap-mobile: {{ section.settings.layout_gap_mobile }}px;
    {%- else -%}
    --direction-mobile: {{ section.settings.layout_flex_direction_desktop }};
    --wrap-mobile: {{ section.settings.layout_wrap_desktop }};
    --justify-mobile: {{ section.settings.layout_flex_justify_desktop }};
    --align_items-mobile: {{ section.settings.layout_flex_align_items_desktop }};
    --grid-columns-mobile: {{ section.settings.layout_grid_columns_desktop }};
    --gap-mobile: {{ section.settings.layout_gap_desktop }}px;
    {%- endif -%}
  "
>
  <div
    class="
      page-width
      {% if section.settings.wrap_in_card == false %}main-page__inner{% endif %}
      {% if section.settings.section_width == 'narrow' %} page-width--narrow{% endif %}
    "
    style="
      --padding-top: {{ section.settings.padding_top }}px;
      --padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% if is_resell_faq_page %}
      {% if page.handle == 'livraison' or page.handle == 'livraison-delais' or page.handle == 'faq-livraison' %}
        {% render 'livraison-page-extra' %}
      {% endif %}
      {% render 'resell-faq-content', active_category: faq_active_category %}
    {% elsif is_resell_size_guide_page %}
      {% render 'resell-size-guide-content' %}
    {% elsif is_resell_content_page %}
      {% if resell_content_page_type == 'processus-authentification' %}
        {% render 'resell-page-processus-authentification' %}
      {% elsif resell_content_page_type == 'authenticite' %}
        {% render 'resell-page-authenticite' %}
      {% elsif resell_content_page_type == 'paiement-securise' %}
        {% render 'resell-page-paiement-securise' %}
      {% elsif resell_content_page_type == 'redaction' %}
        {% render 'resell-page-redaction' %}
      {% else %}
        {% render 'resell-page-notre-concept' %}
      {% endif %}
    {% elsif is_resell_contact_page %}
      {% render 'resell-page-contact' %}
    {% elsif is_resell_return_request_page %}
      {% render 'resell-return-request-content' %}
    {% elsif is_resell_return_policy_page %}
      {% render 'resell-page-return-policy' %}
    {% elsif is_resell_legal_page %}
      {% render 'resell-legal-hub', legal_key: resell_legal_key %}
    {% elsif is_resell_wishlist_page %}
      {% render 'resell-wishlist-page-shell',
        cta_button: 'add-to-cart',
        product_options: 'dropdowns',
        show_buy_all_button: true,
        move_to_cart: true
      %}
    {% else %}
      {% capture blocks_content %}
        {% content_for 'blocks' %}
      {% endcapture %}

      {% if section.settings.wrap_in_card %}
        <div class="main-page__inner card color-{{ section.settings.color_scheme_card }}">
          {{ blocks_content }}
        </div>
      {% else %}
        {{ blocks_content }}
      {% endif %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .section-main-page {
    width: 100%;
    max-width: 100%;
    padding: 0;
  }

  .section-main-page .text-block[data-visual-preview-mode] {
    max-width: 100%;
  }

  .section-main-page .image-card[data-visual-preview-mode] {
    width: 100%;
  }

  .main-page {
    width: 100%;
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    display: flex;
    justify-content: center;
  }

  .main-page--wishlist {
    margin-top: 0;
    margin-bottom: 0;
    display: block;
  }

  .main-page--wishlist .main-page__inner {
    width: 100%;
    max-width: none;
    padding-top: 0;
    padding-bottom: 0;
    padding-inline: 0;
  }

  .main-page--faq-shell .main-page__inner {
    padding-top: 0;
    padding-bottom: 0;
  }

  .section-main-wishlist {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .main-page .main-page__inner {
    gap: var(--gap-mobile);
    width: 100%;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .main-page--flex .main-page__inner {
    display: flex;
    flex-direction: var(--direction-mobile);
    flex-wrap: var(--wrap-mobile);
    justify-content: var(--justify-mobile);
    align-items: var(--align_items-mobile);
    height: 100%;
  }

  .main-page:not(.main-page--row-mobile) > div > .main-page__inner > .text-block-center-mobile,
  .main-page:not(.main-page--row-mobile) > .main-page__inner > .text-block-center-mobile {
    width: 100%;
  }

  .main-page--grid .main-page__inner {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile), 1fr);
    grid-template-rows: auto;
  }

  @media (width > 750px) {
    .main-page .main-page__inner {
      gap: var(--gap);
    }

    .main-page--flex .main-page__inner {
      flex-direction: var(--direction);
      flex-wrap: var(--wrap);
      justify-content: var(--justify);
      align-items: var(--align_items);
      height: auto;
    }

    .main-page:not(.main-page--row-desktop) > div > .main-page__inner > .text-block-center-desktop,
    .main-page:not(.main-page--row-desktop) > .main-page__inner > .text-block-center-desktop {
      width: 100%;
    }

    .main-page--grid .main-page__inner {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:page",
  "class": "section-main-page",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "wrap_in_card",
      "label": "t:wrap_in_card",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "t:color_scheme_card",
      "default": "scheme-2",
      "visible_if": "{{ section.settings.wrap_in_card }}"
    },
    {
      "type": "checkbox",
      "id": "hide_header_and_footer",
      "label": "t:hide_header_and_footer",
      "default": false
    },
    {
      "type": "header",
      "content": "t:layout_desktop"
    },
    {
      "type": "paragraph",
      "content": "t:how_to_use_custom_section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:section_width",
      "default": "normal",
      "options": [
        { "value": "narrow", "label": "t:narrow" },
        { "value": "normal", "label": "t:normal" }
      ]
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:layout_type",
      "default": "flex",
      "options": [
        { "value": "flex", "label": "t:group_layout_flexible_default" },
        { "value": "grid", "label": "t:group_layout_grid_default" }
      ]
    },
    {
      "type": "select",
      "id": "layout_flex_direction_desktop",
      "label": "t:layout_direction",
      "default": "column",
      "options": [
        { "value": "row", "label": "→" },
        { "value": "column", "label": "↓" },
        { "value": "column-reverse", "label": "↑" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' }}"
    },
    {
      "type": "range",
      "id": "layout_grid_columns_desktop",
      "label": "t:layout_grid_columns",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "|||",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "layout_gap_desktop",
      "label": "t:layout_gap",
      "default": 20,
      "step": 1,
      "min": 0,
      "max": 50,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "layout_wrap_desktop",
      "label": "t:layout_wrap",
      "default": "nowrap",
      "options": [
        { "value": "nowrap", "label": "t:nowrap" },
        { "value": "wrap", "label": "t:wrap" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' }}"
    },
    {
      "type": "select",
      "id": "layout_flex_justify_desktop",
      "label": "t:layout_justify",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" },
        { "value": "space-between", "label": "t:space-between" },
        { "value": "space-around", "label": "t:space-around" },
        { "value": "space-evenly", "label": "t:space-evenly" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' }}"
    },
    {
      "type": "select",
      "id": "layout_flex_align_items_desktop",
      "label": "t:layout_align_items",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' }}"
    },
    {
      "type": "header",
      "content": "t:layout_mobile"
    },
    {
      "type": "checkbox",
      "id": "same_as_desktop",
      "label": "t:same_as_desktop",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_flex_direction_mobile",
      "label": "t:layout_direction",
      "default": "column",
      "options": [
        { "value": "row", "label": "→" },
        { "value": "column", "label": "↓" },
        { "value": "column-reverse", "label": "↑" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' and section.settings.same_as_desktop == false }}"
    },
    {
      "type": "range",
      "id": "layout_gap_mobile",
      "label": "t:layout_gap",
      "default": 20,
      "step": 1,
      "min": 0,
      "max": 30,
      "unit": "px",
      "visible_if": "{{ section.settings.same_as_desktop == false }}"
    },
    {
      "type": "select",
      "id": "layout_wrap_mobile",
      "label": "t:layout_wrap",
      "default": "nowrap",
      "options": [
        { "value": "nowrap", "label": "t:nowrap" },
        { "value": "wrap", "label": "t:wrap" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' and section.settings.same_as_desktop == false }}"
    },
    {
      "type": "select",
      "id": "layout_flex_justify_mobile",
      "label": "t:layout_justify",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" },
        { "value": "space-between", "label": "t:space-between" },
        { "value": "space-around", "label": "t:space-around" },
        { "value": "space-evenly", "label": "t:space-evenly" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' and section.settings.same_as_desktop == false }}"
    },
    {
      "type": "select",
      "id": "layout_flex_align_items_mobile",
      "label": "t:layout_align_items",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" }
      ],
      "visible_if": "{{ section.settings.layout_type == 'flex' and section.settings.same_as_desktop == false }}"
    },
    {
      "type": "range",
      "id": "layout_grid_columns_mobile",
      "label": "t:layout_grid_columns",
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "|||",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.same_as_desktop == false }}"
    },
    {
      "type": "header",
      "content": "t:paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ]
}
{% endschema %}
