{%- doc -%}
  Home meta card grid (draft) — wethenew-style asymmetric tiles.
  Tall left card + two stacked right cards. Dark full-bleed section.
{%- enddoc -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Summer Selection'
  assign cta_default = section.settings.cta_label | default: 'Découvrir'
  assign card_blocks = section.blocks | where: 'type', 'card'
-%}

{%- if card_blocks.size > 0 -%}
  {{ 'home-meta-card-grid.css' | asset_url | stylesheet_tag }}
  <section
    class="rl-meta-grid color-{{ section.settings.color_scheme }}"
    style="
      --rl-meta-pad-top: {{ section.settings.padding_top }}px;
      --rl-meta-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="rl-meta-grid__inner page-width">
      {%- if heading != blank -%}
        <h2 class="rl-meta-grid__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      <div class="rl-meta-grid__grid" role="list">
        {%- for block in card_blocks -%}
          {%- liquid
            assign card_title = block.settings.title | strip
            assign card_cta = block.settings.cta | strip
            if card_cta == blank
              assign card_cta = cta_default
            endif
            assign card_link = block.settings.link | strip
            assign card_image = block.settings.image
            assign card_asset = block.settings.image_asset | strip
            assign card_product = block.settings.product
            assign card_collection = block.settings.collection

            if card_link == blank and card_product != blank
              assign card_link = card_product.url
            endif
            if card_link == blank and card_collection != blank
              assign card_link = card_collection.url
            endif

            if card_title == blank and card_product != blank
              assign card_title = card_product.title
            endif
            if card_title == blank and card_collection != blank
              assign card_title = card_collection.title
            endif

            if card_asset == blank and card_title != blank
              assign title_key = card_title | downcase
              if title_key contains 'bape'
                assign card_asset = 'rl-meta-bape-tees.jpg'
              elsif title_key contains 'supreme' or title_key contains 'boxer'
                assign card_asset = 'rl-meta-supreme-boxers.jpg'
              endif
            endif

            if card_asset == blank
              if card_image == blank and card_product != blank and card_product.featured_media != blank
                assign card_image = card_product.featured_media
              endif
              if card_image == blank and card_collection != blank
                if card_collection.image != blank
                  assign card_image = card_collection.image
                elsif card_collection.products.first.featured_media != blank
                  assign card_image = card_collection.products.first.featured_media
                endif
              endif
            else
              assign card_image = blank
            endif

            assign is_featured = false
            if block.settings.layout == 'featured' or forloop.first
              assign is_featured = true
            endif
            if block.settings.layout == 'stack'
              assign is_featured = false
            endif
          -%}

          {%- if card_title != blank and card_link != blank -%}
            <a
              class="rl-meta-grid__card{% if is_featured %} rl-meta-grid__card--featured{% endif %}"
              href="{{ card_link }}"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <span class="rl-meta-grid__media" aria-hidden="true">
                {%- if card_asset != blank -%}
                  <img
                    src="{{ card_asset | asset_url }}"
                    alt=""
                    width="1400"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                  >
                {%- elsif card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '400,600,800,1100,1400',
                      sizes: '(min-width: 990px) 42vw, 92vw',
                      alt: ''
                  }}
                {%- else -%}
                  <span class="rl-meta-grid__placeholder"></span>
                {%- endif -%}
              </span>
              <span class="rl-meta-grid__overlay">
                <span class="rl-meta-grid__title">{{ card_title | escape }}</span>
                <span class="rl-meta-grid__cta">{{ card_cta | escape }}</span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Home — Meta card grid",
  "tag": "section",
  "class": "section-home-meta-card-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Summer Selection"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Default CTA",
      "default": "Découvrir"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (1st = tall)" },
            { "value": "featured", "label": "Tall (left)" },
            { "value": "stack", "label": "Stack (right)" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional — else product/collection)"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename (optional override)",
          "info": "e.g. rl-meta-bape-tees.jpg — overrides picker/product image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (image + link fallback)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (image + link fallback)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Home — Meta card grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "layout": "featured",
            "title": "Alo",
            "cta": "Découvrir",
            "link": "/collections/alo-yoga"
          }
        },
        {
          "type": "card",
          "settings": {
            "layout": "stack",
            "title": "Supreme Boxers",
            "cta": "Découvrir",
            "link": "/products/supreme-hanes-boxer-briefs-black"
          }
        },
        {
          "type": "card",
          "settings": {
            "layout": "stack",
            "title": "Bape Tee",
            "cta": "Découvrir",
            "link": "/collections/bape"
          }
        }
      ]
    }
  ]
}
{% endschema %}
