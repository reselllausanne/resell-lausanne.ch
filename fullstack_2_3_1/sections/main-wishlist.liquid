{% render 'resell-wishlist-page-shell',
  heading: section.settings.heading,
  show_eyebrow: section.settings.show_eyebrow,
  eyebrow: section.settings.eyebrow,
  subheading: section.settings.subheading,
  cta_button: section.settings.cta_button,
  product_options: section.settings.product_options,
  show_vendor: section.settings.show_vendor,
  show_share_button: section.settings.show_share_button,
  show_buy_all_button: section.settings.show_buy_all_button,
  move_to_cart: section.settings.move_to_cart,
  empty_link: section.settings.wishlist_empty_link,
  color_scheme: section.settings.color_scheme,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{% schema %}
{
  "name": "Wishlist page",
  "tag": "section",
  "class": "section-main-wishlist",
  "settings": [
    {
      "type": "header",
      "content": "Page header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title or locale string (wishlist.title)."
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave blank for wishlist.page_eyebrow locale string."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Leave blank for wishlist.page_subheading locale string."
    },
    {
      "type": "header",
      "content": "Swish / Wishlist King"
    },
    {
      "type": "select",
      "id": "cta_button",
      "label": "Product CTA",
      "default": "add-to-cart",
      "options": [
        { "value": "add-to-cart", "label": "Add to cart" },
        { "value": "view-product", "label": "View product" }
      ]
    },
    {
      "type": "select",
      "id": "product_options",
      "label": "Variant selector",
      "default": "dropdowns",
      "options": [
        { "value": "dropdowns", "label": "Dropdowns" },
        { "value": "buttons", "label": "Buttons" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_share_button",
      "label": "Show share button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buy_all_button",
      "label": "Show buy all button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "move_to_cart",
      "label": "Move to cart (remove from wishlist on add)",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_empty_link",
      "label": "Empty wishlist link",
      "info": "Defaults to /collections/all"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Wishlist page"
    }
  ]
}
{% endschema %}
