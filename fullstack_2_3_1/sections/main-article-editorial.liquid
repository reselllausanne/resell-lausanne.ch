{% comment %}
  Editorial article — rich guides + simple legacy articles.

  Rich mode: section blocks (picks, sections, callouts, table).
  Simple mode: article.content in editorial typography shell.
{% endcomment %}
{% liquid
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first
  assign mf = article.metafields.custom
  assign editorial_eyebrow = section.settings.eyebrow | default: mf.editorial_eyebrow.value | default: mf.editorial_eyebrow
  assign editorial_deck = section.settings.deck | default: mf.editorial_deck.value | default: mf.editorial_deck
  assign editorial_intro = section.settings.intro | default: mf.editorial_intro.value | default: mf.editorial_intro
  assign editorial_chips_raw = section.settings.chips
  assign editorial_chips_list = blank
  assign editorial_callout_title = blank
  assign editorial_callout_text = blank
  assign editorial_section_heading = blank
  assign editorial_section_body = blank
  assign editorial_how_to_heading = section.settings.how_to_heading
  assign editorial_how_to_body = section.settings.how_to_body
  assign editorial_table_col_1 = section.settings.table_col_1
  assign editorial_table_col_2 = section.settings.table_col_2
  assign editorial_table_col_3 = section.settings.table_col_3
  assign editorial_verdict_html = section.settings.verdict
  assign editorial_checklist_raw = section.settings.checklist
  assign editorial_checklist_items = blank
  assign editorial_checklist_parent = section.settings.checklist_parent
  assign editorial_display_title = article.title
  assign editorial_i18n_bundle = mf.editorial_i18n.value
  assign editorial_i18n = blank

  if editorial_i18n_bundle != blank
    case locale_base
      when 'de'
        assign editorial_i18n = editorial_i18n_bundle.de
      when 'en'
        assign editorial_i18n = editorial_i18n_bundle.en
      else
        assign editorial_i18n = editorial_i18n_bundle.fr
    endcase
    if editorial_i18n == blank
      assign editorial_i18n = editorial_i18n_bundle.fr
    endif
  endif

  if editorial_i18n != blank and locale_base != 'fr'
    if editorial_i18n.display_title != blank
      assign editorial_display_title = editorial_i18n.display_title
    endif
    if editorial_i18n.eyebrow != blank
      assign editorial_eyebrow = editorial_i18n.eyebrow
    endif
    if editorial_i18n.deck != blank
      assign editorial_deck = editorial_i18n.deck
    endif
    if editorial_i18n.intro != blank
      assign editorial_intro = editorial_i18n.intro
    endif
    if editorial_i18n.chips != blank
      assign editorial_chips_list = editorial_i18n.chips
    endif
    assign editorial_callout_title = editorial_i18n.callout_title
    assign editorial_callout_text = editorial_i18n.callout_text
    assign editorial_section_heading = editorial_i18n.section_heading
    assign editorial_section_body = editorial_i18n.section_body
    if editorial_i18n.how_to_heading != blank
      assign editorial_how_to_heading = editorial_i18n.how_to_heading
    endif
    if editorial_i18n.how_to_body != blank
      assign editorial_how_to_body = editorial_i18n.how_to_body
    endif
    if editorial_i18n.table_cols != blank and editorial_i18n.table_cols.size > 0
      assign editorial_table_col_1 = editorial_i18n.table_cols[0]
      assign editorial_table_col_2 = editorial_i18n.table_cols[1]
      assign editorial_table_col_3 = editorial_i18n.table_cols[2]
    endif
    if editorial_i18n.verdict != blank
      assign editorial_verdict_html = editorial_i18n.verdict
    endif
    if editorial_i18n.checklist != blank
      assign editorial_checklist_items = editorial_i18n.checklist
    endif
    if editorial_i18n.checklist_parent == true
      assign editorial_checklist_parent = true
    endif
  endif

  assign hero_image = section.settings.hero_image | default: mf.editorial_hero_image.value | default: article.image
  assign hero_mobile = section.settings.hero_mobile_image | default: mf.editorial_hero_mobile_image.value
  assign hero_overlay = section.settings.hero_overlay | default: mf.editorial_hero_overlay.value | default: 66
  assign hero_alt = section.settings.hero_alt | default: mf.editorial_hero_alt.value | default: article.title
  assign hero_position = section.settings.hero_object_position | default: 'center center'
  assign hero_mobile_source = hero_mobile | default: hero_image
  assign checklist_title = section.settings.checklist_title
  assign show_promo = section.settings.show_promo
  assign rich_mode = false

  if section.blocks.size > 0
    assign rich_mode = true
  endif

  for block in section.blocks
    if block.type == 'product_pick' or block.type == 'content_section' or block.type == 'callout' or block.type == 'table_row'
      assign rich_mode = true
      break
    endif
  endfor

  assign blog_home = blog.url | default: routes.root_url
%}

{{ 'editorial-guide.css' | asset_url | stylesheet_tag }}

<article
  class="editorial-guide color-{{ section.settings.color_scheme }}"
  style="--editorial-hero-overlay: {{ hero_overlay }}; --editorial-hero-position: {{ hero_position }}; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% if hero_image != blank %}
    <div class="editorial-guide__hero editorial-guide__shell">
      {{
        hero_mobile_source
        | image_url: width: 1200, height: 1500, crop: 'center'
        | image_tag:
          class: 'editorial-guide__hero-image editorial-guide__hero-image--mobile',
          loading: 'eager',
          fetchpriority: 'high',
          width: 1200,
          height: 1500,
          sizes: '100vw',
          alt: hero_alt
      }}
      {{
        hero_image
        | image_url: width: 1920, height: 820, crop: 'center'
        | image_tag:
          class: 'editorial-guide__hero-image editorial-guide__hero-image--desktop',
          loading: 'eager',
          fetchpriority: 'high',
          width: 1920,
          height: 820,
          sizes: '100vw',
          alt: hero_alt
      }}

      {% if editorial_eyebrow != blank or editorial_deck != blank or editorial_intro != blank %}
        <div class="editorial-guide__hero-copy">
          {% if editorial_eyebrow != blank %}
            <p class="editorial-guide__eyebrow">{{ editorial_eyebrow | escape }}</p>
          {% endif %}
          {% if editorial_deck != blank %}
            <p class="editorial-guide__hero-deck">{{ editorial_deck | escape }}</p>
          {% endif %}
          {% if editorial_intro != blank and rich_mode %}
            <p class="editorial-guide__hero-text">{{ editorial_intro | strip_html | escape }}</p>
          {% endif %}
          {% if editorial_chips_list != blank %}
            {% assign chip_list = editorial_chips_list %}
          {% elsif editorial_chips_raw != blank %}
            {% assign chip_list = editorial_chips_raw | newline_to_br | split: '<br />' %}
          {% else %}
            {% assign chip_list = blank %}
          {% endif %}
          {% if chip_list != blank %}
            <ul class="editorial-guide__chips">
              {% for chip in chip_list %}
                {% assign chip_clean = chip | strip %}
                {% if chip_clean != blank %}
                  <li class="editorial-guide__chip">{{ chip_clean | escape }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="editorial-guide__shell">
    {% render 'editorial-article-nav', blog: blog, hub_handle: section.settings.hub_article_handle %}
    <nav class="editorial-guide__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'breadcrumbs.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ blog_home }}">{{ blog.title }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ editorial_display_title | escape }}</span>
    </nav>

    <div class="editorial-guide__grid">
      <div class="editorial-guide__content">
        <h1 class="editorial-guide__title">{{ editorial_display_title | escape }}</h1>

        {% if article.author != blank or article.published_at != blank %}
          <p class="editorial-guide__meta">
            {% if article.author != blank %}
              <span>{{ article.author }}</span>
              <span aria-hidden="true"> · </span>
            {% endif %}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | time_tag: format: 'date' }}
            </time>
          </p>
        {% endif %}

        {% if rich_mode %}
          {% if editorial_intro != blank %}
            <p class="editorial-guide__lede">{{ editorial_intro | strip_html | escape }}</p>
          {% endif %}

          {% if editorial_callout_title != blank or editorial_callout_text != blank %}
            <aside class="editorial-guide__callout">
              {% if editorial_callout_title != blank %}
                <strong class="editorial-guide__callout-title">{{ editorial_callout_title | escape }}</strong>
              {% endif %}
              {% if editorial_callout_text != blank %}
                <p class="editorial-guide__callout-text">{{ editorial_callout_text | escape }}</p>
              {% endif %}
            </aside>
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'callout' %}
                <aside class="editorial-guide__callout" {{ block.shopify_attributes }}>
                  {% if block.settings.title != blank %}
                    <strong class="editorial-guide__callout-title">{{ block.settings.title | escape }}</strong>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="editorial-guide__callout-text">{{ block.settings.text | escape }}</p>
                  {% endif %}
                </aside>
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if editorial_section_heading != blank %}
            <h2 class="editorial-guide__section-title">{{ editorial_section_heading | escape }}</h2>
            {% if editorial_section_body != blank %}
              <div class="editorial-guide__section-body rte">{{ editorial_section_body }}</div>
            {% endif %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'content_section' %}
                {% if block.settings.heading != blank %}
                  <h2 class="editorial-guide__section-title" {{ block.shopify_attributes }}>
                    {{ block.settings.heading | escape }}
                  </h2>
                {% endif %}
                {% if block.settings.body != blank %}
                  <div class="editorial-guide__section-body rte">{{ block.settings.body }}</div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}

          {% assign has_picks = false %}
          {% for block in section.blocks %}
            {% if block.type == 'product_pick' %}
              {% assign has_picks = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if has_picks %}
            <h2 class="editorial-guide__section-title">
              {%- if section.settings.selection_heading != blank -%}
                {{ section.settings.selection_heading | escape }}
              {%- else -%}
                {{ 'editorial.selection_heading' | t }}
              {%- endif -%}
            </h2>
            <div class="editorial-guide__picks">
              {% assign pick_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'product_pick' %}
                  {% assign pick_index = pick_index | plus: 1 %}
                  {% assign i18n_pick = blank %}
                  {% if editorial_i18n.products != blank %}
                    {% assign pick_array_index = pick_index | minus: 1 %}
                    {% assign i18n_pick = editorial_i18n.products[pick_array_index] %}
                  {% endif %}
                  {% render 'editorial-product-pick', block: block, eager_image: pick_index == 1, i18n_pick: i18n_pick %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% assign has_table = false %}
          {% for block in section.blocks %}
            {% if block.type == 'table_row' %}
              {% assign has_table = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if has_table %}
            <div class="editorial-guide__table-wrap">
              <table class="editorial-guide__table">
                <thead>
                  <tr>
                    {% if editorial_table_col_1 != blank %}
                      <th scope="col">{{ editorial_table_col_1 | escape }}</th>
                    {% endif %}
                    {% if editorial_table_col_2 != blank %}
                      <th scope="col">{{ editorial_table_col_2 | escape }}</th>
                    {% endif %}
                    {% if editorial_table_col_3 != blank %}
                      <th scope="col">{{ editorial_table_col_3 | escape }}</th>
                    {% endif %}
                  </tr>
                </thead>
                <tbody>
                  {% if editorial_i18n.table_rows != blank and editorial_i18n.table_rows.size > 0 %}
                    {% for row in editorial_i18n.table_rows %}
                      <tr>
                        {% if editorial_table_col_1 != blank %}
                          <td data-label="{{ editorial_table_col_1 | escape }}">{{ row.col_1 | escape }}</td>
                        {% endif %}
                        {% if editorial_table_col_2 != blank %}
                          <td data-label="{{ editorial_table_col_2 | escape }}">{{ row.col_2 | escape }}</td>
                        {% endif %}
                        {% if editorial_table_col_3 != blank %}
                          <td data-label="{{ editorial_table_col_3 | escape }}">{{ row.col_3 | escape }}</td>
                        {% endif %}
                      </tr>
                    {% endfor %}
                  {% else %}
                  {% for block in section.blocks %}
                    {% if block.type == 'table_row' %}
                      <tr {{ block.shopify_attributes }}>
                        {% if editorial_table_col_1 != blank %}
                          <td data-label="{{ editorial_table_col_1 | escape }}">{{ block.settings.col_1 | escape }}</td>
                        {% endif %}
                        {% if editorial_table_col_2 != blank %}
                          <td data-label="{{ editorial_table_col_2 | escape }}">{{ block.settings.col_2 | escape }}</td>
                        {% endif %}
                        {% if editorial_table_col_3 != blank %}
                          <td data-label="{{ editorial_table_col_3 | escape }}">{{ block.settings.col_3 | escape }}</td>
                        {% endif %}
                      </tr>
                    {% endif %}
                  {% endfor %}
                  {% endif %}
                </tbody>
              </table>
            </div>
          {% endif %}

          {% if editorial_how_to_heading != blank or editorial_how_to_body != blank %}
            <h2 class="editorial-guide__section-title">
              {%- if editorial_how_to_heading != blank -%}
                {{ editorial_how_to_heading | escape }}
              {%- else -%}
                {{ 'editorial.how_to_choose' | t }}
              {%- endif -%}
            </h2>
            {% if editorial_how_to_body != blank %}
              <div class="editorial-guide__section-body rte">{{ editorial_how_to_body }}</div>
            {% endif %}
          {% endif %}
        {% else %}
          <div class="editorial-guide__body rte">
            {% render 'resell-blog-article-body', article: article %}
          </div>
        {% endif %}

        {% if show_promo %}
          {% render 'editorial-promo-card', section: section %}
        {% endif %}

        {% render 'editorial-related-guides', section: section, article: article, blog: blog %}
      </div>

      {% if rich_mode %}
        <aside class="editorial-guide__sidebar">
          {% if editorial_checklist_items != blank %}
            {% assign checklist_items = editorial_checklist_items %}
          {% elsif editorial_checklist_raw != blank %}
            {% assign checklist_items = editorial_checklist_raw | newline_to_br | split: '<br />' %}
          {% else %}
            {% assign checklist_items = blank %}
          {% endif %}
          {% if checklist_items != blank %}
            <div class="editorial-guide__sidebox">
              <h2 class="editorial-guide__sidebox-title">
                {%- if checklist_title != blank -%}
                  {{ checklist_title | escape }}
                {%- elsif editorial_checklist_parent -%}
                  {{ 'editorial.checklist_parent_title' | t }}
                {%- else -%}
                  {{ 'editorial.checklist_title' | t }}
                {%- endif -%}
              </h2>
              <ol>
                {% for item in checklist_items %}
                  {% assign item_clean = item | strip %}
                  {% if item_clean != blank %}
                    <li>{{ item_clean | escape }}</li>
                  {% endif %}
                {% endfor %}
              </ol>
            </div>
          {% endif %}

          {% if editorial_verdict_html != blank %}
            <div class="editorial-guide__sidebox editorial-guide__sidebox--verdict">
              <h2 class="editorial-guide__sidebox-title">{{ 'editorial.verdict_title' | t }}</h2>
              <div class="editorial-guide__sidebox-body rte">{{ editorial_verdict_html }}</div>
            </div>
          {% endif %}
        </aside>
      {% endif %}
    </div>
  </div>
</article>

<style>
  .editorial-guide__hero-image--mobile {
    display: none;
  }

  @media (width <= 900px) {
    .editorial-guide__hero-image--mobile {
      display: block;
    }

    .editorial-guide__hero-image--desktop {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial article",
  "tag": "section",
  "class": "section-editorial-article",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "deck",
      "label": "Accroche hero (sous le surtitre)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction (lede)"
    },
    {
      "type": "textarea",
      "id": "chips",
      "label": "Chips hero (1 par ligne)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image hero desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "Image hero mobile"
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Alt hero"
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Overlay hero (%)",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 66
    },
    {
      "type": "select",
      "id": "hero_object_position",
      "label": "Recadrage hero",
      "options": [
        { "value": "center center", "label": "Centre" },
        { "value": "center top", "label": "Haut" },
        { "value": "center bottom", "label": "Bas" },
        { "value": "left center", "label": "Gauche" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Contenu riche"
    },
    {
      "type": "text",
      "id": "selection_heading",
      "label": "Titre sélection produits"
    },
    {
      "type": "text",
      "id": "how_to_heading",
      "label": "Titre bloc conseils"
    },
    {
      "type": "richtext",
      "id": "how_to_body",
      "label": "Texte bloc conseils"
    },
    {
      "type": "text",
      "id": "table_col_1",
      "label": "Tableau — colonne 1"
    },
    {
      "type": "text",
      "id": "table_col_2",
      "label": "Tableau — colonne 2"
    },
    {
      "type": "text",
      "id": "table_col_3",
      "label": "Tableau — colonne 3"
    },
    {
      "type": "header",
      "content": "Sidebar"
    },
    {
      "type": "checkbox",
      "id": "checklist_parent",
      "label": "Checklist parents (libellé)",
      "default": false
    },
    {
      "type": "text",
      "id": "checklist_title",
      "label": "Titre checklist (override)"
    },
    {
      "type": "textarea",
      "id": "checklist",
      "label": "Checklist (1 item par ligne)"
    },
    {
      "type": "richtext",
      "id": "verdict",
      "label": "Verdict"
    },
    {
      "type": "header",
      "content": "Guides liés"
    },
    {
      "type": "text",
      "id": "hub_article_handle",
      "label": "Handle article hub",
      "default": "chaussures-sneakers-rentree-2026"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Titre guides liés"
    },
    {
      "type": "header",
      "content": "Carte cadeau / promo"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Afficher le bloc promo",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "Promo surtitre"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promo titre"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Promo description"
    },
    {
      "type": "text",
      "id": "promo_primary_label",
      "label": "Promo CTA principal"
    },
    {
      "type": "url",
      "id": "promo_primary_url",
      "label": "Promo lien principal"
    },
    {
      "type": "product",
      "id": "promo_product",
      "label": "Produit carte cadeau (fallback URL)"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Image carte cadeau (vide = asset theme)"
    },
    {
      "type": "text",
      "id": "promo_image_alt",
      "label": "Alt image carte cadeau"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product_pick",
      "name": "Recommandation produit",
      "settings": [
        { "type": "text", "id": "rank_label", "label": "Label rang" },
        { "type": "text", "id": "title", "label": "Titre modèle (override)" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "product", "id": "product", "label": "Produit principal" },
        { "type": "product_list", "id": "products", "label": "Produits / coloris", "limit": 8 },
        { "type": "collection", "id": "collection", "label": "Collection (lien fallback)" },
        { "type": "text", "id": "link_label", "label": "Libellé lien" },
        { "type": "text", "id": "score_label", "label": "Label score" },
        { "type": "range", "id": "score", "label": "Score (%)", "min": 0, "max": 100, "step": 1, "default": 90 },
        { "type": "checkbox", "id": "hide_when_unavailable", "label": "Masquer si indisponible", "default": false }
      ]
    },
    {
      "type": "content_section",
      "name": "Section texte",
      "settings": [
        { "type": "text", "id": "heading", "label": "H2" },
        { "type": "richtext", "id": "body", "label": "Contenu" }
      ]
    },
    {
      "type": "callout",
      "name": "Encadré conseil",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    },
    {
      "type": "table_row",
      "name": "Ligne tableau",
      "settings": [
        { "type": "text", "id": "col_1", "label": "Colonne 1" },
        { "type": "text", "id": "col_2", "label": "Colonne 2" },
        { "type": "text", "id": "col_3", "label": "Colonne 3" }
      ]
    },
    {
      "type": "related_guide",
      "name": "Guide lié",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "article_handle", "label": "Handle article" },
        { "type": "text", "id": "segment_label", "label": "Label segment" },
        { "type": "text", "id": "title", "label": "Titre (override)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial article"
    }
  ]
}
{% endschema %}
