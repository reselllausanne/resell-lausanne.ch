          "info": "Shopify Files name for this slide only."
        },
        {
          "type": "text",
          "id": "mobile_filename",
          "label": "Phone filename override (optional)",
          "info": "Shopify Files name for this slide only."
        },
        {
          "type": "header",
          "content": "CTA card (shared laptop + phone)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nouvelle collection"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Découvrir"
        },
        {
