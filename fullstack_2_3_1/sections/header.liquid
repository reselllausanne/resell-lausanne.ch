{% liquid
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first

  assign premium_sneakers_label = 'Toutes nos sneakers'
  assign premium_streetwear_label = 'Streetwear'
  assign premium_blog_label = 'Blog'
  assign premium_search_placeholder = 'search.placeholder_brand_model' | t

  if locale_base == 'de'
    assign premium_sneakers_label = 'Alle unsere Sneakers'
    assign premium_streetwear_label = 'Streetwear'
    assign premium_blog_label = 'Blog'
  elsif locale_base == 'en'
    assign premium_sneakers_label = 'All our sneakers'
    assign premium_streetwear_label = 'Streetwear'
    assign premium_blog_label = 'Blog'
  endif

  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = section.settings.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  if show_country or show_language
    capture drawer_localization_markup
      render 'dropdown-localization', show_country: show_country, show_language: show_language, show_country_icon: section.settings.show_country_icon, uppercase: section.settings.uppercase_menu_items, font_weight: section.settings.menu_font_weight, form_id: 'LocalizationForm-drawer', drawer: true
    endcapture
  endif

  assign header_logo_text = shop.name | slice: 0 | upcase | append: shop.name | slice: 1, shop.name.size
%}

{%- if section.settings.show_search -%}
  {%- if section.settings.enable_predictive_search or section.settings.search_show_landing != false -%}
    <script>
      (function () {
        if (window.__rlPredictiveSearchLoader) return;
        window.__rlPredictiveSearchLoader = true;

        var moduleUrl = {{ 'predictive-search.js' | asset_url | json }};
        var loaded = false;
        var loading = false;

        function isWeakConnection() {
          var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          if (!c) return false;
          if (c.saveData) return true;
          var t = String(c.effectiveType || '').toLowerCase();
          return t.indexOf('2g') !== -1 || t.indexOf('3g') !== -1;
        }

        function hasSearchResultsRendered() {
          return Boolean(document.querySelector('.main-search--has-results'));
        }

        function triggerExistingInputs() {
          if (hasSearchResultsRendered()) return;
          document.querySelectorAll('predictive-search input[name="q"]').forEach(function (input) {
            if (!input.value || !input.value.trim()) return;
            input.dispatchEvent(new Event('input', { bubbles: true }));
          });
        }

        function loadModule() {
          if (loaded || loading) return;
          loading = true;
          var script = document.createElement('script');
          script.type = 'module';
          script.src = moduleUrl;
          script.onload = function () {
            loaded = true;
            loading = false;
            triggerExistingInputs();
          };
          script.onerror = function () {
            loading = false;
          };
          document.head.appendChild(script);
        }

        function isSearchIntentTarget(target) {
          if (!(target instanceof Element)) return false;
          if (target.closest('predictive-search')) return true;
          if (
            target.matches('input[name="q"], .header__search-input, .rl-desktop-header__search-input, .main-search__input')
          ) {
            return true;
          }
          return false;
        }

        function onIntent(event) {
          if (!isSearchIntentTarget(event.target)) return;
          loadModule();
        }

        document.addEventListener('focusin', onIntent, true);
        document.addEventListener('pointerdown', onIntent, true);
        document.addEventListener('input', onIntent, true);

        var mainSearch = document.querySelector('.main-search');
        if (mainSearch) {
          if (!hasSearchResultsRendered() && !isWeakConnection()) {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadModule, { timeout: 3500 });
            } else {
              setTimeout(loadModule, 2200);
            }
          }
          return;
        }

        {% if template.name == 'search' %}
          if (!isWeakConnection()) {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadModule, { timeout: 2400 });
            } else {
              setTimeout(loadModule, 1200);
            }
          }
        {% endif %}
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% capture header_logo_wordmark %}
  <span class="rl-desktop-header__logo-text">{{ header_logo_text }}</span>
{% endcapture %}

{% capture header_logo_rl_mobile %}
  <a href="{{ routes.root_url }}" class="rl-desktop-header__logo header__logo--rl-mobile" aria-label="{{ header_logo_text }}">
    {{ header_logo_wordmark }}
  </a>
{% endcapture %}

{%- liquid
  assign search_mode = section.settings.search_navigation_mode | default: 'live_page'
  if section.settings.enable_predictive_search != true
    assign search_mode = 'off'
  endif
-%}

{% capture header_search_inline %}
  {%- capture inline_search_form -%}
    <form action="{{ routes.search_url }}" class="header__search-form" role="search">
      <input
        class="header__search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ premium_search_placeholder }}"
        aria-label="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="header__search-submit" aria-label="{{ 'search.placeholder' | t }}">
        <span class="material-symbols-{{ settings.icon_style }} notranslate icon" translate="no">search</span>
      </button>
    </form>
  {%- endcapture -%}

  {%- if search_mode == 'live_page' -%}
    <predictive-search class="header__predictive-search header__predictive-search--inline" data-mode="live_page">
      {{ inline_search_form }}
    </predictive-search>
  {%- elsif search_mode == 'dropdown' -%}
    <predictive-search class="header__predictive-search header__predictive-search--inline" data-mode="dropdown">
      {{ inline_search_form }}
      <div class="rl-search-dropdown predictive-search-results-container--rl-inline">
        {% render 'search-landing' %}
        <div
          data-ref="predictive-live"
          tabindex="-1"
          class="predictive-search-results-container predictive-search-live"
          style="display: none;"
        >
          <div data-ref="predictive-search"></div>
        </div>
      </div>
      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
    </predictive-search>
  {%- else -%}
    {{ inline_search_form }}
  {%- endif -%}
{% endcapture %}

{% capture header_notifications %}
  {% comment %} theme-check-disable {% endcomment %}
  {% content_for 'block', type: '_header-notifications', id: 'header-notifications' %}
  {% comment %} theme-check-enable {% endcomment %}
{% endcapture %}

{% capture header_icons %}
  {% comment %} Resell header: inline search on desktop; menu toggle + icons on mobile. {% endcomment %}
  {% render 'header-actions',
    show_search: section.settings.show_search,
    hide_search_icon: true,
    show_side_menu_toggle: true,
    cart_icon: section.settings.cart_icon,
    account_icon: section.settings.account_icon,
    header_notifications: header_notifications
  %}
{% endcapture %}

<header-component
  class="
    {% if section.settings.enable_transparent_header and template.name == 'index' %}header--transparent color-{{ section.settings.transparent_header_color_scheme }}{% endif %}
    {% if section.settings.enable_sticky_header %} header--sticky{% endif %}
  "
  style="--header-height: {{ section.settings.header_height }}px;"
  {% if section.settings.enable_transparent_header and template.name == 'index' %}
    data-sticky-state="inactive"
  {% elsif section.settings.enable_transparent_header and section.settings.enable_sticky_header == false %}
    data-sticky-state="inactive"
  {% endif %}
>
  <div class="header__layout{% if section.settings.show_bottom_border %} header__layout--bottom-border{% endif %} header__layout-desktop color-{{ section.settings.color_scheme }}">
    <nav class="rl-desktop-header" aria-label="{{ 'accessibility.main_navigation' | t }}">
          <div class="rl-desktop-header__grid">
            <div class="rl-desktop-header__left">
              <a href="{{ routes.root_url }}" class="rl-desktop-header__logo" aria-label="{{ header_logo_text }}">
                {{ header_logo_wordmark }}
              </a>
              {% comment %}
                Hardcoded storefront targets (admin collection IDs for reference only):
                Sneakers row → 442430816545 → handle toutes-nos-paires
                Streetwear row → 668027060610 → handle vetements
              {% endcomment %}
              {% liquid
                assign rl_col_sneakers = collections['toutes-nos-paires']
                assign rl_col_street = collections['vetements']
                if rl_col_sneakers != blank
                  assign rl_sneakers_url = rl_col_sneakers.url
                else
                  assign rl_sneakers_url = '/collections/toutes-nos-paires'
                endif
                if rl_col_street != blank
                  assign rl_streetwear_url = rl_col_street.url
                else
                  assign rl_streetwear_url = '/collections/vetements'
                endif
                assign rl_blog_news = blogs['news']
                if rl_blog_news != blank
                  assign rl_blog_url = rl_blog_news.url
                else
                  assign rl_blog_url = routes.root_url | append: 'blogs/news'
                endif
              %}
              <div class="rl-desktop-header__links">
                <a href="{{ rl_sneakers_url }}" class="rl-desktop-header__link" data-rl-fast-collection-link data-no-locale-lock>{{ premium_sneakers_label }}</a>
                <a href="{{ rl_streetwear_url }}" class="rl-desktop-header__link" data-rl-fast-collection-link data-no-locale-lock>{{ premium_streetwear_label }}</a>
                <a href="{{ rl_blog_url }}" class="rl-desktop-header__link">{{ premium_blog_label }}</a>
              </div>
            </div>

            <div class="rl-desktop-header__search">
              {%- capture rl_desktop_search_form -%}
                <form action="{{ routes.search_url }}" method="get" role="search" class="rl-desktop-header__search-form">
                  <input type="hidden" name="options[prefix]" value="last">
                  <input
                    type="search"
                    name="q"
                    class="rl-desktop-header__search-input"
                    value="{{ search.terms | escape }}"
                    placeholder="{{ premium_search_placeholder }}"
                    aria-label="{{ 'search.placeholder' | t }}"
                    autocomplete="off"
                  >
                  <button type="submit" class="rl-desktop-header__search-button" aria-label="{{ 'accessibility.search' | t }}">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" width="20" height="20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M9.167 15.833a6.667 6.667 0 100-13.333 6.667 6.667 0 000 13.333zM17.5 17.5l-3.625-3.625"/></svg>
                  </button>
                </form>
              {%- endcapture -%}

              {%- if search_mode == 'live_page' -%}
                <predictive-search class="header__predictive-search header__predictive-search--premium" data-mode="live_page">
                  {{ rl_desktop_search_form }}
                </predictive-search>
              {%- elsif search_mode == 'dropdown' -%}
                <predictive-search class="header__predictive-search header__predictive-search--premium" data-mode="dropdown">
                  {{ rl_desktop_search_form }}
                  <div class="rl-search-dropdown predictive-search-results-container--rl-inline">
                    {% render 'search-landing' %}
                    <div
                      data-ref="predictive-live"
                      tabindex="-1"
                      class="predictive-search-results-container predictive-search-live"
                      style="display: none;"
                    >
                      <div data-ref="predictive-search"></div>
                    </div>
                  </div>
                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                </predictive-search>
              {%- else -%}
                {{ rl_desktop_search_form }}
              {%- endif -%}
            </div>

            <div class="rl-desktop-header__icons">
              {% if shop.customer_accounts_enabled %}
                <a href="{{ routes.account_url }}" class="rl-desktop-header__icon" aria-label="{{ 'customer.account.title' | t }}">
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" width="20" height="20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M16.667 17.5v-1.667a3.333 3.333 0 00-3.334-3.333H6.667a3.333 3.333 0 00-3.334 3.333V17.5M10 9.167A3.333 3.333 0 1010 2.5a3.333 3.333 0 000 6.667z"/></svg>
                </a>
              {% endif %}

              {% if settings.activate_wishlist %}
                {% capture rl_wishlist_url %}{% render 'rl-wishlist-url' %}{% endcapture %}
                <button type="button" class="rl-desktop-header__icon" aria-label="{{ 'accessibility.wishlist' | t }}" data-rl-action="wishlist" data-rl-wishlist-url="{{ rl_wishlist_url }}">
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" width="20" height="20"><path d="M10 16.5s-6-3.7-6-8.1A3.4 3.4 0 0 1 10 6.2a3.4 3.4 0 0 1 6 2.2c0 4.4-6 8.1-6 8.1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
                </button>
              {% else %}
                <span class="rl-desktop-header__icon rl-desktop-header__icon--wishlist-spacer" aria-hidden="true"></span>
              {% endif %}

              <a href="{{ routes.cart_url }}" class="rl-desktop-header__icon rl-desktop-header__icon--cart" aria-label="{{ 'accessibility.cart' | t }}" style="position:relative;">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" width="20" height="20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M5 1.667L2.5 5v11.667a1.667 1.667 0 001.667 1.666h11.666a1.666 1.666 0 001.667-1.666V5L15 1.667H5zM2.5 5h15M13.333 8.333a3.333 3.333 0 01-6.666 0"/></svg>
                <span class="rl-cart-badge{% if cart.item_count == 0 %} rl-cart-badge--hidden{% endif %}" data-rl-cart-badge aria-hidden="true">{{- cart.item_count -}}</span>
              </a>

              <button type="button" class="rl-desktop-header__icon" aria-label="{{ 'accessibility.menu_open' | t }}" data-ref="menu-toggle" aria-expanded="false" aria-controls="header-mobile-drawer">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" width="20" height="20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M2.5 10h15m-15-5h15m-15 10h15"/></svg>
              </button>
            </div>
          </div>
        </nav>
    <script src="{{ 'rl-premium-header.js' | asset_url }}" defer></script>
  </div>

  <div class="header__layout header__layout-mobile header__layout-mobile--premium color-{{ section.settings.color_scheme }}" style="--header-height: {{ section.settings.header_height }}px;">
    <div class="header__layout--logo-center header__layout--rl-mobile-top">
      {{ header_logo_rl_mobile }}
      {{ header_icons }}
    </div>

    <div class="header__layout--rl-mobile-search">
      {{ header_search_inline }}
    </div>
  </div>

  {% comment %} Drawer rendered outside mobile layout so it works on all viewports {% endcomment %}
  {% assign menu_links = section.settings.menu_mobile.links %}
  {% if section.settings.menu_mobile == blank %}
    {% assign menu_links = section.settings.menu.links %}
  {% endif %}

  {% liquid
    assign rl_col_sneakers = collections['toutes-nos-paires']
    if rl_col_sneakers != blank
      assign drawer_view_all_resolved = rl_col_sneakers.url
    else
      assign drawer_view_all_resolved = routes.root_url | append: '/collections/toutes-nos-paires'
    endif
  %}

  {% render 'header-drawer-menu',
    menu_links: menu_links,
    localization_markup: drawer_localization_markup,
    uppercase: section.settings.uppercase_menu_items,
    font_weight: section.settings.menu_font_weight,
    use_demo_categories: section.settings.drawer_use_demo_categories,
    color_scheme: section.settings.drawer_color_scheme,
    show_top_image: section.settings.drawer_show_top_image,
    top_image: section.settings.drawer_top_image,
    top_image_filename: section.settings.drawer_top_image_filename,
    rotate_top_image: section.settings.drawer_top_image_rotate,
    show_menu_header: section.settings.drawer_show_menu_header,
    menu_title: section.settings.drawer_menu_title,
    view_all_label: section.settings.drawer_view_all_label,
    view_all_url: drawer_view_all_resolved
  %}
</header-component>

{% style %}
  body {
    --header-height: {{ section.settings.header_height }}px;
  }
{% endstyle %}

{% comment %} Header styles → assets/rl-header.css {% endcomment %}

{% if section.settings.enable_sticky_header %}
  {% style %}
    .section-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: inherit;
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "t:header",
  "tag": "header",
  "class": "section-header",
  "blocks": [
    {
      "type": "_header-notifications"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:layout"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "t:header_height",
      "default": 65,
      "min": 50,
      "max": 80,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Recherche une marque, un modele..."
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "t:enable_sticky_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "t:enable_transparent_header",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "transparent_header_color_scheme",
      "label": "t:transparent_header_color_scheme",
      "default": "scheme-3",
      "visible_if": "{{ section.settings.enable_transparent_header }}"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "t:show_bottom_border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:logo"
    },
    {
      "type": "paragraph",
      "content": "t:logo_comes_from_theme_settings"
    },
    {
      "type": "text",
      "id": "mobile_logo_text",
      "label": "Mobile logo text",
      "default": "Resell_lausanne",
      "info": "Plain text wordmark on mobile. Desktop uses theme logo image."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:logo_height",
      "default": 25,
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:menus"
    },
    {
      "type": "range",
      "id": "menu_font_weight",
      "label": "t:font_weight",
      "default": 400,
      "min": 300,
      "max": 600,
      "step": 100
    },
    {
      "type": "checkbox",
      "id": "uppercase_menu_items",
      "label": "t:uppercase_menu_items",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:menu",
      "info": "Fallback for mobile drawer when Menu mobile is empty."
    },
    {
      "type": "header",
      "content": "t:menu_mobile"
    },
    {
      "type": "link_list",
      "id": "menu_mobile",
      "label": "t:menu"
    },
    {
      "type": "header",
      "content": "Drawer menu"
    },
    {
      "type": "color_scheme",
      "id": "drawer_color_scheme",
      "label": "Drawer color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "drawer_use_demo_categories",
      "label": "Use demo nested categories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drawer_show_top_image",
      "label": "Show drawer top image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "drawer_top_image",
      "label": "Drawer top image",
      "info": "Optional override. If empty, uses the Shopify Files image below (survives theme push).",
      "visible_if": "{{ section.settings.drawer_show_top_image }}"
    },
    {
      "type": "text",
      "id": "drawer_top_image_filename",
      "label": "Drawer hero filename (Shopify Files)",
      "default": "top-menu-picture.jpg",
      "info": "Upload this file in Admin → Content → Files. Used when no image is picked above. Safe across theme pushes.",
      "visible_if": "{{ section.settings.drawer_show_top_image }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_top_image_rotate",
      "label": "Rotate drawer top image 90° (portrait sources)",
      "info": "Enable when your image is vertical. Upload the portrait file as-is, then toggle this on.",
      "default": false,
      "visible_if": "{{ section.settings.drawer_show_top_image }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_show_menu_header",
      "label": "Show drawer menu heading",
      "default": true
    },
    {
      "type": "text",
      "id": "drawer_menu_title",
      "label": "Drawer menu heading",
      "default": "Nos Produits",
      "visible_if": "{{ section.settings.drawer_show_menu_header }}"
    },
    {
      "type": "text",
      "id": "drawer_view_all_label",
      "label": "Drawer view all label",
      "default": "Tout voir",
      "visible_if": "{{ section.settings.drawer_show_menu_header }}"
    },
    {
      "type": "header",
      "content": "t:actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "t:enable_predictive_search",
      "default": true,
      "info": "t:predictive_search_info",
      "visible_if": "{{ section.settings.show_search == true }}"
    },
    {
      "type": "select",
      "id": "search_navigation_mode",
      "label": "Search results behaviour",
      "options": [
        { "value": "live_page", "label": "Full search page" },
        { "value": "dropdown", "label": "Dropdown under header (legacy)" }
      ],
      "default": "live_page",
      "info": "Live page navigates to /search and updates results in place while typing. Dropdown shows a small predictive panel under the bar.",
      "visible_if": "{{ section.settings.show_search == true and section.settings.enable_predictive_search == true }}"
    },
    {
      "type": "header",
      "content": "Search overlay landing"
    },
    {
      "type": "checkbox",
      "id": "search_show_landing",
      "label": "Show search landing (recents, popular, promo)",
      "default": true,
      "info": "Shown when the search field is empty (modal and premium header search bar). Popular lines: one per line, optional link after pipe: Label|/collections/all"
    },
    {
      "type": "text",
      "id": "search_recent_heading",
      "label": "Recent searches heading",
      "default": "Recherches récentes"
    },
    {
      "type": "text",
      "id": "search_popular_heading",
      "label": "Popular searches heading",
      "default": "Recherches populaires"
    },
    {
      "type": "textarea",
      "id": "search_popular_lines",
      "label": "Popular searches",
      "default": "Nike x Travis Scott|/search?q=Nike+x+Travis+Scott\nAir Jordan 4|/search?q=Air+Jordan+4\nEssentials Fear of God|/search?q=Essentials+Fear+of+God",
      "info": "One per line. Optional target: Label|/path-or-url"
    },
    {
      "type": "image_picker",
      "id": "search_promo_image",
      "label": "Search promo image"
    },
    {
      "type": "text",
      "id": "search_promo_title",
      "label": "Search promo title",
      "default": "Les best-sellers"
    },
