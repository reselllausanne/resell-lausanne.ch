{% liquid
  assign use_default = section.settings.use_resell_default_copy
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first
  assign is_fr_locale = false
  if locale_base == 'fr'
    assign is_fr_locale = true
  endif
  assign _handle = collection.handle | downcase
  assign brand_seo_snippet = ''
  assign seo_heading = section.settings.heading
  assign seo_subheading = section.settings.subheading
  assign seo_body = section.settings.body
  assign disable_seo_section = false
  if _handle == 'les-meilleures-collaborations'
    assign disable_seo_section = true
  endif

  if disable_seo_section == false and seo_heading == blank and seo_body == blank
    if _handle == 'onitsuka-tiger' or _handle == 'onitsuka' or _handle == 'onitsuka-tokuten' or _handle contains 'onitsuka'
      assign brand_seo_snippet = 'collection-plp-seo-onitsuka-tiger-content'
      if locale_base == 'de'
        assign seo_heading = 'Onitsuka Tiger — Mexico 66, Tokuten & japanisches ASICS-Erbe'
        assign seo_subheading = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano, Mexico 66 SD — geprüft und in der Schweiz geliefert.'
      elsif locale_base == 'en'
        assign seo_heading = 'Onitsuka Tiger — Mexico 66, Tokuten & ASICS Japanese heritage'
        assign seo_subheading = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano, Mexico 66 SD — authenticated and delivered in Switzerland.'
      else
        assign seo_heading = "Onitsuka Tiger — Mexico 66, Tokuten et l'héritage japonais ASICS"
        assign seo_subheading = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano, Mexico 66 SD — authentifiés et livrés en Suisse.'
      endif
    elsif locale_base == 'en' or locale_base == 'de'
      if _handle == 'air-jordan-x-travis-scott' or _handle == 'travis-scott' or _handle == 'vetement-travis' or _handle contains 'travis-scott' or _handle contains 'travis'
        if locale_base == 'de'
          assign seo_heading = 'Travis Scott × Nike — Authentische Sneakers in der Schweiz'
          assign seo_subheading = 'Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack, Nike SB Dunk Low Travis Scott — geprüft und geliefert.'
        else
          assign seo_heading = 'Travis Scott × Nike — Authentic sneakers in Switzerland'
          assign seo_subheading = 'Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack, Nike SB Dunk Low Travis Scott — verified and delivered.'
        endif
      elsif _handle == 'essentials' or _handle == 'fear-of-god-essentials'
        if locale_base == 'de'
          assign seo_heading = 'Fear of God Essentials — Minimalistischer Streetwear in der Schweiz'
          assign seo_subheading = 'Das zugängliche Fear-of-God-Sublabel von Jerry Lorenzo — authentische Hoodies, Tees und Jogginghosen.'
        else
          assign seo_heading = 'Fear of God Essentials — Minimalist streetwear in Switzerland'
          assign seo_subheading = 'Jerry Lorenzo accessible Fear of God sub-label — authentic hoodies, tees and joggers.'
        endif
      elsif _handle == 'nike-air-max-plus-tn' or _handle == 'air-max-plus' or _handle == 'tn' or _handle == 'nike-tn' or _handle contains 'air-max-plus' or _handle contains 'nike-tn'
        if locale_base == 'de'
          assign seo_heading = 'Nike Air Max Plus TN — Kult-Silhouette in der Schweiz'
          assign seo_subheading = 'Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta — geprüft und geliefert.'
        else
          assign seo_heading = 'Nike Air Max Plus TN — Cult silhouette in Switzerland'
          assign seo_subheading = 'Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta — verified and delivered.'
        endif
      elsif _handle == 'nike-air-max-95' or _handle == 'air-max-95' or _handle contains 'air-max-95'
        if locale_base == 'de'
          assign seo_heading = 'Nike Air Max 95 — Retro Air Max in der Schweiz'
          assign seo_subheading = 'Neon OG, Big Bubble, Triple Black, Corteiz — authentisch für Herren und Damen.'
        else
          assign seo_heading = 'Nike Air Max 95 — Retro Air Max in Switzerland'
          assign seo_subheading = 'Neon OG, Big Bubble, Triple Black, Corteiz — authentic men and women.'
        endif
      elsif _handle == 'air-jordan-4' or _handle == 'jordan-4' or _handle contains 'air-jordan-4' or _handle contains 'jordan-4'
        if locale_base == 'de'
          assign seo_heading = 'Air Jordan 4 — Authentische Sneakers in der Schweiz'
          assign seo_subheading = 'Bred, White Cement, Military Black, Travis Scott, Off-White, Union LA — geprüft und geliefert.'
        else
          assign seo_heading = 'Air Jordan 4 — Authentic sneakers in Switzerland'
          assign seo_subheading = 'Bred, White Cement, Military Black, Travis Scott, Off-White, Union LA — verified and delivered.'
        endif
      elsif _handle == 'asics-gel-kayano-14' or _handle == 'gel-kayano-14' or _handle == 'kayano-14' or _handle contains 'kayano'
        if locale_base == 'de'
          assign seo_heading = 'ASICS Gel-Kayano 14 — Y2K Running-Lifestyle in der Schweiz'
          assign seo_subheading = 'White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY — geprüft und geliefert.'
        else
          assign seo_heading = 'ASICS Gel-Kayano 14 — Y2K running lifestyle in Switzerland'
          assign seo_subheading = 'White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY — verified and delivered.'
        endif
      endif
    endif
  endif

  if disable_seo_section == false and seo_heading == blank and seo_body == blank and is_fr_locale
    if _handle == 'air-jordan-x-travis-scott' or _handle == 'travis-scott' or _handle == 'vetement-travis' or _handle contains 'travis-scott' or _handle contains 'travis'
      assign seo_heading = "Travis Scott × Nike — Sneakers authentiques en Suisse"
