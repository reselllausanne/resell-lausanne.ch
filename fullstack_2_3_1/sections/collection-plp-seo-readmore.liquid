    elsif _handle == 'crampons-de-foot' or _handle == 'football' or _handle == 'crampons' or _handle contains 'crampons'
      assign seo_heading = "Crampons de foot — Nike, Adidas et éditions limitées"
      assign seo_subheading = "Nike Mercurial, Tiempo, Phantom, Adidas Predator, F50 et Copa — authentiques, FG/SG/AG/TF, livrés en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-crampons-foot-content'
    elsif _handle == 'chrome-hearts' or _handle contains 'chrome-hearts'
      assign seo_heading = "Chrome Hearts — Hoodies, t-shirts, bijoux argent et lunettes authentiques en Suisse"
      assign seo_subheading = "Chrome Hearts CH, croix gothique, bijoux argent 925, lunettes optiques — authentifiés et livrés en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-chrome-hearts-content'
    elsif _handle == 'denim-tears' or _handle contains 'denim-tears'
      assign seo_heading = "Denim Tears — Tremaine Emory, Cotton Wreath et collaborations Levi's, Stüssy, Dior"
      assign seo_subheading = "Jeans Cotton Wreath, hoodies, t-shirts Denim Tears — authentifiés et livrés en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-denim-tears-content'
    elsif _handle == 'adidas-spezial' or _handle == 'handball-spezial' or _handle == 'trimm-trab' or _handle == 'spezial' or _handle contains 'spezial'
      assign seo_heading = "Adidas Spezial — Handball Spezial, Trimm Trab et l'archive premium Gary Aspden"
      assign seo_subheading = "Handball Spezial, Trimm Trab, Wensley, Munchen, Adimatic, Albrecht — authentifiés et livrés en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-adidas-spezial-content'
    elsif _handle == 'nike-air-max-plus-tn' or _handle == 'air-max-plus' or _handle == 'tn' or _handle == 'nike-tn' or _handle contains 'air-max-plus' or _handle contains 'nike-tn'
      assign seo_heading = "Nike TN Air Max Plus — La silhouette culte européenne"
      assign seo_subheading = "TN Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta, Atlanta, Marseille — authentifiées et livrées en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-nike-tn-content'
    elsif _handle == 'nike-air-max-95' or _handle == 'air-max-95' or _handle contains 'air-max-95'
      assign seo_heading = "Nike Air Max 95 Suisse | Retro Air Max & Tailles"
      assign seo_subheading = "Neon OG, Big Bubble, Triple Black, Corteiz, homme et femme — authentifiées et livrées en Suisse."
      assign brand_seo_snippet = 'collection-plp-seo-nike-air-max-95-content'
    elsif _handle == 'dunk' or _handle == 'dunk-low' or _handle == 'dunk-sb' or _handle == 'nike-sb-dunk' or _handle == 'nike-dunk' or _handle contains 'dunk'
      assign seo_heading = "Nike Dunk et SB Dunk — La silhouette streetwear absolue"
      assign seo_subheading = "Dunk Low Panda, SB Dunk Low Travis Scott, Chunky Dunky, Lobster, Pigeon, Off-White, Supreme — authentifiées et livrées en Suisse."
