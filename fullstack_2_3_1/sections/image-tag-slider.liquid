      "settings": {
        "layout_style": "home_strip",
        "heading": "",
        "slider_aria_label": "Les sélections sneakers",
        "show_heading_link": false,
        "show_rail_arrows": false,
        "card_ratio": "landscape"
      },
      "blocks": [
        {
