{%- liquid
  assign rl_judgeme_url = 'https://judge.me/reviews/stores/www.resell-lausanne.ch'
  assign rl_google_url = 'https://g.page/r/CeYZofa-lMfJEAI/review'

  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first

  assign rl_rv_heading = section.settings.heading
  assign rl_rv_description = section.settings.description
  assign rl_rv_stat_rating_label = 'note moyenne'
  assign rl_rv_stat_reviews_label = 'avis vérifiés'
  assign rl_rv_stars_aria = section.settings.avg_rating | append: ' étoiles sur 5'
  assign rl_rv_judgeme_cta = 'Voir tous les avis vérifiés →'
  assign rl_rv_trustpilot_cta = 'Voir le profil Trustpilot →'
  assign rl_rv_google_cta = 'Laisser un avis Google →'
  assign rl_rv_instagram_cta = 'Stories & témoignages →'
  assign rl_rv_embed_heading = 'Avis vérifiés Judge.me'
  assign rl_rv_embed_outlink = 'Voir sur Judge.me →'
  assign rl_rv_trustpilot_label = 'Aussi sur Trustpilot'
  assign rl_trustpilot_locale = section.settings.trustpilot_locale | default: 'fr-FR'

  if locale_base == 'de'
    assign rl_rv_heading = 'Kundenbewertungen zu Resell Lausanne'
    assign rl_rv_description = '<p>Alle verifizierten Kundenbewertungen: Judge.me, Trustpilot, Google und Instagram. Über 580 Erfahrungsberichte zufriedener Kunden in der Schweiz und international.</p>'
    assign rl_rv_stat_rating_label = 'Durchschnittsnote'
    assign rl_rv_stat_reviews_label = 'verifizierte Bewertungen'
    assign rl_rv_stars_aria = section.settings.avg_rating | append: ' von 5 Sternen'
    assign rl_rv_judgeme_cta = 'Alle verifizierten Bewertungen ansehen →'
    assign rl_rv_trustpilot_cta = 'Trustpilot-Profil ansehen →'
    assign rl_rv_google_cta = 'Google-Bewertung hinterlassen →'
    assign rl_rv_instagram_cta = 'Stories & Erfahrungsberichte →'
    assign rl_rv_embed_heading = 'Verifizierte Judge.me-Bewertungen'
    assign rl_rv_embed_outlink = 'Auf Judge.me ansehen →'
    assign rl_rv_trustpilot_label = 'Auch auf Trustpilot'
    assign rl_trustpilot_locale = 'de-DE'
  elsif locale_base == 'en'
    assign rl_rv_heading = 'Reviews of Resell Lausanne'
    assign rl_rv_description = '<p>All our verified customer reviews on Judge.me, Trustpilot, Google and Instagram. Over 580 testimonials from satisfied customers in Switzerland and worldwide.</p>'
    assign rl_rv_stat_rating_label = 'average rating'
    assign rl_rv_stat_reviews_label = 'verified reviews'
    assign rl_rv_stars_aria = section.settings.avg_rating | append: ' stars out of 5'
    assign rl_rv_judgeme_cta = 'View all verified reviews →'
    assign rl_rv_trustpilot_cta = 'View Trustpilot profile →'
    assign rl_rv_google_cta = 'Leave a Google review →'
    assign rl_rv_instagram_cta = 'Stories & testimonials →'
    assign rl_rv_embed_heading = 'Verified Judge.me reviews'
    assign rl_rv_embed_outlink = 'View on Judge.me →'
    assign rl_rv_trustpilot_label = 'Also on Trustpilot'
    assign rl_trustpilot_locale = 'en-US'
  endif
-%}

<section
  class="rl-rv-page color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    <div class="rl-rv-page__hero">
      <h1 class="rl-rv-page__h1">{{ rl_rv_heading }}</h1>
      {%- if rl_rv_description != blank -%}
        <div class="rl-rv-page__intro rte">{{ rl_rv_description }}</div>
      {%- endif -%}

      <div class="rl-rv-page__stats">
        <div class="rl-rv-page__stat-main">
          <span class="rl-rv-page__stat-number">{{ section.settings.avg_rating }}</span>
          <span class="rl-rv-page__stat-stars" aria-label="{{ rl_rv_stars_aria }}">★★★★★</span>
          <span class="rl-rv-page__stat-label">{{ rl_rv_stat_rating_label }}</span>
        </div>
        <div class="rl-rv-page__stat-sep" aria-hidden="true"></div>
        <div class="rl-rv-page__stat-count">
          <span class="rl-rv-page__stat-big">{{ section.settings.total_reviews_count }}+</span>
          <span class="rl-rv-page__stat-label">{{ rl_rv_stat_reviews_label }}</span>
        </div>
        <div class="rl-rv-page__stat-sep" aria-hidden="true"></div>
        <div class="rl-rv-page__platforms-row">
          <span class="rl-rv-page__src-pill rl-rv-page__src-pill--judgeme">Judge.me</span>
          <span class="rl-rv-page__src-pill rl-rv-page__src-pill--trustpilot">Trustpilot</span>
          <span class="rl-rv-page__src-pill rl-rv-page__src-pill--google">Google</span>
          <span class="rl-rv-page__src-pill rl-rv-page__src-pill--instagram">Instagram</span>
        </div>
      </div>
    </div>

    <div class="rl-rv-page__backlinks">
      <a href="{{ rl_judgeme_url }}" target="_blank" rel="noopener noreferrer" class="rl-rv-page__backlink rl-rv-page__backlink--judgeme">
        <span class="rl-rv-page__backlink-name">Judge.me</span>
        <span class="rl-rv-page__backlink-cta">{{ rl_rv_judgeme_cta }}</span>
      </a>
      {%- if section.settings.trustpilot_url != blank -%}
        <a href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener noreferrer" class="rl-rv-page__backlink rl-rv-page__backlink--trustpilot">
          <span class="rl-rv-page__backlink-name">Trustpilot</span>
          <span class="rl-rv-page__backlink-cta">{{ rl_rv_trustpilot_cta }}</span>
        </a>
      {%- endif -%}
      <a href="{{ rl_google_url }}" target="_blank" rel="noopener noreferrer" class="rl-rv-page__backlink rl-rv-page__backlink--google">
        <span class="rl-rv-page__backlink-name">Google</span>
        <span class="rl-rv-page__backlink-cta">{{ rl_rv_google_cta }}</span>
      </a>
      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="rl-rv-page__backlink rl-rv-page__backlink--instagram">
          <span class="rl-rv-page__backlink-name">Instagram</span>
          <span class="rl-rv-page__backlink-cta">{{ rl_rv_instagram_cta }}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="rl-rv-page__embed rl-rv-page__embed--judgeme-live">
      <div class="rl-rv-page__embed-heading-row">
        <h2 class="rl-rv-page__embed-heading">{{ rl_rv_embed_heading }}</h2>
        <a href="{{ rl_judgeme_url }}" target="_blank" rel="noopener noreferrer" class="rl-rv-page__embed-outlink">
          {{ rl_rv_embed_outlink }}
        </a>
      </div>
      <div class="rl-rv-page__embed-inner">
        {% render 'resell-judgeme-reviews-page' %}
      </div>
    </div>

    <div class="rl-rv-page__trustpilot-compact">
      <p class="rl-rv-page__trustpilot-label">{{ rl_rv_trustpilot_label }}</p>
      {% render 'resell-trustpilot-trustbox',
        profile_url: section.settings.trustpilot_url,
        template_id: section.settings.trustpilot_template_id,
        businessunit_id: section.settings.trustpilot_businessunit_id,
        locale: rl_trustpilot_locale,
        height: section.settings.trustpilot_height,
        width: section.settings.trustpilot_width
      %}
    </div>

  </div>
</section>

{% stylesheet %}
  .rl-rv-page {
    padding-top: var(--rl-rv-pt, 48px);
    padding-bottom: var(--rl-rv-pb, 56px);
  }

  .rl-rv-page__hero {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }

  .rl-rv-page__h1 {
    margin: 0;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .rl-rv-page__intro {
    max-width: 860px;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .rl-rv-page__intro p {
    margin: 0 0 10px;
  }

  .rl-rv-page__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .rl-rv-page__stat-main,
  .rl-rv-page__stat-count {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rl-rv-page__stat-number,
  .rl-rv-page__stat-big {
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .rl-rv-page__stat-stars {
    font-size: 18px;
    color: #f59f00;
    letter-spacing: 1px;
  }

  .rl-rv-page__stat-label {
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / 0.62);
    white-space: nowrap;
  }

  .rl-rv-page__stat-sep {
    width: 1px;
    height: 28px;
    background: rgb(var(--color-foreground-rgb) / 0.14);
  }

  .rl-rv-page__platforms-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .rl-rv-page__src-pill {
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .rl-rv-page__src-pill--judgeme { background: #e6f7ef; color: #00a651; }
  .rl-rv-page__src-pill--trustpilot { background: #e5f8f2; color: #00b67a; }
  .rl-rv-page__src-pill--google { background: #e8f0fe; color: #1a73e8; }
  .rl-rv-page__src-pill--instagram { background: #fce4ec; color: #c2185b; }

  .rl-rv-page__backlinks {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
    margin-bottom: 32px;
  }

  .rl-rv-page__backlink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 18px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .rl-rv-page__backlink:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
  }

  .rl-rv-page__backlink--judgeme { background: #e6f7ef; border-color: #b2dfcc; color: #00612f; }
  .rl-rv-page__backlink--trustpilot { background: #e5f8f2; border-color: #a8edda; color: #00694a; }
  .rl-rv-page__backlink--google { background: #e8f0fe; border-color: #c5d6f9; color: #1557b0; }
  .rl-rv-page__backlink--instagram { background: #fce4ec; border-color: #f48fb1; color: #880e4f; }

  .rl-rv-page__backlink-name {
    font-weight: 700;
    font-size: 15px;
  }

  .rl-rv-page__backlink-cta {
    font-size: 13px;
    opacity: 0.82;
  }

  .rl-rv-page__embed {
    margin-bottom: 24px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 12px;
    overflow: hidden;
  }

  .rl-rv-page__embed-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 16px 20px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .rl-rv-page__embed-heading {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }

  .rl-rv-page__embed-outlink {
    font-size: 13px;
    font-weight: 500;
    text-decoration: underline;
    color: rgb(var(--color-foreground-rgb) / 0.78);
    white-space: nowrap;
  }

  .rl-rv-page__embed-outlink:hover {
    color: rgb(var(--color-foreground-rgb));
  }

  .rl-rv-page__embed-inner {
    padding: 16px;
  }

  .rl-rv-page__embed--judgeme-live .rl-rv-page__embed-inner {
    padding: 0;
  }

  .rl-rv-page__embed--judgeme-live .jdgm-all-reviews-widget-v2025 {
    width: 100%;
  }

  .rl-rv-page__trustpilot-compact {
    display: grid;
    gap: 8px;
    justify-items: start;
    margin-top: 8px;
  }

  .rl-rv-page__trustpilot-label {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .rl-rv-page__trustpilot-compact .rl-trustpilot-trustbox {
    width: 100%;
    max-width: 420px;
    min-height: 52px;
    height: auto;
  }

  @media (width >= 768px) {
    .rl-rv-page__backlinks {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (width >= 1024px) {
    .rl-rv-page__backlinks {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis — hub page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Couleur",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "H1",
      "default": "Avis sur Resell Lausanne"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Intro",
      "default": "<p>Tous nos avis clients vérifiés sur Judge.me, Trustpilot, Google et Instagram.</p>"
    },
    {
      "type": "header",
      "content": "Statistiques"
    },
    {
      "type": "text",
      "id": "avg_rating",
      "label": "Note moyenne",
      "default": "4.9"
    },
    {
      "type": "number",
      "id": "total_reviews_count",
      "label": "Nombre total d'avis",
      "default": 589
    },
    {
      "type": "header",
      "content": "Liens externes (backlinks)"
    },
    {
      "type": "paragraph",
      "content": "Judge.me et Google sont codés en dur dans le thème. Trustpilot et Instagram restent configurables ci-dessous."
    },
    {
      "type": "url",
      "id": "trustpilot_url",
      "label": "URL Trustpilot"
    },
    {
      "type": "text",
      "id": "trustpilot_businessunit_id",
      "label": "Trustpilot business unit ID",
      "default": "692f26f94b831b0b8ac62db6"
    },
    {
      "type": "text",
      "id": "trustpilot_template_id",
      "label": "Trustpilot template ID",
      "default": "56278e9abfbbba0bdc568bc",
      "info": "56278e9a… = compact badge (same as footer). Not the full List widget."
    },
    {
      "type": "text",
      "id": "trustpilot_locale",
      "label": "Trustpilot locale",
      "default": "fr-FR"
    },
    {
      "type": "text",
      "id": "trustpilot_height",
      "label": "Trustpilot widget height",
      "default": "52px"
    },
    {
      "type": "text",
      "id": "trustpilot_width",
      "label": "Trustpilot widget width",
      "default": "100%"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "URL Instagram"
    },
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Avis — hub page"
    }
  ]
}
{% endschema %}
