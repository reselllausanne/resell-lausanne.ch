  assign return_request_url = pages['demande-retour'].url | default: '/pages/demande-retour'
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  for policy in shop.policies
    if policy.url contains '/policies/privacy-policy'
      assign privacy_url = policy.url
    endif
