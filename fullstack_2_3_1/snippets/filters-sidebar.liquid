<div class="filters-sidebar">
    {%- liquid
      assign plp_skip_vendor = false
      assign plp_skip_category = false
      assign plp_handle = collection.handle | default: '' | downcase | strip
      assign plp_is_broad = false
      if plp_handle == blank
        assign plp_is_broad = true
      elsif plp_handle == 'all' or plp_handle == 'toutes-nos-paires' or plp_handle == 'nouveautes' or plp_handle == 'soldes' or plp_handle == 'soldes-48h' or plp_handle == 'express-delivery' or plp_handle == 'back-to-school-2026'
        assign plp_is_broad = true
      endif
      unless plp_is_broad
        assign plp_skip_vendor = true
        assign plp_skip_category = true
      endunless
    -%}
    {% if show_sorting %}
      <p class="filters-sidebar__filter-label">{{ 'collections.sorting.sort_by' | t }}</p>

      {% render 'sort-select', collection: collection %}

      {% if show_filters %}
        {% render 'separator', margin_bottom: 20, margin_top: 20 %}
      {% endif %}
    {% endif %}

    {% if show_filters %}
      <filter-component data-ref="filters-sidebar">
        <form class="filters" data-ref="filters-form">
          <div class="filters-sidebar__list">
            {%- for filter in collection.filters -%}
              {%- liquid
                assign plp_hide_this = false
                assign plp_pn = filter.param_name | default: '' | downcase
                assign plp_lbl = filter.label | default: '' | downcase
                if plp_skip_vendor
                  if plp_pn contains 'vendor' or plp_lbl == 'marque' or plp_lbl == 'brand' or plp_lbl == 'vendor' or plp_lbl == 'marke' or plp_lbl == 'marca'
                    assign plp_hide_this = true
                  endif
                endif
                if plp_skip_category
                  if plp_pn contains 'category' or plp_pn contains 'catégorie' or plp_lbl == 'catégorie' or plp_lbl == 'categorie' or plp_lbl == 'category' or plp_lbl == 'kategorie'
                    assign plp_hide_this = true
                  endif
                endif
              -%}
              {%- unless plp_hide_this -%}
              <p class="filters-sidebar__filter-label">{{ filter.label }}</p>
              {%- case filter.type -%}
                {%- when 'boolean' -%}
                  <div data-ref="filter-raw">
                    {% render 'filter-boolean', filter: filter %}
                  </div>

                {%- when 'list' -%}
                  <div data-ref="filter-raw">
                    {% render 'filter-list', filter: filter %}
                  </div>

                {%- when 'price_range' -%}
                  <div data-ref="filter-raw">
                    {% render 'filter-price-range', filter: filter %}
                  </div>
              {%- endcase -%}

              {% if forloop.last == false %}
                {% render 'separator', margin_bottom: 20, margin_top: 20 %}
              {% endif %}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </form>
      </filter-component>
    {% endif %}
</div>

{% stylesheet %}
  .filters-sidebar__list {
    display: flex;
    flex-direction: column;
  }

  .filters-sidebar__filter-label {
    display: block;
    font-size: var(--font-body--size-emphasized);
    font-weight: 600;
    margin-bottom: var(--margin-sm);
  }
{% endstylesheet %}
