{%- liquid
  assign popup_nav_mode = section.settings.search_navigation_mode | default: 'live_page'
  if section.settings.enable_predictive_search != true
    assign popup_nav_mode = 'off'
  endif
-%}

{%- if popup_nav_mode == 'live_page' -%}
  <a class="header__icon-search header__icon-search--link" href="{{ routes.search_url }}" aria-label="{{ 'search.placeholder' | t }}">
    <span class="material-symbols-{{ settings.icon_style }} notranslate icon" translate="no">search</span>
  </a>
{%- else -%}
<dialog-component class="search-popup">
  <dialog
    id="search-popup"
    class="dialog-modal card color-scheme-1 dialog-modal--top dialog-modal--search"
    data-ref="popup-modal"
    style="
      --search-modal-max-height: var(--modal-max-height);
      --search-modal-max-height-mobile: 85dvh;
    "
  >
    <div class="dialog-modal__content search-popup__inner">
      {% capture search_form %}
        <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
          {% assign search_terms = search.terms | escape %}
          {% assign search_label = 'search.placeholder' | t %}
          <div class="input-group">
            {% render 'textfield', label: search_label, name: 'q', value: search_terms, full_width: true %}
            <input type="hidden" name="options[prefix]" value="last">
            <div class="input-group__action">
              {% render 'button', type: 'submit', icon: 'search' %}
            </div>
          </div>

          <div class="dialog-modal__close">
            {% render 'button', block: block, icon: 'close', button_style: 'tertiary', data: 'data-ref="popup-close"' %}
          </div>
        </form>
      {% endcapture %}

      {%- assign popup_search_mode = popup_nav_mode -%}

      {%- if popup_search_mode == 'dropdown' -%}
        <predictive-search data-mode="dropdown">
          {{ search_form }}

          {% render 'search-landing' %}

          <div
            data-ref="predictive-live"
            tabindex="-1"
            class="predictive-search-results-container predictive-search-live"
            style="display: none;"
          >
            <div data-ref="predictive-search">
              {%- render 'loading-spinner' -%}
            </div>
          </div>

          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        </predictive-search>
      {%- else -%}
        <div class="search-popup__non-predictive">
          {{ search_form }}
          {% render 'search-landing' %}
        </div>
      {%- endif -%}
    </div>
  </dialog>

  <button type="button" class="header__icon-search" data-ref="popup-toggle">
    <span class="material-symbols-{{ settings.icon_style }} notranslate icon" translate="no">search</span>
  </button>
</dialog-component>
{%- endif -%}

{% comment %} Search popup styles → assets/rl-header.css {% endcomment %}
