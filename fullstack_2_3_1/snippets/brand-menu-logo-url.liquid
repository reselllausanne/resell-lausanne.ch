{% comment %}
  Brand logo URL for menu / PLP chips.
  1) collection metafield custom.menu_brand_image (merchant upload — preferred)
  2) Theme assets brand-logo-{handle}.* (MIT Simple Icons + menu marks)
  3) Empty → text initials in menu-brand-image / text-only chip

  @param handle {string} collection handle
{% endcomment %}
{% liquid
  assign brand_handle = handle | strip | downcase
  assign logo_url = ''

  if brand_handle contains 'basketball-'
    assign brand_handle = brand_handle | remove: 'basketball-'
  endif

  if brand_handle contains '-performance-basketball-bags'
    assign brand_handle = brand_handle | remove: '-performance-basketball-bags'
  endif

  assign brand_col = collections[brand_handle]
  if brand_col != blank and brand_col.metafields.custom.menu_brand_image != blank
    assign menu_brand_image = brand_col.metafields.custom.menu_brand_image.value | default: brand_col.metafields.custom.menu_brand_image
    if menu_brand_image != blank
      assign logo_url = menu_brand_image | image_url: width: 180
    endif
  endif

  if logo_url == blank
    case brand_handle
      when 'nike'
        assign logo_url = 'brand-logo-nike.svg' | asset_url
      when 'adidas'
        assign logo_url = 'brand-logo-adidas.svg' | asset_url
      when 'new-balance'
        assign logo_url = 'brand-logo-new-balance.svg' | asset_url
      when 'puma'
        assign logo_url = 'brand-logo-puma.svg' | asset_url
      when 'air-jordan'
        assign logo_url = 'brand-logo-air-jordan.svg' | asset_url
      when 'asics'
        assign logo_url = 'brand-logo-asics.png' | asset_url
      when 'yeezy'
        assign logo_url = 'brand-logo-yeezy.png' | asset_url
      when 'maison-mihara'
        assign logo_url = 'brand-logo-maison-mihara.png' | asset_url
      when 'crocs'
        assign logo_url = 'brand-logo-crocs.png' | asset_url
      when 'mizuno'
        assign logo_url = 'brand-logo-mizuno.png' | asset_url
      when 'on'
        assign logo_url = 'brand-logo-on.svg' | asset_url
      when 'salomon'
        assign logo_url = 'brand-logo-salomon.svg' | asset_url
      when 'converse'
        assign logo_url = 'brand-logo-converse.svg' | asset_url
      when 'alexander-mcqueen'
        assign logo_url = 'brand-logo-alexander-mcqueen.svg' | asset_url
      when 'hoka'
        assign logo_url = 'brand-logo-hoka.svg' | asset_url
      when 'saucony'
