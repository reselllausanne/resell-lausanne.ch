{% doc %}
  Renders lightweight product card for homepage rails.

  @param {product} product - Product object
{% enddoc %}

{% capture rs_has_real_media %}
  {% render 'rs-product-has-real-media', product: product %}
{% endcapture %}
{% if product != blank and rs_has_real_media != blank %}
  <article class="landing-product-card">
    <a class="landing-product-card__link" href="{{ product.url }}">
      <div class="landing-product-card__media">
        {% render 'product-card-promotional-pictos', product: product, stacked: true %}
        {% capture card_srcset %}
          {{ product.featured_media | image_url: width: 240 }} 240w, {{ product.featured_media | image_url: width: 360 }} 360w, {{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 700 }} 700w
        {% endcapture %}
        {% assign rl_card_img_src = product.featured_media | image_url: width: 700 %}
        {% render 'rl-deferred-img',
          lazy_src: rl_card_img_src,
          lazy_srcset: card_srcset,
          sizes: '(min-width: 1000px) 20vw, (min-width: 750px) 30vw, 52vw',
          alt: product.title,
          width: 500,
          height: 625
        %}
      </div>
      <div class="landing-product-card__content">
        <h3 class="landing-product-card__title">{{ product.title }}</h3>
        <div class="landing-product-card__price">
          {% render 'price', from_product: product, sales_badge: 'none' %}
        </div>
      </div>
    </a>
  </article>
{% endif %}

{% stylesheet %}
  .landing-product-card__media {
    position: relative;
  }
{% endstylesheet %}
