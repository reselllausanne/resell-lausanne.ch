{% liquid
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign dock_thumb = selected_variant.featured_media.preview_image | default: product.featured_image
  assign product_info_width = section.settings.product_info_width
  assign product_gap = section.settings.gap
  if request.page_type == 'product'
    assign product_info_width = 44
    assign product_gap = 188
  endif
%}

{% if product != blank %}
  <div
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id }}"
    {% endif %}
    class="
      product-section color-{{ section.settings.color_scheme }}
      {% if request.page_type == 'product' %} product-section--pdp{% endif %}
      {% if section.settings.carrousel_full_width %} product-section--carrousel-image-full-width{% endif %}
    "
    style="
      --margin-top: {{ section.settings.margin_top }}px;
      --margin-bottom: {{ section.settings.margin_bottom }}px;
      --image-position: {{ section.settings.image_position }};
      --product-info-width: {{ product_info_width }}%;
      --gap: {{ product_gap }}px;
    "
  >
    <div
      class="product-section__content {% unless request.page_type == 'product' %}page-width{% endunless %}"
      style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
      data-ref="product-section-content"
    >
      <div class="product-section__medias {% if section.settings.carrousel_sticky %}product-section__medias--sticky{% endif %}">
        <div class="product-section__medias-container">
          {{ media_gallery }}
        </div>
      </div>

      <div
        class="
          product-section__product-info
          {% if section.settings.product_info_sticky %}product-section__product-info--sticky{% endif %}
          {% if section.settings.show_product_info_card %}card color-{{ section.settings.color_scheme_product_info }}{% endif %}
        "
        data-ref="product-section-product-info"
      >
        {% if request.page_type == 'product' %}
          {% render 'product-breadcrumb', product: product %}
        {% endif %}
        {{ blocks }}
        {% if request.page_type == 'product' %}
          {% liquid
            assign has_size_modal = false
            assign is_direct_atc_pdp = false
            assign size_modal_dom_id = 'size-selection-modal-' | append: section.id
            assign size_option_index = -1
            assign numeric_option_index = -1
            assign numeric_option_matches = 0
            assign largest_option_values_count = 0
            assign pdp_size_values_count = 0
            if product.has_only_default_variant == false
              for opt_with_vals in product.options_with_values
                assign option_values_count = opt_with_vals.values | size
                if option_values_count > largest_option_values_count
                  assign largest_option_values_count = option_values_count
                endif

                assign option_has_numeric_value = false
                for option_value in opt_with_vals.values
                  assign option_value_token = option_value | append: '' | strip
                  assign option_value_token_clean = option_value_token | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ' ' | remove: '.' | remove: ',' | remove: '/' | remove: '-'
                  if option_value_token != blank and option_value_token_clean == blank
                    assign option_has_numeric_value = true
                    break
                  endif
                endfor

                if option_has_numeric_value
                  assign numeric_option_matches = numeric_option_matches | plus: 1
                  assign numeric_option_index = forloop.index0
                endif
              endfor

              if product.options_with_values.size == 1
                assign size_option_index = 0
              elsif numeric_option_matches == 1
                assign size_option_index = numeric_option_index
              elsif largest_option_values_count > 1
                for opt_with_vals in product.options_with_values
                  if opt_with_vals.values.size == largest_option_values_count
                    assign size_option_index = forloop.index0
                    break
                  endif
                endfor
              endif

              if size_option_index >= 0
                assign has_size_modal = true
                for opt_with_vals in product.options_with_values
                  if forloop.index0 == size_option_index
                    assign pdp_size_values_count = opt_with_vals.values | size
                    break
                  endif
                endfor
              endif

              if pdp_size_values_count == 1
                capture rs_express_pricing_flag
                  render 'rs-product-has-express-pricing', product: product
                endcapture
                assign rs_express_pricing_flag = rs_express_pricing_flag | strip
                unless rs_express_pricing_flag == 'true'
                  assign is_direct_atc_pdp = true
                endunless
              endif
            endif
          %}
          {% if has_size_modal %}
            {% render 'product-size-selection-modal', product: product, section_id: section.id %}
            {% assign product_size_guide_id = 'product-size-guide-' | append: section.id %}
            {% render 'product-size-modal', product: product, modal_id: product_size_guide_id, load_assets: true %}
          {% endif %}
          {% capture dock_price_snapshot %}
            {% render 'rs-product-price-snapshot', product: product %}
          {% endcapture %}
          {% assign dock_price_parts = dock_price_snapshot | strip | split: '|' %}
          <aside
            class="product-mobile-dock"
            data-rs-mobile-dock
            data-rs-mobile-dock-modal-id="{{ size_modal_dom_id }}"
          >
            <div class="product-mobile-dock__thumb-wrap" aria-hidden="true">
              {% if dock_thumb != blank %}
                {{
                  dock_thumb
                  | image_url: width: 200
                  | image_tag: class: 'product-mobile-dock__thumb', loading: 'lazy', sizes: '80px'
                }}
              {% endif %}
            </div>
            <div class="product-mobile-dock__meta">
              <p class="product-mobile-dock__title" data-rs-mobile-dock-title>{{ product.title }}</p>
              {% if dock_price_parts[8] == '1' %}
                <p class="product-mobile-dock__price" data-rs-mobile-dock-price>
                  {% if dock_price_parts[5] == '1' %}{{ 'search.starting_from' | t }} {% endif %}{{ dock_price_parts[2] | plus: 0 | money }}
                </p>
              {% endif %}
              <p class="product-mobile-dock__size" data-rs-mobile-dock-size>
                {% if is_direct_atc_pdp and size_option_index >= 0 %}
                  {% render 'rs-pdp-single-size',
                    product: product,
                    size_option_index: size_option_index,
                    element: 'span',
                    class: 'product-mobile-dock__single-size'
                  %}
                {% elsif selected_variant != blank %}
                  {{ selected_variant.title }}
                {% endif %}
              </p>
            </div>
          {% if has_size_modal %}
            {% if is_direct_atc_pdp %}
              <button
                type="button"
                class="button button--primary product-mobile-dock__primary"
                data-rs-direct-atc
                data-rs-size-modal-target="{{ size_modal_dom_id }}"
              >
                Ajouter au panier
              </button>
            {% else %}
              <button
                type="button"
                class="button button--primary product-mobile-dock__primary"
                data-rs-mobile-dock-primary
                data-rs-size-modal-open="{{ size_modal_dom_id }}"
              >
                Sélectionnez votre taille
              </button>
            {% endif %}
          {% endif %}
        </aside>

        {% if has_size_modal %}
          <aside
            class="product-desktop-dock"
            data-rs-desktop-dock
            data-rs-mobile-dock-modal-id="{{ size_modal_dom_id }}"
            aria-hidden="true"
            inert
          >
            <div class="product-desktop-dock__thumb-wrap" aria-hidden="true">
              {% if dock_thumb != blank %}
                {{
                  dock_thumb
                  | image_url: width: 200
                  | image_tag: class: 'product-desktop-dock__thumb', loading: 'lazy', sizes: '80px'
                }}
              {% endif %}
            </div>
            <div class="product-desktop-dock__meta">
              <p class="product-desktop-dock__title" data-rs-mobile-dock-title>{{ product.title }}</p>
              {% if dock_price_parts[8] == '1' %}
                <p class="product-desktop-dock__price" data-rs-mobile-dock-price>
                  {% if dock_price_parts[5] == '1' %}{{ 'search.starting_from' | t }} {% endif %}{{ dock_price_parts[2] | plus: 0 | money }}
                </p>
              {% endif %}
            </div>
            {% if is_direct_atc_pdp %}
              <button
                type="button"
                class="product-desktop-dock__primary"
                data-rs-direct-atc
                data-rs-size-modal-target="{{ size_modal_dom_id }}"
              >
                Ajouter au panier
              </button>
            {% else %}
              <button
                type="button"
                class="product-desktop-dock__primary"
                data-rs-mobile-dock-primary
                data-rs-size-modal-open="{{ size_modal_dom_id }}"
              >
                Sélectionner votre taille
              </button>
            {% endif %}
          </aside>
        {% endif %}
      {% endif %}
      </div>
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="design-mode-message-container page-width color-{{ section.settings.color_scheme }}">
    <p class="design-mode-message">{{ 'products.no_product' | t }}</p>
  </div>
{% endif %}

{% stylesheet %}
  @media (width > 750px) {
    .shopify-section-product-section {
      overflow: visible;
    }
  }

  .pdp-sticky-bar {
    display: none;
  }

  .product-section {
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
  }

  .product-section--pdp {
    margin-bottom: 0;
  }

  .product-section--pdp {
    /* max-width matches 1940px max-width cap */
    --pdp-max-width:    1940px;
    --pdp-main-padding-top: 30px;

    /* ── 12-column grid — standard breakpoints ── */
    /* mobile <768px  : 16px gutter, 8px gap, 6 cols  */
    /* 768–1023px     : 32px gutter, 16px gap, 12 cols */
    /* 1024px+        : 112px gutter, 16px gap, 12 cols */
    --pdp-gutter:       16px;
    --pdp-col-gap:      8px;
    --pdp-cols:         6;
    --pdp-gallery-cols: 6;
    --pdp-info-cols:    6;
    --pdp-section-gap:  88px;
    --pdp-info-top-offset: 0px;
    --pdp-main-padding-x: var(--pdp-gutter);
    --pdp-column-gap:     var(--pdp-col-gap);
    --pdp-thumbnail-gap:  16px;
  }

  @media (width >= 768px) {
    .product-section--pdp {
      --pdp-gutter:       0px;
      --pdp-col-gap:      16px;
      --pdp-cols:         12;
      --pdp-gallery-cols: 7;
      --pdp-info-cols:    5;
    }
  }

  .product-section__content {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: var(--gap-md);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  /* PDP: zero inner padding (uses outer margin-bottom, not inner padding) */
  .product-section--pdp .product-section__content {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    padding-inline: var(--pdp-gutter);
  }

  .product-section__product-info {
    display: flex;
    flex-direction: column;
    gap: var(--padding-sm);
  }

  .commerce-breadcrumbs {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 14px;
    color: rgb(0 0 0 / 65%);
  }

  .product-section__product-info .accordions {
    margin-top: 8px;
    border-top: 1px solid rgb(216 216 216);
  }

  .product-section__product-info .accordions .accordion-block .accordion {
    border-top: 0;
    border-bottom: 1px solid rgb(216 216 216);
  }

  .product-section__product-info .accordions .accordion-block:last-child .accordion {
    border-bottom: 1px solid rgb(216 216 216);
  }

  .product-section__product-info .accordion__header {
    min-height: 56px;
    padding: 0;
  }

  .product-section__product-info .accordion__heading-title {
    margin: 0;
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    font-weight: 400;
    color: rgb(17 17 17);
  }

  .product-section__product-info .accordion__icons-add .icon {
    font-size: 27px !important;
    font-weight: 300;
  }

  .product-section__product-info .accordion__content {
    padding: 0;
    color: rgb(96 96 96);
    font-size: 13px;
    line-height: 1.55;
  }

  .product-section__product-info .accordion__content p:first-child {
    margin-top: 2px;
  }

  .product-section__product-info .accordion__preview {
    margin: 4px 58px 16px 0;
    color: rgb(152 152 152);
    font-size: 42px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    -webkit-mask-image: linear-gradient(180deg, rgb(0 0 0 / 92%) 58%, transparent 100%);
    mask-image: linear-gradient(180deg, rgb(0 0 0 / 92%) 58%, transparent 100%);
  }

  .pdp-sticky-bar {
    display: none;
  }

  .product-mobile-dock,
  .product-desktop-dock {
    display: none;
  }

  .product-section--pdp .product-section__product-info .rs-size-modal__trigger {
    border-color: rgb(8 8 8);
    background: rgb(8 8 8);
    color: rgb(255 255 255);
  }

  .product-section--pdp .product-section__product-info .rs-size-modal__trigger:hover,
  .product-section--pdp .product-section__product-info .rs-size-modal__trigger:focus-visible {
    border-color: rgb(8 8 8);
    background: rgb(8 8 8);
    color: rgb(255 255 255);
  }

  @media (width <= 750px) {
    .product-mobile-dock:not(.is-visible) {
      display: none !important;
    }

    .product-mobile-dock.is-visible {
      align-items: center;
      gap: 0;
      width: auto;
      max-width: none;
      padding: 8px 10px;
      opacity: 1;
      transform: none;
      transition: opacity 0.2s ease;
    }

    .product-mobile-dock.is-visible .product-mobile-dock__thumb-wrap,
    .product-mobile-dock.is-visible .product-mobile-dock__meta {
      display: none !important;
    }

    .product-mobile-dock.is-visible .product-mobile-dock__primary {
      width: 100%;
      min-height: 44px;
      padding-inline: 14px;
      border-radius: 4px;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.15;
    }
  }

  @media (width > 750px) {
    .product-section__content {
      flex-direction: var(--image-position);
      gap: var(--gap);
    }

    .product-section__medias-container {
      overflow: hidden;
      width: 100%;
      margin-right: 0;
    }

    .product-section__medias {
      width: calc(100% - var(--product-info-width));
      display: flex;
      justify-content: flex-end;
    }

    .product-section__product-info {
      max-width: calc(var(--product-info-width) - var(--gap));
      width: 100%;
      padding-top: 56px;
    }

    .product-section__product-info .commerce-breadcrumbs {
      margin-bottom: 0;
    }

    .product-section__product-info .accordions {
      margin-top: 8px;
    }

    .product-section__product-info h1,
    .product-section__product-info .text-block.h3,
    .product-section__product-info .text-block.h3 p {
      font-size: 32px;
      line-height: 40px;
      font-weight: 400;
      letter-spacing: -0.02em;
      margin: 0 0 12px;
    }

    .product-section__product-info .product-price-container,
    .product-section__product-info .price-container {
      margin-bottom: 16px;
    }

    .product-section__product-info .rs-size-modal__trigger {
      width: min(257px, 100%);
      border-radius: 2px;
      border-color: rgb(8 8 8);
      background: rgb(8 8 8);
      color: rgb(255 255 255);
      padding: 0 28px;
      min-height: 44px;
      font-size: 13px;
      font-weight: 500;
      line-height: 1;
    }

    .product-section__product-info .rs-size-modal__fit-note-box {
      max-width: 364px;
      margin-top: 16px;
    }

    .product-section__product-info .product-add-to-cart-button,
    .product-section__product-info [data-ref='add-to-cart-button-container'],
    .product-section__product-info sticky-add-to-cart {
      display: none !important;
    }

    .product-section__product-info .rs-size-modal__trigger:hover {
      background: rgb(8 8 8);
      color: rgb(255 255 255);
    }

    .product-section--pdp .product-section__product-info .rs-size-modal__trigger {
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 256px;
      max-width: 100%;
      min-height: 44px;
      height: 44px;
      padding: 0 24px;
      border-radius: 4px;
      font-size: 13px;
      font-weight: 500;
      line-height: 15px;
    }

    .product-section--pdp .product-section__product-info h1,
    .product-section--pdp .product-section__product-info .text-block.h3,
    .product-section--pdp .product-section__product-info .text-block.h3 p {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -0.02em;
      font-weight: 400;
      margin: 0 0 10px;
    }

    .product-section--pdp .product-section__product-info .price-container .prices {
      gap: 4px;
    }

    .product-section--pdp .product-section__product-info .price-container .price-from {
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      letter-spacing: normal;
      color: #4d4d4d;
      opacity: 1;
    }

    .product-section--pdp .product-section__product-info .price-container .price {
      color: #4956ed;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: normal;
      line-height: 17px;
    }

    .product-section--pdp .product-section__product-info .price-container .compare-at-price {
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      letter-spacing: normal;
      color: #4d4d4d;
      opacity: 1;
    }

    .product-mobile-dock,
    .product-mobile-dock.is-visible {
      display: none !important;
    }

    /* ── Desktop floating sticky card (WTN-style) ── */
    .product-desktop-dock {
      position: fixed;
      right: clamp(16px, 7.78vw, 112px);
      bottom: 24px;
      z-index: 90;
      display: flex !important;
      align-items: center;
      gap: 10px;
      width: 327px;
      max-width: calc(100vw - 32px);
      height: 58px;
      padding: 6px;
      box-sizing: border-box;
      border: 1px solid rgb(8 8 8 / 9%);
      border-radius: 4px;
      background: rgb(255 255 255);
      box-shadow: 0 10px 24px rgb(0 0 0 / 10%);
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .product-desktop-dock.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .product-desktop-dock__thumb-wrap {
      width: 80px;
      height: 46px;
      flex-shrink: 0;
      border-radius: 2px;
      overflow: hidden;
      background: rgb(245 245 245);
    }

    .product-desktop-dock__thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .product-desktop-dock__meta {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      max-width: 120px;
    }

    .product-desktop-dock__title,
    .product-desktop-dock__price {
      margin: 0;
    }

    .product-desktop-dock__title {
      font-size: 13px;
      line-height: 17px;
      font-weight: 400;
      color: rgb(8 8 8);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .product-desktop-dock__price {
      font-size: 11px;
      line-height: 18px;
      font-weight: 400;
      color: rgb(0 0 0 / 60%);
      white-space: nowrap;
    }

    .product-desktop-dock__primary {
      appearance: none;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 115px;
      height: 46px;
      padding: 0 10px;
      border: 0;
      border-radius: 4px;
      background: rgb(8 8 8);
      color: rgb(255 255 255);
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      line-height: 1.15;
      text-align: center;
      cursor: pointer;
      transition: background 180ms ease;
    }

    .product-desktop-dock__primary:hover {
      background: rgb(40 40 40);
    }

    .product-section__medias--sticky,
    .product-section__product-info--sticky {
      height: fit-content;
      position: sticky;
      top: calc(var(--header-height, 0px) + var(--padding-md));
      z-index: 2;
    }
  }

  @media (width >= 768px) {
    /* 14-track grid:
       [gutter] [12 content cols] [gutter]
       Gallery snaps to columns 1/8 (cols 1-7), info snaps to cols 9/13 (cols 8-12) */
    .product-section--pdp .product-section__content {
      max-width: var(--pdp-max-width);
      width: 100%;
      margin-inline: auto;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-inline: 0 !important;
      display: grid;
      grid-template-columns:
        clamp(0px, 7.78vw, 112px)
        repeat(12, 1fr)
        clamp(0px, 7.78vw, 112px);
      column-gap: 16px;
      row-gap: 0;
      align-items: start;
    }

    /* Gallery: fixed to line 8, info starts line 9 */
    .product-section--pdp .product-section__medias {
      grid-column: 2 / 8;
      width: auto !important;
      min-width: 0;
      display: block !important;
    }

    .product-section--pdp .product-section__medias-container {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .product-section--pdp .product-section__medias--sticky,
    .product-section--pdp .product-section__product-info--sticky {
      position: static;
      top: auto;
      z-index: auto;
      height: auto;
    }

    /* Info: track 9 to 14 (cols 8-12 of the 12) — scrolls with gallery like a premium reference */
    .product-section--pdp .product-section__product-info {
      grid-column: 9 / 14;
      width: auto !important;
      min-width: 0;
      max-width: none !important;
      padding-top: 32px;
      padding-inline-end: 0;
      margin-top: 0;
      align-self: start;
    }

    .product-section--pdp .product-section__product-info .commerce-breadcrumbs {
      margin-bottom: 62px;
    }

    .product-section--pdp .product-section__product-info .product-price-container,
    .product-section--pdp .product-section__product-info .price-container {
      margin-bottom: 14px;
      font-size: 13px;
      line-height: 17px;
    }

    .product-section--pdp .product-section__product-info .accordions {
      margin-top: 24px;
    }
  }

  @media (width >= 1024px) {
    .product-section--pdp .product-section__medias {
      margin-left: -44px;
      margin-top: 33px;
    }
  }

  @media (width <= 750px) {
    .product-section--pdp .product-section__product-info .rs-size-modal__trigger-wrap {
      width: 100%;
    }

    .product-section--pdp .product-section__product-info .rs-size-modal__trigger {
      width: 100%;
      max-width: 100%;
    }

    .product-section--pdp .product-section__product-info .rs-size-modal__fit-note-box {
      width: 100%;
      max-width: 100%;
      margin-top: 10px;
      padding: 10px 14px;
      border-radius: 0;
    }

    .product-section--pdp .product-section__product-info .rs-size-modal__fit-note-inline {
      font-size: 12px;
      line-height: 1.35;
    }

    .product-section--pdp .product-section__product-info .price-container .price {
      color: #4956ed;
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      letter-spacing: normal;
    }

    .product-section--pdp .product-section__product-info .price-container .prices {
      gap: 4px;
    }

    .product-section--pdp .product-section__product-info .price-container .price-from {
      color: #4d4d4d;
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      opacity: 1;
    }

    .product-section--pdp .product-section__product-info .price-container .compare-at-price {
      font-size: 13px;
      font-weight: 400;
      line-height: 17px;
      color: #4d4d4d;
      opacity: 1;
    }

    .product-section__product-info .accordion__preview {
      font-size: 15px;
      line-height: 1.35;
      margin-right: 46px;
      -webkit-mask-image: linear-gradient(180deg, rgb(0 0 0 / 96%) 70%, transparent 100%);
      mask-image: linear-gradient(180deg, rgb(0 0 0 / 96%) 70%, transparent 100%);
    }

    .product-section--carrousel-image-full-width {
      .product-section__content {
        padding-top: 0 !important;
      }

      .product-media-gallery-main-slider {
        width: calc(100% + 2 * (var(--page-margin-mobile)));
        margin-left: calc(var(--page-margin-mobile) * -1);
      }

      .product-media-gallery__media--rounded {
        border-radius: 0;
      }
    }

    .product-section {
      padding-bottom: 0;
    }

    .product-section--pdp:has([data-rs-mobile-dock]) sticky-add-to-cart {
      display: none !important;
    }
  }

  /* PDP: remove rounded corners, allow sub-image bleed to be visible */
  .product-section--pdp .product-media-gallery-stockx--rounded,
  .product-section--pdp .product-media-gallery-stockx--rounded .product-media-gallery-stockx__image,
  .product-section--pdp .product-media-gallery-stockx--rounded .product-media-gallery-stockx__subcard {
    border-radius: 0;
  }

  .product-section--pdp .product-media-gallery-stockx--rounded {
    overflow: visible;
  }

  /* PDP: vertical breathing room only – no horizontal padding, shoe fills full width */
  @media (width > 750px) {
    .product-section--pdp .product-media-gallery-stockx__image {
      padding: 30px 0;
    }

    /* Sub-images: stay within gallery column, no bleed */
    .product-section--pdp .product-media-gallery-stockx__subgrid {
      width: 100%;
      margin-left: 0;
    }

    .product-section--pdp .product-media-gallery-stockx__subimage {
      padding: 10px 0;
    }
  }

  @media (width <= 750px) {
    .product-section--pdp .product-media-gallery-stockx__image {
      padding: 4px 0;
    }

    .product-section--pdp .product-media-gallery-stockx__subimage {
      padding: 4px 0;
    }

    .product-section--pdp .product-section__product-info {
      gap: 6px;
      padding-top: 4px;
    }

    .product-section--pdp .product-section__product-info h1 {
      font-size: 20px;
      line-height: 1.2;
      margin: 4px 0 2px;
    }

    .product-section--pdp .product-section__product-info .product-price-container,
    .product-section--pdp .product-section__product-info .price-container {
      margin-bottom: 4px;
    }

    .product-section--pdp .product-section__product-info .commerce-breadcrumbs {
      font-size: 12px;
      line-height: 1.2;
    }
  }
{% endstylesheet %}
