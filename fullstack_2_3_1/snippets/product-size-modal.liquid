{% liquid
  assign size_modal_id = modal_id | default: 'product-size-modal'
  assign size_guide_metafield = product.metafields.custom.size_guide
  assign use_dynamic_content = false

  capture size_guide_content
    if size_guide_metafield != blank
      echo size_guide_metafield | metafield_tag
    endif
  endcapture

  assign size_guide_content = size_guide_content | strip
  if size_guide_content == blank and size_guide_metafield != blank and size_guide_metafield.value != blank
    assign size_guide_content = size_guide_metafield.value | newline_to_br
  endif

  if size_guide_content contains '<table' or size_guide_content contains '<ul' or size_guide_content contains '<ol'
    assign use_dynamic_content = true
  endif

  unless use_dynamic_content
    assign eu_sizes = '35.5|36|36.5|37.5|38|38.5|39|40|40.5|41|42|42.5|43|44|44.5|45|45.5|46|47|47.5|48|48.5|49.5' | split: '|'
    assign us_men_sizes = '3.5|4|4.5|5|5.5|6|6.5|7|7.5|8|8.5|9|9.5|10|10.5|11|11.5|12|12.5|13|14|15|16' | split: '|'
    assign uk_sizes = '3|3.5|4|4.5|5|5.5|6|6.5|7|7.5|8|8.5|9|9.5|10|10.5|11|11.5|12|12.5|13|14|15' | split: '|'
  endunless
%}

{% unless load_assets == false %}
  {{ 'product-size-modal.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-size-modal.js' | asset_url }}" defer></script>
{% endunless %}

<template id="{{ size_modal_id }}-tpl">
  <div
    id="{{ size_modal_id }}"
    class="product-size-modal"
    data-size-modal
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ size_modal_id }}-title"
  >
    <div class="product-size-modal__overlay" data-size-modal-overlay tabindex="-1"></div>

    <div class="product-size-modal__content">
      <div class="product-size-modal__background" aria-hidden="true"></div>

      <div class="product-size-modal__panel" role="document">
        <header class="product-size-modal__header">
          <h2 id="{{ size_modal_id }}-title" class="product-size-modal__title">Guide des tailles</h2>
        </header>

        <div class="product-size-modal__body">
          {% if use_dynamic_content %}
            <div class="product-size-modal__dynamic-content rte">
              {{ size_guide_content }}
            </div>
          {% else %}
            <div class="product-size-modal__table" role="table" aria-label="Guide des tailles">
              <div class="product-size-modal__table-head" role="row">
                <span class="product-size-modal__th" role="columnheader">EU</span>
                <span class="product-size-modal__th" role="columnheader">US Men</span>
                <span class="product-size-modal__th" role="columnheader">UK</span>
              </div>
              <div class="product-size-modal__table-body" role="rowgroup">
                {% for eu_size in eu_sizes %}
                  {% assign row_index = forloop.index0 %}
                  <div class="product-size-modal__table-row" role="row">
                    <span class="product-size-modal__td" role="cell">{{ eu_size }}</span>
                    <span class="product-size-modal__td" role="cell">{{ us_men_sizes[row_index] }}</span>
                    <span class="product-size-modal__td" role="cell">{{ uk_sizes[row_index] }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <button type="button" class="product-size-modal__close-fab" data-size-modal-close aria-label="Fermer le guide des tailles">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</template>
