{%- comment -%}
  Render AFTER content_for_header so Resell icons override Shopify theme-settings favicon.
{%- endcomment -%}
<link rel="icon" type="image/png" sizes="192x192" href="{{ 'icon-192.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="512x512" href="{{ 'icon-512.png' | asset_url }}">
<link rel="icon" type="image/x-icon" href="{{ 'rl-favicon.ico' | asset_url }}">
<link rel="shortcut icon" href="{{ 'rl-favicon.ico' | asset_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
<link rel="manifest" href="{{ 'manifest.webmanifest.liquid' | asset_url }}">
