{% doc %}
  Renders demo nested panels for header drawer.

  @param {string} menu_title - Root menu title.
  @param {string} view_all_label - Root CTA label.
  @param {string} view_all_url - Root CTA URL.
  @param {boolean} uppercase - Whether labels are uppercase.
  @param {number} font_weight - Label font weight.
  @param {boolean} [show_top_image] - Show submenu hero placeholders.
  @param {string} [branch] - Panel branch: root, selections, sneakers, streetwear, active, chaussures, collectibles, misc
  @param {string} [root_hero_filename] - Shopify Files name for root panel hero (default top-menu-picture.jpg).
{% enddoc %}

{% liquid
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first

  assign label_sales = 'Soldes'
  assign label_selections = 'Nos sélections'
  assign label_sneakers = 'Sneakers'
  assign label_streetwear = 'Streetwear'
  assign label_active = 'Active'
  assign label_shoes = 'Chaussures'
  assign label_collectibles = 'Collectibles'
  assign label_express_delivery = 'Livraison express'
  assign label_nouveautes = 'Les Nouveautés'
  assign label_categories = 'Catégories'
  assign label_collabs = 'Les Meilleures Collaborations'
  assign label_slides_sandals = 'Slides & Sandales'
  assign label_cat_casual = 'Casual / Lifestyle'
  assign label_cat_retro_sn = 'Retro Sneakers'
  assign label_cat_retro_bk = 'Basket Retro'
  assign label_cat_perf_bk = 'Performance Basketball'
  assign label_cat_skate = 'Skate sneakers'
  assign label_cat_foot = 'Crampon de Football'
  assign label_autres_marques = 'Autres marques'
  assign label_view_all = 'Tout voir'
  assign label_wellness = 'Wellness'
  assign label_accessories = 'Accessoires'
  assign label_discover = 'Découvrir'
  assign label_ensembles = 'Les Ensembles'
  assign label_marques = 'Les Marques'
  assign label_tshirts = 'T-Shirts'
  assign label_sweatshirts = 'Sweatshirts'
  assign label_pants = 'Pants, Jogging & Shorts'
  assign label_vestes = 'Vestes'
  assign label_caps = 'Casquettes & Bonnets'
  assign label_skincare = 'Skincare'
  assign label_makeup = 'Make Up'
  assign label_parfums = 'Parfums'
  assign label_active_shoes = 'Active Shoes'
  assign label_active_clothing = 'Active Clothing'
  assign label_perf_bk_shoes = 'Chaussures'
  assign label_perf_bk_bags = 'Sacs'
  assign label_other_perf_bk = 'Autres'
  assign label_sneakers_men = 'Sneakers Homme'
  assign label_sneakers_women = 'Sneakers Femme'
  assign label_sneakers_kids = 'Sneakers Enfant'
  assign label_boots_slippers = 'Bottes & chaussons'
  assign label_eco_sneakers = 'Sneakers éco-responsables'
  assign label_eyewear = 'Eyewear'
  assign label_jewelry = 'Bijoux'
  assign label_care_products = "Produits d'entretien"
  assign label_independent_brands = 'Les marques indépendantes'
  assign label_other_prefix = 'Autres'

  if locale_base == 'de'
    assign label_sales = 'Sale'
    assign label_selections = 'Unsere Auswahl'
    assign label_sneakers = 'Sneakers'
    assign label_streetwear = 'Streetwear'
    assign label_active = 'Active'
    assign label_shoes = 'Schuhe'
    assign label_collectibles = 'Collectibles'
    assign label_express_delivery = 'Expresslieferung'
    assign label_nouveautes = 'Neuheiten'
    assign label_categories = 'Kategorien'
    assign label_collabs = 'Die besten Kollaborationen'
    assign label_slides_sandals = 'Slides & Sandalen'
    assign label_cat_casual = 'Casual / Lifestyle'
    assign label_cat_retro_sn = 'Retro Sneakers'
    assign label_cat_retro_bk = 'Retro Basketball'
    assign label_cat_perf_bk = 'Performance Basketball'
    assign label_cat_skate = 'Skate Sneakers'
    assign label_cat_foot = 'Fußballschuhe'
    assign label_autres_marques = 'Weitere Marken'
    assign label_view_all = 'Alle ansehen'
    assign label_wellness = 'Wellness'
    assign label_accessories = 'Accessoires'
    assign label_discover = 'Entdecken'
    assign label_ensembles = 'Sets'
    assign label_marques = 'Marken'
    assign label_tshirts = 'T-Shirts'
    assign label_sweatshirts = 'Sweatshirts'
    assign label_pants = 'Hosen, Jogging & Shorts'
    assign label_vestes = 'Jacken'
    assign label_caps = 'Caps & Mützen'
    assign label_skincare = 'Skincare'
    assign label_makeup = 'Make-up'
    assign label_parfums = 'Parfums'
    assign label_active_shoes = 'Active Schuhe'
    assign label_active_clothing = 'Active Bekleidung'
    assign label_perf_bk_shoes = 'Schuhe'
    assign label_perf_bk_bags = 'Taschen'
    assign label_other_perf_bk = 'Weitere'
    assign label_sneakers_men = 'Sneakers Herren'
    assign label_sneakers_women = 'Sneakers Damen'
    assign label_sneakers_kids = 'Sneakers Kinder'
    assign label_boots_slippers = 'Stiefel & Hausschuhe'
    assign label_eco_sneakers = 'Nachhaltige Sneakers'
    assign label_eyewear = 'Brillen'
    assign label_jewelry = 'Schmuck'
    assign label_care_products = 'Pflegeprodukte'
    assign label_independent_brands = 'Unabhängige Marken'
    assign label_other_prefix = 'Weitere'
  elsif locale_base == 'en'
    assign label_sales = 'Sale'
    assign label_selections = 'Our selection'
    assign label_sneakers = 'Sneakers'
    assign label_streetwear = 'Streetwear'
    assign label_active = 'Active'
    assign label_shoes = 'Shoes'
    assign label_collectibles = 'Collectibles'
    assign label_express_delivery = 'Express delivery'
    assign label_nouveautes = 'New arrivals'
    assign label_categories = 'Categories'
    assign label_collabs = 'Best collaborations'
    assign label_slides_sandals = 'Slides & sandals'
    assign label_cat_casual = 'Casual / Lifestyle'
    assign label_cat_retro_sn = 'Retro sneakers'
    assign label_cat_retro_bk = 'Retro basketball'
    assign label_cat_perf_bk = 'Performance basketball'
    assign label_cat_skate = 'Skate sneakers'
    assign label_cat_foot = 'Football boots'
    assign label_autres_marques = 'Other brands'
    assign label_view_all = 'View all'
    assign label_wellness = 'Wellness'
    assign label_accessories = 'Accessories'
    assign label_discover = 'Discover'
    assign label_ensembles = 'Sets'
    assign label_marques = 'Brands'
    assign label_tshirts = 'T-shirts'
    assign label_sweatshirts = 'Sweatshirts'
    assign label_pants = 'Pants, joggers & shorts'
    assign label_vestes = 'Jackets'
    assign label_caps = 'Caps & beanies'
    assign label_skincare = 'Skincare'
    assign label_makeup = 'Make-up'
    assign label_parfums = 'Fragrances'
    assign label_active_shoes = 'Active shoes'
    assign label_active_clothing = 'Active clothing'
    assign label_perf_bk_shoes = 'Shoes'
    assign label_perf_bk_bags = 'Bags'
    assign label_other_perf_bk = 'Other'
    assign label_sneakers_men = "Men's sneakers"
    assign label_sneakers_women = "Women's sneakers"
    assign label_sneakers_kids = "Kids' sneakers"
    assign label_boots_slippers = 'Boots & slippers'
    assign label_eco_sneakers = 'Eco-friendly sneakers'
    assign label_eyewear = 'Eyewear'
    assign label_jewelry = 'Jewellery'
    assign label_care_products = 'Care products'
    assign label_independent_brands = 'Independent brands'
    assign label_other_prefix = 'Other'
  endif

  assign label_other_jordan = label_other_prefix | append: ' Air Jordan'
  assign label_other_nike = label_other_prefix | append: ' Nike'
  assign label_other_asics = label_other_prefix | append: ' Asics'
  assign label_other_yeezy = label_other_prefix | append: ' Yeezy'
  assign label_other_adida = label_other_prefix | append: ' Adidas'
  assign label_other_nb = label_other_prefix | append: ' New Balance'
  assign label_other_saucony = label_other_prefix | append: ' Saucony'
  assign label_other_puma = label_other_prefix | append: ' Puma'
  assign label_other_salomon = label_other_prefix | append: ' Salomon'

  assign drawer_menu_title = menu_title | default: 'Nos Produits'
  assign drawer_view_all = view_all_label | default: label_view_all
  if locale_base == 'de'
    assign drawer_menu_title = 'Unsere Produkte'
    assign drawer_view_all = 'Alle ansehen'
  elsif locale_base == 'en'
    assign drawer_menu_title = 'Our products'
    assign drawer_view_all = 'View all'
  endif

  assign rl_menu_col_vetements = collections['vetements']
  if rl_menu_col_vetements != blank
    assign rl_menu_url_vetements = rl_menu_col_vetements.url
  else
    assign rl_menu_url_vetements = '/collections/vetements'
  endif

  assign rl_menu_sales_handle = 'soldes-48h'
  if collections[rl_menu_sales_handle] == blank
    assign rl_menu_sales_handle = 'soldes'
  endif

  assign rl_menu_col_sales = collections[rl_menu_sales_handle]
  if rl_menu_col_sales != blank
    assign rl_menu_url_sales = rl_menu_col_sales.url
  else
    assign rl_menu_url_sales = routes.root_url | append: 'collections/soldes-48h'
  endif

  assign rl_menu_col_nouveautes = collections['nouveautes']
  if rl_menu_col_nouveautes != blank
    assign rl_menu_url_nouveautes = rl_menu_col_nouveautes.url
  else
    assign rl_menu_url_nouveautes = '/collections/nouveautes'
  endif

  assign rl_menu_col_collabs = collections['les-meilleures-collaborations']
  if rl_menu_col_collabs != blank
    assign rl_menu_url_collabs = rl_menu_col_collabs.url
  else
    assign rl_menu_url_collabs = '/collections/les-meilleures-collaborations'
  endif

  assign rl_menu_col_cat_casual = collections['court-tenis-retro']
  assign rl_menu_col_cat_retro_sn = collections['retro-sneakers']
  assign rl_menu_col_cat_retro_bk = collections['retro-basket']
  assign rl_menu_col_cat_perf_bk = collections['performance-basket']
  assign rl_menu_col_cat_skate = collections['skateboard']
  assign rl_menu_col_cat_slides = collections['slide-mules']
  assign rl_menu_col_cat_foot = collections['crampons-de-foot']
  if rl_menu_col_cat_casual != blank
    assign rl_menu_url_cat_casual = rl_menu_col_cat_casual.url
  else
    assign rl_menu_url_cat_casual = '/collections/court-tenis-retro'
  endif
  if rl_menu_col_cat_retro_sn != blank
    assign rl_menu_url_cat_retro_sn = rl_menu_col_cat_retro_sn.url
  else
    assign rl_menu_url_cat_retro_sn = '/collections/retro-sneakers'
  endif
  if rl_menu_col_cat_retro_bk != blank
    assign rl_menu_url_cat_retro_bk = rl_menu_col_cat_retro_bk.url
  else
    assign rl_menu_url_cat_retro_bk = '/collections/retro-basket'
  endif
  if rl_menu_col_cat_perf_bk != blank
    assign rl_menu_url_cat_perf_bk = rl_menu_col_cat_perf_bk.url
  else
    assign rl_menu_url_cat_perf_bk = '/collections/performance-basket'
  endif
  if rl_menu_col_cat_skate != blank
    assign rl_menu_url_cat_skate = rl_menu_col_cat_skate.url
  else
    assign rl_menu_url_cat_skate = '/collections/skateboard'
  endif
  if rl_menu_col_cat_slides != blank
    assign rl_menu_url_cat_slides = rl_menu_col_cat_slides.url
  else
    assign rl_menu_url_cat_slides = '/collections/slide-mules'
  endif
  if rl_menu_col_cat_foot != blank
    assign rl_menu_url_cat_foot = rl_menu_col_cat_foot.url
  else
    assign rl_menu_url_cat_foot = '/collections/crampons-de-foot'
  endif

  assign rl_menu_col_express_delivery = collections['express-delivery']
  if rl_menu_col_express_delivery != blank
    assign rl_menu_url_express_delivery = rl_menu_col_express_delivery.url
  else
    assign rl_menu_url_express_delivery = '/collections/express-delivery'
  endif

  capture autres_marques_url
    render 'rl-autres-marques-url'
  endcapture
  assign autres_marques_url = autres_marques_url | strip

  assign _menu_branch = branch | default: 'all'
  assign _show_root = false
  assign _show_selections = false
  assign _show_sneakers = false
  assign _show_streetwear = false
  assign _show_active = false
  assign _show_chaussures = false
  assign _show_collectibles = false
  assign _show_misc = false

  if _menu_branch == 'all'
    assign _show_root = true
    assign _show_selections = true
    assign _show_sneakers = true
    assign _show_streetwear = true
    assign _show_active = true
    assign _show_chaussures = true
    assign _show_collectibles = true
    assign _show_misc = true
  elsif _menu_branch == 'root'
    assign _show_root = true
  elsif _menu_branch == 'selections'
    assign _show_selections = true
  elsif _menu_branch == 'sneakers'
    assign _show_sneakers = true
  elsif _menu_branch == 'streetwear'
    assign _show_streetwear = true
  elsif _menu_branch == 'active'
    assign _show_active = true
  elsif _menu_branch == 'chaussures'
    assign _show_chaussures = true
  elsif _menu_branch == 'collectibles'
    assign _show_collectibles = true
  elsif _menu_branch == 'misc'
    assign _show_misc = true
  endif
%}

{% if _show_root %}
<section class="header__mobile-menu-panel is-active" data-panel-id="root" data-panel-depth="0" aria-hidden="false">
  {% render 'drawer-menu-panel-hero', show_hero: show_top_image, hero_filename: root_hero_filename, title: drawer_menu_title %}
  <div class="header__mobile-menu-panel-header">
    <p class="header__mobile-menu-panel-title">{{ drawer_menu_title }}</p>
    <a class="header__mobile-menu-panel-link" href="{{ view_all_url | default: '/collections/toutes-nos-paires' }}">{{ drawer_view_all }}</a>
  </div>

  <nav class="header__mobile-menu-nav{% if uppercase %} header__mobile-menu-nav--uppercase{% endif %}" style="--font-weight: {{ font_weight }};">
    <a href="{{ rl_menu_url_sales }}" class="header__mobile-menu-link">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: rl_menu_sales_handle, alt: label_sales, wrap_modifier: 'is-badge-image' %}
        <span class="header__mobile-menu-link-text">{{ label_sales }}</span>
      </span>
    </a>

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-selections">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'nouveautes', alt: label_selections, wrap_modifier: 'is-badge-image' %}
        <span class="header__mobile-menu-link-text">{{ label_selections }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron">
        <path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path>
      </svg>
    </button>

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-sneakers">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'toutes-nos-paires', alt: label_sneakers, wrap_modifier: 'is-menu-thumb' %}
        <span class="header__mobile-menu-link-text">{{ label_sneakers }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron">
        <path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path>
      </svg>
    </button>

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-streetwear">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'vetements', alt: label_streetwear, wrap_modifier: 'is-menu-thumb' %}
        <span class="header__mobile-menu-link-text">{{ label_streetwear }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron">
        <path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path>
      </svg>
    </button>

    {% comment %} Wellness hidden — no collections yet {% endcomment %}

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-active">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'running', alt: label_active, wrap_modifier: 'is-menu-thumb' %}
        <span class="header__mobile-menu-link-text">{{ label_active }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path></svg>
    </button>

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-chaussures">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'timberland', alt: label_shoes, wrap_modifier: 'is-menu-thumb' %}
        <span class="header__mobile-menu-link-text">{{ label_shoes }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path></svg>
    </button>

    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--parent" data-panel-target="demo-collectibles">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'pop-mart', alt: label_collectibles, wrap_modifier: 'is-menu-thumb' %}
        <span class="header__mobile-menu-link-text">{{ label_collectibles }}</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path></svg>
    </button>

    {% comment %} Accessoires hidden — no collections yet {% endcomment %}

    <a href="{{ rl_menu_url_express_delivery }}" class="header__mobile-menu-link">
      <span class="header__mobile-menu-link-main">
        {% render 'drawer-menu-collection-image', handle: 'express-delivery', alt: 'Livraison express', wrap_modifier: 'is-badge-image' %}
        <span class="header__mobile-menu-link-text">{{ label_express_delivery }}</span>
      </span>
    </a>

    {% comment %} Découvrir hidden {% endcomment %}
  </nav>
</section>
{% endif %}


{% if _show_selections %}
<section class="header__mobile-menu-panel" data-panel-id="demo-selections" data-parent-panel="root" data-panel-depth="1" aria-hidden="true" inert>
  {% render 'drawer-menu-panel-hero', show_hero: show_top_image, title: label_selections %}
  <div class="header__mobile-menu-breadcrumb">
    <button type="button" class="header__mobile-menu-back" data-panel-back>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="header__mobile-menu-back-icon"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M15.833 10H4.167M10 15.833L4.167 10 10 4.167"></path></svg>
      <span class="header__mobile-menu-back-label">{{ drawer_menu_title }}</span>
    </button>
    <p class="header__mobile-menu-breadcrumb-title">{{ label_selections }}</p>
  </div>
  <nav class="header__mobile-menu-nav{% if uppercase %} header__mobile-menu-nav--uppercase{% endif %}" style="--font-weight: {{ font_weight }};">
    <a href="{{ rl_menu_url_nouveautes }}" class="header__mobile-menu-link header__mobile-menu-link--child"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_nouveautes }}</span></span></a>
    <button type="button" class="header__mobile-menu-link header__mobile-menu-link--child" data-panel-target="demo-selections-categories">
      <span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_categories }}</span></span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="header__mobile-menu-link-chevron"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M7.5 15l5-5-5-5"></path></svg>
    </button>
    <a href="{{ rl_menu_url_collabs }}" class="header__mobile-menu-link header__mobile-menu-link--child"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_collabs }}</span></span></a>
    <a href="{{ rl_menu_url_cat_slides }}" class="header__mobile-menu-link header__mobile-menu-link--child"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_slides_sandals }}</span></span></a>
    {% comment %} Sélection Luxe hidden — no collection yet {% endcomment %}
    {% comment %} Les marques indépendantes hidden — moved Sp5der to Streetwear {% endcomment %}
  </nav>
</section>
{% endif %}


{% if _show_selections %}
<section class="header__mobile-menu-panel" data-panel-id="demo-selections-categories" data-parent-panel="demo-selections" data-panel-depth="2" aria-hidden="true" inert>
  {% render 'drawer-menu-panel-hero', show_hero: show_top_image, title: label_categories %}
  <div class="header__mobile-menu-breadcrumb">
    <button type="button" class="header__mobile-menu-back" data-panel-back>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" class="header__mobile-menu-back-icon"><path stroke="#666" stroke-linecap="round" stroke-linejoin="round" d="M15.833 10H4.167M10 15.833L4.167 10 10 4.167"></path></svg>
      <span class="header__mobile-menu-back-label">{{ label_selections }}</span>
    </button>
    <p class="header__mobile-menu-breadcrumb-title">{{ label_categories }}</p>
  </div>
  <nav class="header__mobile-menu-nav{% if uppercase %} header__mobile-menu-nav--uppercase{% endif %}" style="--font-weight: {{ font_weight }};">
    <a href="{{ rl_menu_url_cat_casual }}" class="header__mobile-menu-link header__mobile-menu-link--grandchild"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_cat_casual }}</span></span></a>
    <a href="{{ rl_menu_url_cat_retro_sn }}" class="header__mobile-menu-link header__mobile-menu-link--grandchild"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_cat_retro_sn }}</span></span></a>
    <a href="{{ rl_menu_url_cat_retro_bk }}" class="header__mobile-menu-link header__mobile-menu-link--grandchild"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_cat_retro_bk }}</span></span></a>
    <a href="{{ rl_menu_url_cat_skate }}" class="header__mobile-menu-link header__mobile-menu-link--grandchild"><span class="header__mobile-menu-link-main"><span class="header__mobile-menu-link-text">{{ label_cat_skate }}</span></span></a>
  </nav>
</section>
{% endif %}


{% if _show_sneakers %}
<section class="header__mobile-menu-panel" data-panel-id="demo-sneakers" data-parent-panel="root" data-panel-depth="1" aria-hidden="true" inert>
