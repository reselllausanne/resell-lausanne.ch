{%- doc -%}
  Promotional pictos on product media.

  SALE → top-right.
  48h / express → top-left (never together; 48h wins).
  Always uses theme SVG assets (no metafield image override — those blew up on rails).
  PLP / home rails use a compact scale.
{%- enddoc -%}

{%- liquid
  assign picto_stacked = stacked | default: false
  assign skip_sale_picto = skip_sale_picto | default: false
  assign show_sale = false
  assign show_48h = false
  assign show_express = false

  capture rs_picto_flags
    render 'rs-promotional-picto-signals', product: product
  endcapture
  assign rs_picto_parts = rs_picto_flags | strip | split: '|'
  if rs_picto_parts[0] == '1'
    assign show_sale = true
  endif
  if rs_picto_parts[1] == '1'
    assign show_48h = true
  elsif rs_picto_parts[2] == '1'
    assign show_express = true
  endif

  if skip_sale_picto
    assign show_sale = false
  endif
  if product.metafields.custom.show_sale_picto.value == false
    assign show_sale = false
  endif

  assign sale_picto_src = 'rl-picto-sales.svg' | asset_url
  assign rs_48h_src = 'rl-picto-48h.svg' | asset_url
  assign rs_express_src = 'rl-picto-express.svg' | asset_url
-%}

{%- if show_sale or show_48h or show_express -%}
  <div
    class="product-card-promotional-pictos{% if picto_stacked %} product-card-promotional-pictos--stacked{% endif %}"
    aria-hidden="true"
  >
    {%- if show_sale -%}
      <img
        class="product-card-promotional-pictos__picto product-card-promotional-pictos__picto--sales"
        src="{{ sale_picto_src }}"
        alt=""
        width="56"
        height="24"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}

    {%- if show_48h -%}
      <img
        class="product-card-promotional-pictos__picto product-card-promotional-pictos__picto--48h"
        src="{{ rs_48h_src }}"
        alt=""
        width="56"
        height="24"
        loading="lazy"
        decoding="async"
      >
    {%- elsif show_express -%}
      <img
        class="product-card-promotional-pictos__picto product-card-promotional-pictos__picto--express"
        src="{{ rs_express_src }}"
        alt=""
        width="72"
        height="24"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-card-promotional-pictos {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .product-card-promotional-pictos__picto {
    position: absolute;
    top: 8px;
    display: block;
    width: 56px !important;
    height: 24px !important;
    max-width: 56px !important;
    max-height: 24px !important;
    object-fit: contain;
    object-position: center;
    flex-shrink: 0;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 12%));
  }

  .product-card-promotional-pictos__picto--express {
    width: 72px !important;
    max-width: 72px !important;
  }

  .product-card-promotional-pictos__picto--sales {
    right: 8px;
    left: auto;
  }

  .product-card-promotional-pictos__picto--48h,
  .product-card-promotional-pictos__picto--express {
    left: 8px;
    right: auto;
  }

  /* Rails / PLP / search — keep readable (was squashed to ~28px) */
  .main-collection__products-grid .product-card-promotional-pictos__picto,
  .main-search__products-grid .product-card-promotional-pictos__picto,
  .rl-image-tag-slider__media .product-card-promotional-pictos__picto,
  .collection-plp-featured-rail__pictos .product-card-promotional-pictos__picto,
  .predictive-search__product-media .product-card-promotional-pictos__picto,
  .landing-product-card__media .product-card-promotional-pictos__picto,
  .product-card .product-card-promotional-pictos__picto {
    top: 6px !important;
    width: 52px !important;
    height: 22px !important;
    max-width: 52px !important;
    max-height: 22px !important;
  }

  .main-collection__products-grid .product-card-promotional-pictos__picto--express,
  .main-search__products-grid .product-card-promotional-pictos__picto--express,
  .rl-image-tag-slider__media .product-card-promotional-pictos__picto--express,
  .collection-plp-featured-rail__pictos .product-card-promotional-pictos__picto--express,
  .predictive-search__product-media .product-card-promotional-pictos__picto--express,
  .landing-product-card__media .product-card-promotional-pictos__picto--express,
  .product-card .product-card-promotional-pictos__picto--express {
    width: 66px !important;
    max-width: 66px !important;
  }

  .main-collection__products-grid .product-card-promotional-pictos__picto--sales,
  .main-search__products-grid .product-card-promotional-pictos__picto--sales,
  .rl-image-tag-slider__media .product-card-promotional-pictos__picto--sales,
  .collection-plp-featured-rail__pictos .product-card-promotional-pictos__picto--sales,
  .predictive-search__product-media .product-card-promotional-pictos__picto--sales,
  .landing-product-card__media .product-card-promotional-pictos__picto--sales,
  .product-card .product-card-promotional-pictos__picto--sales {
    right: 6px !important;
    left: auto !important;
  }

  .main-collection__products-grid .product-card-promotional-pictos__picto--48h,
  .main-collection__products-grid .product-card-promotional-pictos__picto--express,
  .main-search__products-grid .product-card-promotional-pictos__picto--48h,
  .main-search__products-grid .product-card-promotional-pictos__picto--express,
  .rl-image-tag-slider__media .product-card-promotional-pictos__picto--48h,
  .rl-image-tag-slider__media .product-card-promotional-pictos__picto--express,
  .collection-plp-featured-rail__pictos .product-card-promotional-pictos__picto--48h,
  .collection-plp-featured-rail__pictos .product-card-promotional-pictos__picto--express,
  .predictive-search__product-media .product-card-promotional-pictos__picto--48h,
  .predictive-search__product-media .product-card-promotional-pictos__picto--express,
  .landing-product-card__media .product-card-promotional-pictos__picto--48h,
  .landing-product-card__media .product-card-promotional-pictos__picto--express,
  .product-card .product-card-promotional-pictos__picto--48h,
  .product-card .product-card-promotional-pictos__picto--express {
    left: 6px !important;
    right: auto !important;
  }

  .product-card-promotional-pictos-stack {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
{% endstylesheet %}
