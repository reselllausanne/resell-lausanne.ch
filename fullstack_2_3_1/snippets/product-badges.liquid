{%- doc -%}
  Affiche les badges sur les cartes de produits.

  @param {object} product - Le produit
  @param {boolean} [skip_sales_badge] - Hide sale badge when promotional picto already shown on card

  @example
  {% render 'product-badges', product: product, settings: settings %}
{%- enddoc -%}

{%- liquid
  capture price_snapshot
    render 'rs-product-price-snapshot', product: product
  endcapture
  assign price_parts = price_snapshot | strip | split: '|'
  assign min_present = price_parts[8]
  assign min_price = 0
  assign min_compare = 0
  if min_present == '1'
    assign min_price = price_parts[2] | plus: 0
    assign min_compare = price_parts[3] | plus: 0
  endif
-%}

<div
  class="product-badges product-badges--{{ settings.badge_position_on_cards }}"
>
  {%- if product.metafields.custom.badge -%}
    <div class="badge color-{{ settings.badge_color_scheme_custom }}">
      {{ product.metafields.custom.badge }}
    </div>
  {%- endif -%}

  {%- if product.available == false and settings.show_sold_out_badge_on_cards -%}
    <div class="badge color-{{ settings.badge_color_scheme_sold_out }}">
      {{ 'products.sold_out' | t }}
    </div>
  {%- endif -%}

  {%- unless skip_sales_badge -%}
    {%- if min_present == '1' and min_compare > min_price and min_compare > 0 and settings.show_sales_badge_on_cards -%}
      <div class="badge color-{{ settings.badge_color_scheme_sales }}">
        {{ 'products.sales' | t }}
      </div>
    {%- endif -%}
  {%- endunless -%}
</div>

{% stylesheet %}
  .product-badges {
    position: absolute;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
  }

  .product-badges--bottom-left {
    bottom: var(--padding-sm);
    left: var(--padding-sm);
    justify-content: flex-start;
  }

  .product-badges--top-left {
    top: var(--padding-sm);
    left: var(--padding-sm);
    justify-content: flex-start;
  }

  .product-badges--top-right {
    top: var(--padding-sm);
    right: var(--padding-sm);
    justify-content: flex-end;
  }
{% endstylesheet %}
