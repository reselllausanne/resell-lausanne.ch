{% if settings.font_from == 'shopify' %}
  {% # theme-check-disable %}
  {%- unless template.name == 'index' or template.name == 'collection' or template.name == 'search' or template.name == 'product' -%}
    {%- unless settings.type_body_font.system? or settings.font_from == 'custom' -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_body_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}
    {%- unless settings.type_subheading_font.system? or settings.font_from == 'custom' -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_subheading_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? or settings.font_from == 'custom' -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_heading_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}
  {%- endunless -%}
  {% # theme-check-enable %}
{% endif %}
