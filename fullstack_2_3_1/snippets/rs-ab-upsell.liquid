{% doc %}
  Size-modal upsell A/B test.

  A = size → cart view with upsells → checkout (current behaviour).
  B = size → checkout directly.

  Mode comes from theme setting `ab_upsell_mode` (force_a / force_b / split).
  In split mode each visitor gets a stable 50/50 variant (cookie + localStorage, 60 days).
  `?ab_upsell=A|B` overrides and persists the variant (QA).
  Tracked variants are written to the cart as attribute `_ab_upsell` (→ order note_attributes)
  and published as custom web-pixel event `ab_upsell_assigned`.

  @example
  {% render 'rs-ab-upsell' %}
{% enddoc %}

<script>
  (function () {
    var mode = {{ settings.ab_upsell_mode | default: 'force_a' | json }};
    var KEY = 'rs_ab_upsell';
    var SYNC_KEY = 'rs_ab_upsell_synced';
    var TTL_MS = 60 * 24 * 60 * 60 * 1000;
    var isValid = function (v) { return v === 'A' || v === 'B'; };

    var readStored = function () {
      var m = document.cookie.match(/(?:^|;\s*)rs_ab_upsell=([AB])(?:;|$)/);
      if (m) return m[1];
      try {
        var raw = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (raw && isValid(raw.v) && raw.exp > Date.now()) return raw.v;
      } catch (e) {}
      return null;
    };

    var store = function (v) {
      var exp = Date.now() + TTL_MS;
      document.cookie = KEY + '=' + v + '; expires=' + new Date(exp).toUTCString() + '; path=/; SameSite=Lax';
      try { localStorage.setItem(KEY, JSON.stringify({ v: v, exp: exp })); } catch (e) {}
    };

    var override = '';
    try { override = (new URLSearchParams(window.location.search).get('ab_upsell') || '').toUpperCase(); } catch (e) {}

    var variant = 'A';
    var tracked = false;
    if (isValid(override)) {
      variant = override;
      store(variant);
      tracked = true;
    } else if (mode === 'split') {
      variant = readStored();
      if (!variant) {
        variant = Math.random() < 0.5 ? 'A' : 'B';
        store(variant);
      }
      tracked = true;
    } else if (mode === 'force_b') {
      variant = 'B';
    }

    var cartCookie = function () {
      var m = document.cookie.match(/(?:^|;\s*)cart=([^;]+)/);
      return m ? m[1] : '';
    };

    var syncCartAttribute = function (force) {
      if (!tracked) return Promise.resolve();
      var cart = cartCookie();
      if (!cart && !force) return Promise.resolve();
      var key = variant + '|' + cart;
      try {
        if (!force && sessionStorage.getItem(SYNC_KEY) === key) return Promise.resolve();
      } catch (e) {}
      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      return fetch(root + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ attributes: { _ab_upsell: variant } }),
      })
        .then(function (res) {
          if (!res.ok) return;
          try { sessionStorage.setItem(SYNC_KEY, variant + '|' + cartCookie()); } catch (e) {}
        })
        .catch(function () {});
    };

    var publish = function (attempt) {
      if (!tracked) return;
      try {
        if (window.Shopify && window.Shopify.analytics && typeof window.Shopify.analytics.publish === 'function') {
          window.Shopify.analytics.publish('ab_upsell_assigned', { variant: variant });
          return;
        }
      } catch (e) {}
      if ((attempt || 0) < 20) window.setTimeout(function () { publish((attempt || 0) + 1); }, 250);
    };

    window.rsAbUpsell = {
      mode: mode,
      variant: variant,
      tracked: tracked,
      skipUpsellStep: variant === 'B',
      syncCartAttribute: syncCartAttribute,
    };

    if (tracked) {
      document.addEventListener('cart:updated', function () { syncCartAttribute(false); });
      var boot = function () {
        publish(0);
        syncCartAttribute(false);
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    }
  })();
</script>
