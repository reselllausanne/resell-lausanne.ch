{% comment %}
  Locale-specific PLP header title/intro fallbacks when metafields are blank.
  Sets: plp_header_title, plp_header_intro
{% endcomment %}
{%- liquid
  assign plp_header_title = blank
  assign plp_header_intro = blank
  assign _h = collection.handle | downcase

  case _h
      assign plp_header_title = 'Travis Scott x Nike'
      if locale_base == 'de'
        assign plp_header_intro = 'Authentische Travis Scott × Nike Sneakers: Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack und Nike SB Dunk Low — geliefert in der ganzen Schweiz.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic Travis Scott × Nike sneakers: Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack and Nike SB Dunk Low — delivered across Switzerland.'
      else
        assign plp_header_intro = 'Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack et Nike SB Dunk Low Travis Scott authentiques, livrés partout en Suisse.'
      endif
    when 'essentials', 'fear-of-god-essentials'
      assign plp_header_title = 'Fear of God Essentials'
      if locale_base == 'de'
        assign plp_header_intro = 'Essentials Fear of God — minimalistischer Streetwear von Jerry Lorenzo: authentische Hoodies, Tees, Jogginghosen und Crewnecks in der Schweiz.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Fear of God Essentials — Jerry Lorenzo minimalist streetwear: authentic hoodies, tees, joggers and crewnecks in Switzerland.'
      else
        assign plp_header_intro = 'Essentials Fear of God, le streetwear minimaliste signe Jerry Lorenzo : hoodies, tees, joggings et crewnecks authentiques disponibles en Suisse.'
      endif
    when 'nike-air-max-plus-tn', 'air-max-plus', 'tn', 'nike-tn'
      if locale_base == 'de'
        assign plp_header_intro = 'Nike Air Max Plus TN authentisch in der Schweiz: Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta und mehr.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic Nike Air Max Plus TN in Switzerland: Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta and more.'
      else
        assign plp_header_intro = 'Nike TN Air Max Plus authentiques en Suisse : Hyper Blue, Voltage Purple, Volt, Triple Black, Corteiz, Patta, Skepta — livrés partout en Suisse.'
      endif
    when 'nike-air-max-95', 'air-max-95'
      if locale_base == 'de'
        assign plp_header_intro = 'Nike Air Max 95 authentisch in der Schweiz: Neon OG, Big Bubble, Triple Black, Corteiz — für Herren und Damen.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic Nike Air Max 95 in Switzerland: Neon OG, Big Bubble, Triple Black, Corteiz — men and women.'
      else
        assign plp_header_intro = 'Nike Air Max 95 authentiques en Suisse : Neon OG, Big Bubble, Triple Black, Corteiz, homme et femme.'
      endif
    when 'air-jordan-4', 'jordan-4'
      if locale_base == 'de'
        assign plp_header_intro = 'Air Jordan 4 authentisch in der Schweiz: Bred, White Cement, Military Black, Travis Scott, Off-White, Union LA und mehr.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic Air Jordan 4 in Switzerland: Bred, White Cement, Military Black, Travis Scott, Off-White, Union LA and more.'
      else
        assign plp_header_intro = 'Air Jordan 4 authentiques en Suisse : Bred, White Cement, Military Black, Travis Scott, Off-White, Union LA — livrées partout en Suisse.'
      endif
    when 'asics-gel-kayano-14', 'gel-kayano-14', 'kayano-14'
      if locale_base == 'de'
        assign plp_header_intro = 'ASICS Gel-Kayano 14 authentisch in der Schweiz: White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic ASICS Gel-Kayano 14 in Switzerland: White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY.'
      else
        assign plp_header_intro = 'ASICS Gel-Kayano 14 authentiques en Suisse : White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY.'
      endif
    when 'onitsuka-tiger', 'onitsuka', 'onitsuka-tokuten'
      if locale_base == 'de'
        assign plp_header_intro = 'Authentische Onitsuka Tiger Mexico 66, Tokuten, Serrano und Mexico 66 SD — geprüft und in der ganzen Schweiz geliefert.'
      elsif locale_base == 'en'
        assign plp_header_intro = 'Authentic Onitsuka Tiger Mexico 66, Tokuten, Serrano and Mexico 66 SD — verified and delivered across Switzerland.'
      else
        assign plp_header_intro = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano et Mexico 66 SD authentiques — vérifiés et livrés partout en Suisse.'
      endif
    when 'crampons-de-foot', 'crampons', 'football'
      assign plp_header_title = 'Crampons de foot'
      if locale_base == 'de'
        assign plp_header_title = 'Fußballschuhe'
        assign plp_header_intro = 'Nike Mercurial, Tiempo, Phantom, Adidas Predator, F50 und Copa: authentische FG-, SG-, AG- und TF-Schuhe für jeden Untergrund.'
      elsif locale_base == 'en'
        assign plp_header_title = 'Football boots'
        assign plp_header_intro = 'Nike Mercurial, Tiempo, Phantom, Adidas Predator, F50 and Copa: authentic FG, SG, AG and TF boots for every surface.'
      else
        assign plp_header_intro = 'Nike Mercurial, Tiempo, Phantom, Adidas Predator, F50 et Copa: crampons FG, SG, AG, TF authentiques pour tous les terrains.'
      endif
    when 'new-balance-1000'
      assign plp_header_title = 'New Balance 1000'
  endcase

  comment
    DE-only H1 augmentation: German shoppers search "{brand} schuhe" / "{model}
    schweiz" — bare collection.title (e.g. just "Nike") wastes the head-term
    keyword. Only fires when nothing above already set plp_header_title, so we
    never overwrite Fußballschuhe / Travis Scott x Nike / Fear of God Essentials
    / New Balance 1000. Non-DE locales untouched.
  endcomment
  if locale_base == 'de' and plp_header_title == blank
    case _h
      when 'nike', 'nike-sneakers'
        assign plp_header_title = 'Nike Schuhe'
      when 'adidas'
        assign plp_header_title = 'Adidas Schuhe'
      when 'asics'
        assign plp_header_title = 'ASICS Schuhe'
      when 'new-balance'
        assign plp_header_title = 'New Balance Schuhe'
      when 'jordan', 'air-jordan'
        assign plp_header_title = 'Jordan Schuhe'
      when 'puma'
        assign plp_header_title = 'Puma Schuhe'
      when 'salomon'
        assign plp_header_title = 'Salomon Schuhe'
      when 'on-running', 'on'
        assign plp_header_title = 'On Running Schuhe'
      when 'reebok'
        assign plp_header_title = 'Reebok Schuhe'
      when 'vans'
        assign plp_header_title = 'Vans Schuhe'
      when 'converse'
        assign plp_header_title = 'Converse Schuhe'
      when 'yeezy'
        assign plp_header_title = 'Yeezy Schuhe'
      when 'golden-goose'
        assign plp_header_title = 'Golden Goose Schuhe'
      when 'mizuno'
        assign plp_header_title = 'Mizuno Schuhe'
      when 'crocs'
        assign plp_header_title = 'Crocs Schuhe'
      when 'adidas-samba', 'samba', 'samba-og'
        assign plp_header_title = 'Adidas Samba Schweiz'
      when 'adidas-gazelle', 'gazelle', 'gazelle-bold'
        assign plp_header_title = 'Adidas Gazelle Schweiz'
      when 'adidas-spezial', 'handball-spezial', 'spezial', 'trimm-trab'
        assign plp_header_title = 'Adidas Spezial Schweiz'
      when 'dunk', 'dunk-low', 'nike-dunk'
        assign plp_header_title = 'Nike Dunk Schweiz'
      when 'dunk-sb', 'nike-sb-dunk'
        assign plp_header_title = 'Nike SB Dunk Schweiz'
      when 'nike-air-force-1', 'air-force-1', 'af1', 'air-force-1-low'
        assign plp_header_title = 'Nike Air Force 1 Schweiz'
      when 'nike-cortez', 'cortez'
        assign plp_header_title = 'Nike Cortez Schweiz'
      when 'nike-vomero', 'vomero', 'vomero-5', 'nike-vomero-5'
        assign plp_header_title = 'Nike Vomero 5 Schweiz'
      when 'new-balance-9060', 'nb-9060'
        assign plp_header_title = 'New Balance 9060 Schweiz'
      when 'new-balance-530', 'nb-530'
        assign plp_header_title = 'New Balance 530 Schweiz'
      when 'new-balance-2002r', 'nb-2002r'
        assign plp_header_title = 'New Balance 2002R Schweiz'
      when 'new-balance-1906r', 'nb-1906r'
        assign plp_header_title = 'New Balance 1906R Schweiz'
      when 'new-balance-204', 'new-balance-204l', 'nb-204l'
        assign plp_header_title = 'New Balance 204L Schweiz'
      when 'gel-nyc', 'asics-gel-nyc'
        assign plp_header_title = 'ASICS Gel-NYC Schweiz'
      when 'asics-double-laces', 'double-laces'
        assign plp_header_title = 'ASICS Gel-NYC Double Laces Schweiz'
      when 'gel-1130', 'asics-gel-1130'
        assign plp_header_title = 'ASICS Gel-1130 Schweiz'
      when 'yeezy-slide', 'yeezy-slides'
        assign plp_header_title = 'Yeezy Slide Schweiz'
      when 'salomon-xt-6', 'salomon-xt6', 'xt-6', 'xt6'
        assign plp_header_title = 'Salomon XT-6 Schweiz'
      when 'puma-speedcat', 'speedcat'
        assign plp_header_title = 'Puma Speedcat Schweiz'
      when 'moonswatch', 'swatch-omega', 'swatch-x-omega'
        assign plp_header_title = 'Swatch × Omega MoonSwatch Schweiz'
      when 'chrome-hearts'
        assign plp_header_title = 'Chrome Hearts Schweiz'
      when 'denim-tears'
        assign plp_header_title = 'Denim Tears Schweiz'
      when 'supreme'
        assign plp_header_title = 'Supreme Schweiz'
      when 'off-white', 'nike-x-off-white'
        assign plp_header_title = 'Off-White Schweiz'
      when 'bape', 'a-bathing-ape'
        assign plp_header_title = 'BAPE A Bathing Ape Schweiz'
      when 'labubu', 'pop-mart', 'the-monsters'
        assign plp_header_title = 'Labubu × Pop Mart Schweiz'
    endcase
  endif

  echo plp_header_title | append: '|||' | append: plp_header_intro
-%}
