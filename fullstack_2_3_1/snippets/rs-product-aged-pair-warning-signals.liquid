{%- doc -%}
  Aged-pair warning flags for sneakers/footwear with an old release date. {% comment %} pragma: allowlist secret {% endcomment %}

  Output: "1|YYYY-MM-DD" when warning applies, else "0|".

  Uses custom.release_date or Release Date / Date de sortie in description HTML.
  Excludes sealed collectibles (LEGO, watches, Pop Mart, etc.).

  @param {product} product
  @param {number} [years_threshold] - default 15

  @example
  {% capture rs_aged_pair_flags %}{% render 'rs-product-aged-pair-warning-signals', product: product, years_threshold: 15 %}{% endcapture %}
{%- enddoc -%}

{%- liquid
  assign rs_aged_pair_active = false
  assign rs_aged_pair_release_date = blank
  assign rs_aged_pair_years = years_threshold | default: 15 | plus: 0

  capture rs_is_sealed_flag
    render 'rs-product-is-sealed-collectible', product: product
  endcapture

  unless rs_is_sealed_flag != blank
    if product.metafields.custom.release_date != blank
      assign rs_aged_pair_release_date = product.metafields.custom.release_date.value | default: product.metafields.custom.release_date
    endif

    if rs_aged_pair_release_date == blank
      assign rs_raw_description = product.description | default: product.body_html | default: ''
      if rs_raw_description contains 'Release Date:'
        assign rs_release_chunks = rs_raw_description | split: 'Release Date:'
        assign rs_aged_pair_release_date = rs_release_chunks[1] | split: '<' | first | split: '<br' | first | remove: ':' | strip
      elsif rs_raw_description contains 'Date de sortie:'
        assign rs_release_chunks = rs_raw_description | split: 'Date de sortie:'
        assign rs_aged_pair_release_date = rs_release_chunks[1] | split: '<' | first | split: '<br' | first | remove: ':' | strip
      elsif rs_raw_description contains 'Release-Datum:'
        assign rs_release_chunks = rs_raw_description | split: 'Release-Datum:'
        assign rs_aged_pair_release_date = rs_release_chunks[1] | split: '<' | first | split: '<br' | first | remove: ':' | strip
      endif
    endif

    if rs_aged_pair_release_date != blank
      assign rs_aged_pair_release_date = rs_aged_pair_release_date | slice: 0, 10
      assign rs_current_year = 'now' | date: '%Y' | plus: 0
      assign rs_cutoff_year = rs_current_year | minus: rs_aged_pair_years
      assign rs_release_year = rs_aged_pair_release_date | slice: 0, 4 | plus: 0
      if rs_release_year > 0 and rs_release_year <= rs_cutoff_year
        assign rs_aged_pair_active = true
      endif
    endif
  endunless
-%}
{%- if rs_aged_pair_active -%}1{%- else -%}0{%- endif -%}|{{ rs_aged_pair_release_date }}
