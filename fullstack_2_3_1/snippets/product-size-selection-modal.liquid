{% liquid
  assign modal_dom_id = 'size-selection-modal-' | append: section_id
  assign size_guide_modal_id = 'product-size-guide-' | append: section_id
  assign size_option_index = 0
  assign size_option_name = ''
  assign has_size_option = false
  assign numeric_option_index = -1
  assign numeric_option_matches = 0
  assign largest_option_values_count = 0

  for opt in product.options_with_values
    assign option_values_count = opt.values | size
    if option_values_count > largest_option_values_count
      assign largest_option_values_count = option_values_count
    endif

    assign option_has_numeric_value = false
    for option_value in opt.values
      assign option_value_token = option_value | append: '' | strip
      assign option_value_token_clean = option_value_token | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ' ' | remove: '.' | remove: ',' | remove: '/' | remove: '-'
      if option_value_token != blank and option_value_token_clean == blank
        assign option_has_numeric_value = true
        break
      endif
    endfor

    if option_has_numeric_value
      assign numeric_option_matches = numeric_option_matches | plus: 1
      assign numeric_option_index = forloop.index0
    endif
  endfor

  assign size_option_index = -1
  if product.options_with_values.size == 1
    assign size_option_index = 0
  elsif numeric_option_matches == 1
    assign size_option_index = numeric_option_index
  elsif largest_option_values_count > 1
    for opt in product.options_with_values
      if opt.values.size == largest_option_values_count
        assign size_option_index = forloop.index0
        break
      endif
    endfor
  endif

  if size_option_index >= 0
    assign has_size_option = true
    for opt in product.options_with_values
      if forloop.index0 == size_option_index
        assign size_option_name = opt.name
        break
      endif
    endfor
  endif

  capture fit_note
    render 'rs-product-fit-note', product: product
  endcapture
  assign fit_note = fit_note | strip

  assign sm_size_guide = 'products.pdp.size_modal.size_guide' | t
  assign sm_sizes_aria = 'products.pdp.size_modal.sizes_aria' | t
  assign sm_unit_aria = 'products.pdp.size_modal.unit_aria' | t
  assign sm_show_all_sizes = 'products.pdp.size_modal.show_all_sizes' | t
  assign sm_add_to_cart = 'products.add_to_cart' | t
  assign sm_hero_sub_range = 'products.pdp.size_modal.hero_sub_range' | t
  assign sm_express_promise_default = 'products.pdp.size_modal.express_promise_default' | t
  assign sm_promo_powerpay = 'products.pdp.size_modal.promo_powerpay' | t
  assign sm_promo_free = 'products.pdp.size_modal.promo_free' | t
  assign sm_promo_fast = 'products.pdp.size_modal.promo_fast' | t
  assign sm_cart_added = 'products.pdp.size_modal.cart_added' | t
  assign sm_delivery_option = 'products.pdp.size_modal.delivery_option' | t
  assign sm_continue_checkout = 'products.pdp.size_modal.continue_checkout' | t
  assign sm_close_aria = 'products.pdp.size_modal.close_aria' | t

  assign shipping_method_label = product.metafields.custom.shipping_method_label.value | default: 'Livraison'
  assign shipping_standard_label = product.metafields.custom.shipping_standard_label.value | default: 'Standard'
  capture rs_shipping_express_label_raw
    render 'rs-metafield-text', metafield: product.metafields.custom.shipping_express_label
  endcapture
  assign rs_shipping_express_label_raw = rs_shipping_express_label_raw | strip
  if rs_shipping_express_label_raw != blank
    assign shipping_express_label = rs_shipping_express_label_raw
  else
    assign shipping_express_label = 'products.pdp.size_modal.express_shipping' | t
  endif

  assign modal_48h_picto_src = 'rl-picto-48h.svg' | asset_url
  if product.metafields.custom.delivery_48h_picto.value != blank
    assign modal_48h_picto_src = product.metafields.custom.delivery_48h_picto.value | image_url: width: 100
  endif

  capture rs_soldes_48h_flag
    render 'rs-soldes-48h-signal', product: product
  endcapture
  capture rs_48h_delivery_flag
    render 'rs-48h-delivery-signal', product: product
  endcapture
  assign rs_soldes_48h_active = false
  assign rs_48h_delivery_active = false
  if rs_soldes_48h_flag != blank
    assign rs_soldes_48h_active = true
  endif
  if rs_48h_delivery_flag != blank
    assign rs_48h_delivery_active = true
  endif
  assign product_in_fast_delivery_collection = rs_soldes_48h_active

  assign express_delivery_promise_default = ''
  if product.metafields.custom.express_delivery_promise.value != blank
    assign express_delivery_promise_default = product.metafields.custom.express_delivery_promise.value | append: '' | strip
  elsif product.metafields.custom.delivery_estimation_text.value != blank
    assign express_delivery_promise_default = product.metafields.custom.delivery_estimation_text.value | append: '' | strip
  elsif product.metafields.custom.delivery_between_text.value != blank
    assign express_delivery_promise_default = product.metafields.custom.delivery_between_text.value | append: '' | strip
  elsif product.metafields.custom.delivery_promise_prefix.value != blank
    assign express_delivery_promise_default = product.metafields.custom.delivery_promise_prefix.value | append: '' | strip
  elsif rs_shipping_express_label_raw != blank
    assign rs_shipping_express_label = rs_shipping_express_label_raw | downcase
    if rs_shipping_express_label contains '48'
      assign express_delivery_promise_default = rs_shipping_express_label_raw
    endif
  endif

  assign product_has_48h_signal = false
  if rs_soldes_48h_active or rs_48h_delivery_active
    assign product_has_48h_signal = true
  endif
  if express_delivery_promise_default != blank
    assign product_has_48h_signal = true
  endif
  if product_has_48h_signal and express_delivery_promise_default == blank
    assign express_delivery_promise_default = '48H'
  endif

  comment
    Variant-level custom.delivery_48h marks the sizes physically held in the
    Bussigny warehouse. When at least one variant carries it, 48h is decided
    per variant and the product-level signal must not blanket the others,
    otherwise sizes sourced externally would promise a 48h delivery.
  endcomment
  assign product_has_variant_48h_flag = false
  for variant_48h_probe in product.variants
    if variant_48h_probe.metafields.custom.delivery_48h.value == true
      assign product_has_variant_48h_flag = true
      break
    endif
  endfor
  assign product_48h_blankets_variants = product_has_48h_signal
  if product_has_variant_48h_flag
    assign product_48h_blankets_variants = false
  endif

  capture modal_price_snapshot
    render 'rs-product-price-snapshot', product: product
  endcapture
  assign modal_price_parts = modal_price_snapshot | strip | split: '|'
  assign modal_product_is_free = false
  assign modal_product_has_valid_prices = false
  assign modal_fallback_price = 0
  if modal_price_parts[6] == '1'
    assign modal_product_is_free = true
  endif
  if modal_price_parts[8] == '1'
    assign modal_product_has_valid_prices = true
    assign modal_fallback_price = modal_price_parts[2] | plus: 0
  endif

  assign socks_product = all_products['nike-everyday-plus-cushioned-crew-socks-6-pairs-white']
  assign product_handle_down = product.handle | default: '' | downcase
  assign product_title_down = product.title | default: '' | downcase
  assign product_type_down = product.type | default: '' | downcase
  assign product_tags_down = ''
  for product_tag in product.tags
    assign product_tags_down = product_tags_down | append: '|' | append: product_tag | downcase
  endfor
  assign collection_handles_down = ''
  for product_collection in product.collections
    assign collection_handles_down = collection_handles_down | append: '|' | append: product_collection.handle | downcase
  endfor

  assign is_streetwear_product = false
  if product_handle_down contains 'essentials'
    assign is_streetwear_product = true
  elsif product_type_down contains 'streetwear' or product_type_down contains 'vetement' or product_type_down contains 'clothing' or product_type_down contains 'apparel'
    assign is_streetwear_product = true
  elsif product_title_down contains 'tee' or product_title_down contains 't-shirt' or product_title_down contains 'short' or product_title_down contains 'hoodie' or product_title_down contains 'crewneck'
    assign is_streetwear_product = true
  elsif product_tags_down contains '|streetwear' or product_tags_down contains '|vetement' or product_tags_down contains '|apparel' or product_tags_down contains '|tee' or product_tags_down contains '|t-shirt' or product_tags_down contains '|short' or product_tags_down contains '|shorts'
    assign is_streetwear_product = true
  elsif collection_handles_down contains '|streetwear' or collection_handles_down contains '|vetements'
    assign is_streetwear_product = true
  endif

  assign has_numeric_size_values = false
  if has_size_option and size_option_index >= 0
    assign source_size_values = product.options_with_values[size_option_index].values
    for source_size in source_size_values
      assign source_size_token = source_size | append: '' | strip
      assign source_size_clean = source_size_token | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ' ' | remove: '.' | remove: ',' | remove: '/' | remove: '-'
      if source_size_token != blank and source_size_clean == blank
        assign has_numeric_size_values = true
        break
      endif
    endfor
  endif

  assign is_footwear_product = false
  if product_handle_down contains 'sneaker' or product_handle_down contains 'jordan' or product_handle_down contains 'dunk' or product_handle_down contains 'yeezy' or product_handle_down contains 'air-max' or product_handle_down contains 'new-balance' or product_handle_down contains 'asics'
    assign is_footwear_product = true
  elsif product_type_down contains 'sneaker' or product_type_down contains 'shoe' or product_type_down contains 'chaussure'
    assign is_footwear_product = true
  elsif product_title_down contains 'sneaker' or product_title_down contains 'jordan' or product_title_down contains 'dunk' or product_title_down contains 'yeezy' or product_title_down contains 'air max' or product_title_down contains 'new balance'
    assign is_footwear_product = true
  elsif collection_handles_down contains '|sneakers' or collection_handles_down contains '|chaussures' or collection_handles_down contains '|running'
    assign is_footwear_product = true
  elsif has_numeric_size_values and is_streetwear_product == false
    assign is_footwear_product = true
  endif

  if is_footwear_product
    assign cart_upsell_handles = 'nike-everyday-plus-cushioned-crew-socks-6-pairs-white,supreme-hanes-boxer-briefs-black,supreme-hanes-boxer-briefs-white,cleaning-kit-by-sole-savaz,supreme-hanes-socks-4-pack-black,supreme-hanes-crew-socks-4-pack-heather-grey,alo-unisex-half-crew-throwback-sock-black-white,alo-unisex-half-crew-throwback-sock-white-black,fluffy-laces' | split: ','
  elsif is_streetwear_product
    assign cart_upsell_handles = 'supreme-hanes-boxer-briefs-black,supreme-hanes-boxer-briefs-white,cleaning-kit-by-sole-savaz,supreme-hanes-socks-4-pack-black,supreme-hanes-crew-socks-4-pack-heather-grey,fluffy-laces' | split: ','
  else
    assign cart_upsell_handles = 'cleaning-kit-by-sole-savaz,supreme-hanes-boxer-briefs-black,supreme-hanes-boxer-briefs-white,nike-everyday-plus-cushioned-crew-socks-6-pairs-white,supreme-hanes-socks-4-pack-black,supreme-hanes-crew-socks-4-pack-heather-grey,alo-unisex-half-crew-throwback-sock-black-white,alo-unisex-half-crew-throwback-sock-white-black,fluffy-laces' | split: ','
  endif
  assign apparel_upsell_product = blank
  if product.metafields.custom.size_modal_upsell_product.value != blank
    assign apparel_upsell_product = product.metafields.custom.size_modal_upsell_product.value
  elsif product.metafields.custom.matching_short.value != blank
    assign apparel_upsell_product = product.metafields.custom.matching_short.value
  elsif product.metafields.custom.matching_shorts.value != blank
    assign apparel_upsell_product = product.metafields.custom.matching_shorts.value
  elsif product.metafields.custom.matching_tshirt.value != blank
    assign apparel_upsell_product = product.metafields.custom.matching_tshirt.value
  elsif product.metafields.custom.matching_t_shirt.value != blank
    assign apparel_upsell_product = product.metafields.custom.matching_t_shirt.value
  elsif product.metafields.custom.size_modal_upsell_handle.value != blank
    assign apparel_upsell_handle = product.metafields.custom.size_modal_upsell_handle.value | append: '' | strip
    assign apparel_upsell_product = all_products[apparel_upsell_handle]
  endif
  if apparel_upsell_product == blank
    assign product_id_string = product.id | append: ''
    case product_id_string
      when '15340410896770'
        assign apparel_upsell_product = all_products['essentials-tee-light-oatmeal-ss22']
      when '15349630501250'
        assign apparel_upsell_product = all_products['essentials-shorts-light-oatmeal-ss22']
      when '15340411617666'
        assign apparel_upsell_product = all_products['essentials-shorts-stretch-limo-ss22']
      when '15340410732930'
        assign apparel_upsell_product = all_products['fear-of-god-essentials-jersey-crewneck-t-shirt-black']
        if apparel_upsell_product == blank
          assign apparel_upsell_product = all_products['fear-of-god-essentials-jersey-crewneck-t-shirt-black-1']
        endif
    endcase
  endif
  if apparel_upsell_product != blank and apparel_upsell_product.id == product.id
    assign apparel_upsell_product = blank
  endif
  assign apparel_upsell_size_option_index = 0
  if apparel_upsell_product != blank and apparel_upsell_product.options_with_values.size > 1
    assign current_size_option_name_down = size_option_name | downcase
    for opt in apparel_upsell_product.options_with_values
      assign apparel_opt_name_down = opt.name | downcase
      if apparel_opt_name_down == current_size_option_name_down or apparel_opt_name_down == 'size' or apparel_opt_name_down == 'taille'
        assign apparel_upsell_size_option_index = forloop.index0
        break
      endif
    endfor
  endif

  comment
    Essentials classic tee colorways: when buying one, upsell the others
    at the same size with −10% written on the card.
  endcomment
  assign essentials_tee_handles = 'essentials-tee-light-oatmeal-ss22,essentials-tees-stretch-limo-ss22,essentials-tees-dark-oatmeal-ss22' | split: ','
  assign essentials_tee_labels = 'Light Oatmeal,Stretch Limo,Dark Oatmeal' | split: ','
  assign essentials_short_handles = 'essentials-shorts-light-oatmeal-ss22,essentials-shorts-stretch-limo-ss22,essentials-shorts-dark-oatmeal-ss22' | split: ','
  assign essentials_short_labels = 'Light Oatmeal,Stretch Limo,Dark Oatmeal' | split: ','
  assign is_essentials_tee = false
  assign is_essentials_short = false
  assign current_essentials_color_index = -1
  for essentials_handle in essentials_tee_handles
    if product.handle == essentials_handle
      assign is_essentials_tee = true
      assign current_essentials_color_index = forloop.index0
      break
    endif
  endfor
  if current_essentials_color_index < 0
    for essentials_short_handle in essentials_short_handles
      if product.handle == essentials_short_handle
        assign is_essentials_short = true
        assign current_essentials_color_index = forloop.index0
        break
      endif
    endfor
  endif
  assign show_essentials_reco = false
  if is_streetwear_product or is_footwear_product
    assign show_essentials_reco = true
  endif
  assign show_ultimate_bundle_in_modal = true
  if is_streetwear_product
    assign show_ultimate_bundle_in_modal = false
  endif
  assign initial_cart_upsell_product = apparel_upsell_product
  if initial_cart_upsell_product == blank
    assign initial_cart_upsell_product = socks_product
  endif
  assign protection_product = all_products['protection-du-colis']
  assign protection_variant = protection_product.selected_or_first_available_variant
  assign protection_subtitle = 'Livraison premium avec assurance incluse'

  assign signature_product = all_products['livraison-sous-signature']
  if signature_product == blank
    assign signature_product = all_products['sous-signature']
  endif
  assign signature_variant = signature_product.selected_or_first_available_variant
  comment
    Offer adds one Shopify product: Ultimate Bundle.
    Same pattern as express: different catalog ID, real price, no JS price rewrite.
    Do not add tee + kit + wipes as separate lines.
  endcomment
  assign ultimate_bundle_pdp_product = all_products['ultimate-bundle']
  if ultimate_bundle_pdp_product == blank
    assign ultimate_bundle_pdp_product = all_products['ultimate-bundle-4990']
  endif
  assign ultimate_bundle_color_handles = 'ultimate-bundle-light-oatmeal,ultimate-bundle-stretch-limo' | split: ','
  assign ultimate_bundle_tee_oatmeal = all_products['essentials-tee-light-oatmeal-ss22']
  assign ultimate_bundle_tee_limo = all_products['essentials-tees-stretch-limo-ss22']
  assign ultimate_bundle_color_option_index = -1
  assign ultimate_bundle_size_option_index = 0
  if ultimate_bundle_pdp_product != blank
    for ub_opt in ultimate_bundle_pdp_product.options_with_values
      assign ub_opt_name = ub_opt.name | downcase
      if ub_opt_name contains 'couleur' or ub_opt_name contains 'color'
        assign ultimate_bundle_color_option_index = forloop.index0
      elsif ub_opt_name contains 'taille' or ub_opt_name contains 'size'
        assign ultimate_bundle_size_option_index = forloop.index0
      endif
    endfor
  endif

  assign ultimate_bundle_has_offer = false
  if show_ultimate_bundle_in_modal
    if ultimate_bundle_pdp_product != blank and ultimate_bundle_pdp_product.variants.size > 0
      assign ultimate_bundle_has_offer = true
    else
      for ub_handle in ultimate_bundle_color_handles
        assign ub_color_product = all_products[ub_handle]
        if ub_color_product != blank and ub_color_product.variants.size > 0
          assign ultimate_bundle_has_offer = true
          break
        endif
      endfor
    endif
  endif
%}

{% if has_size_option and product.has_only_default_variant == false %}
  {{ 'product-size-selection-modal.css' | asset_url | stylesheet_tag }}
  {{ 'rs-trust-badge.css' | asset_url | stylesheet_tag }}

  {% comment %}
    Variant delivery contract:
    - variant.custom.express_delivery_promise | delivery_estimation_text | delivery_between_text → 48h mode + picto
    - product.metafields.custom.soldes_48h == true → 48h at product price, no extra fields
    - product tag soldes-48h / soldes (or soldes collection) → same fallback
    - variant.custom.express_price (money/number) → optional paid express upgrade on non-soldes products
  {% endcomment %}

  <template id="{{ modal_dom_id }}-tpl">
  <div
    id="{{ modal_dom_id }}"
    class="rs-size-modal"
    data-rs-size-modal
    data-rs-size-modal-section="{{ section_id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ modal_dom_id }}-title"
  >
    <div class="rs-size-modal__overlay" data-rs-size-modal-overlay tabindex="-1"></div>

    <div class="rs-size-modal__content">
      <div class="rs-size-modal__background" aria-hidden="true"></div>

      <div
      class="rs-size-modal__panel"
      role="document"
      data-rs-standard-shipping-name="{{ shipping_standard_label | escape }}"
      data-rs-express-shipping-name="{{ shipping_express_label | escape }}"
    >
        <div class="rs-size-modal__main">
          <div class="rs-size-modal__inner-top">
            <div class="rs-size-modal__hero">
              <h2 id="{{ modal_dom_id }}-title" class="rs-size-modal__hero-title" data-rs-modal-hero-title>
                {{ product.title | escape }}
              </h2>
              <p class="rs-size-modal__hero-sub" data-rs-modal-hero-sub hidden>
                <span data-rs-modal-hero-sub-label>{{ shipping_standard_label | escape }}</span>
                {{ ' ' }}
                <span data-rs-modal-hero-sub-range>{{ sm_hero_sub_range | escape }}</span>
              </p>
            </div>

            <div class="rs-size-modal__toolbar">
              <div class="rs-size-modal__unit-toggle" role="group" aria-label="{{ sm_unit_aria | escape }}">
                <button type="button" class="rs-size-modal__unit is-active" data-rs-size-unit="eu" aria-pressed="true">
                  EU
                </button>
              </div>
              <button
                type="button"
                class="rs-size-modal__guide-link"
                data-size-modal-open="{{ size_guide_modal_id }}"
                aria-controls="{{ size_guide_modal_id }}"
                aria-haspopup="dialog"
              >
                {{ sm_size_guide | escape }}
              </button>
            </div>

            <div class="rs-size-modal__express-legend" data-rs-modal-express-legend hidden>
              <span class="rs-size-modal__express-legend-dot" aria-hidden="true"></span>
              <span class="rs-size-modal__express-legend-text" data-rs-modal-express-legend-text>{{ sm_express_promise_default | escape }}</span>
            </div>

            <p class="rs-size-modal__fit-note">{{ fit_note | escape }}</p>
          </div>

          <div class="rs-size-modal__grid-scroller">
            <div class="rs-size-modal__grid" data-rs-size-grid role="listbox" aria-label="{{ sm_sizes_aria | escape }}"></div>
          </div>
          <div class="rs-size-modal__inner-bottom">
            <button
              type="button"
              class="rs-size-modal__show-more"
              data-rs-size-grid-expand
              aria-expanded="false"
              hidden
            >
              {{ sm_show_all_sizes | escape }}
            </button>
            {% render 'rs-trust-badge', size: 'small', sub_format: 'compact', class: 'rs-size-modal__trust-banner' %}
            <div class="rs-size-modal__shipping" data-rs-shipping-section>
              <p class="rs-size-modal__shipping-title">{{ shipping_method_label }}</p>
              <div class="rs-size-modal__shipping-cards">
                <button
                  type="button"
                  class="rs-size-modal__ship-card is-selected"
                  data-rs-ship="standard"
                  role="radio"
                  aria-checked="true"
                >
                  <span class="rs-size-modal__ship-radio" aria-hidden="true"></span>
                  <span class="rs-size-modal__ship-name">{{ shipping_standard_label }}</span>
                  <span class="rs-size-modal__ship-price" data-rs-ship-standard-price></span>
                </button>
                <button
                  type="button"
                  class="rs-size-modal__ship-card rs-size-modal__ship-card--express"
                  data-rs-ship="express"
                  role="radio"
                  aria-checked="false"
                  hidden
                >
                  <span class="rs-size-modal__ship-radio" aria-hidden="true"></span>
                  <span class="rs-size-modal__ship-head">
                    <span class="rs-size-modal__ship-name">{{ shipping_express_label | escape }}</span>
                    <img
                      class="rs-size-modal__ship-picto-48h"
                      data-rs-ship-express-picto
                      src="{{ modal_48h_picto_src }}"
                      alt=""
                      width="50"
                      height="26"
                      loading="lazy"
                      decoding="async"
                      hidden
                    >
                  </span>
                  <span class="rs-size-modal__ship-promise" data-rs-ship-express-promise hidden></span>
                  <span class="rs-size-modal__ship-row">
                    <span class="rs-size-modal__ship-price" data-rs-ship-express-price></span>
                  </span>
                </button>
              </div>
            </div>

            <div class="rs-size-modal__promo" data-rs-modal-promo>
              <p class="rs-size-modal__promo-line rs-size-modal__promo-line--strong">{{ sm_promo_powerpay | escape }}</p>
              <p class="rs-size-modal__promo-line">
                <span class="rs-size-modal__promo-muted">{{ sm_promo_fast | escape | strip }}</span>
              </p>
            </div>

            <button
              type="button"
              class="rs-size-modal__atc button button--primary button--full-width"
              data-rs-modal-atc
              disabled
            >
              {{ sm_add_to_cart | escape }}
            </button>
          </div>
        </div>

        <div class="rs-size-modal__cart-view" data-rs-modal-cart-view aria-hidden="true">
          <div class="rs-size-modal__cart-inner">
            <div class="rs-size-modal__cart-header">
              <span class="rs-size-modal__cart-check" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 12 10 18 20 6"/>
                </svg>
              </span>
              <p class="rs-size-modal__cart-eyebrow">{{ sm_cart_added | escape }}</p>
            </div>

            <div class="rs-size-modal__cart-product">
              <div class="rs-size-modal__cart-product-media">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 200 }}"
                    alt="{{ product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                    data-rs-modal-cart-image
                  >
                {% else %}
                  <img src="" alt="" width="80" height="80" loading="lazy" data-rs-modal-cart-image>
                {% endif %}
              </div>

              <div class="rs-size-modal__cart-product-info">
                <p class="rs-size-modal__cart-product-title" data-rs-modal-cart-title>
                  {{- product.title | escape -}}
                </p>
                <p class="rs-size-modal__cart-product-meta">
                  <span data-rs-modal-cart-variant></span>
                  <span class="rs-size-modal__cart-product-sep" aria-hidden="true">-</span>
                  <span data-rs-modal-cart-price></span>
                </p>
                <p class="rs-size-modal__cart-delivery">
                  <span class="rs-size-modal__cart-delivery-label" data-rs-modal-cart-delivery-label>{{ shipping_method_label | escape }}</span>
                  <img
                    class="rs-size-modal__cart-delivery-picto rs-size-modal__cart-delivery-picto--48h"
                    data-rs-modal-cart-delivery-picto-48h
                    src="{{ modal_48h_picto_src }}"
                    alt=""
                    width="50"
                    height="26"
                    loading="lazy"
                    decoding="async"
                    hidden
                  >
                  <img
                    class="rs-size-modal__cart-delivery-picto rs-size-modal__cart-delivery-picto--express"
                    data-rs-modal-cart-delivery-picto-express
                    src="{{ 'rl-picto-express.svg' | asset_url }}"
                    alt=""
                    width="76"
                    height="26"
                    loading="lazy"
                    decoding="async"
                    hidden
                  >
                  <span class="rs-size-modal__cart-delivery-badge" data-rs-modal-cart-delivery-badge hidden></span>
                </p>
              </div>
            </div>

            {% render 'rs-trust-badge', size: 'small', sub_format: 'compact', link: false, class: 'rs-size-modal__trust-banner' %}

            {%- if signature_product != blank and signature_variant != blank -%}
              <div class="rs-size-modal__cart-delivery-options" data-rs-modal-cart-delivery-options>
                <p class="rs-size-modal__shipping-title">{{ sm_delivery_option | escape }}</p>
                <div class="rs-size-modal__shipping-cards rs-size-modal__cart-delivery-cards">
                  <button
                    type="button"
                    class="rs-size-modal__ship-card is-selected"
                    data-rs-cart-ship="standard"
                    role="radio"
                    aria-checked="true"
                  >
                    <span class="rs-size-modal__ship-radio" aria-hidden="true"></span>
                    <span class="rs-size-modal__ship-name">{{ shipping_standard_label | escape }}</span>
                    <span class="rs-size-modal__ship-price" data-rs-cart-ship-standard-price></span>
                  </button>
                  <button
                    type="button"
                    class="rs-size-modal__ship-card"
                    data-rs-cart-ship="signature"
                    role="radio"
                    aria-checked="false"
                    {% unless signature_variant.available %}disabled{% endunless %}
                  >
                    <span class="rs-size-modal__ship-radio" aria-hidden="true"></span>
                    <span class="rs-size-modal__ship-name">Sous signature</span>
                    <span class="rs-size-modal__ship-promise">Remise contre signature</span>
                    <span class="rs-size-modal__ship-price">{{ signature_variant.price | money_without_trailing_zeros }}</span>
                  </button>
                </div>
              </div>
            {%- endif -%}

            <div class="rs-size-modal__cart-upsell-list">
              <p class="rs-size-modal__cart-upsell-heading">Complétez votre panier</p>

              <div data-rs-modal-cart-upsells>
                {%- if ultimate_bundle_has_offer -%}
                  <div
                    class="rs-size-modal__cart-upsell rs-size-modal__cart-upsell--ultimate-bundle"
                    data-rs-modal-ultimate-bundle
                  >
                    <div class="rs-size-modal__cart-upsell-row" data-rs-modal-ultimate-bundle-row>
                      <span class="rs-size-modal__cart-upsell-media" aria-hidden="true">
                        <img
                          data-rs-modal-ultimate-bundle-image
                          src=""
                          alt=""
                          width="88"
                          height="88"
                          loading="lazy"
                          decoding="async"
                        >
                      </span>
                      <span class="rs-size-modal__cart-upsell-info">
                        <span class="rs-size-modal__cart-upsell-title">{{ 'cart.ultimate_bundle.title' | t }}</span>
                        <span class="rs-size-modal__cart-upsell-price">
                          <span data-rs-modal-ultimate-bundle-price></span>
                          <span
                            class="rs-size-modal__ultimate-bundle-compare"
                            data-rs-modal-ultimate-bundle-compare
                            hidden
                          ></span>
                        </span>
                        <span
                          class="rs-size-modal__cart-upsell-sub"
                          data-rs-modal-ultimate-bundle-savings
                        ></span>
                        <select
                          class="rs-size-modal__cart-upsell-select"
                          data-rs-modal-ultimate-bundle-select
                          aria-label="{{ 'cart.ultimate_bundle.select_size' | t | escape }}"
                        ></select>
                        <p class="rs-size-modal__ultimate-bundle-limited" data-rs-modal-ultimate-bundle-limited>
                          {{ 'cart.ultimate_bundle.limited_offer' | t }}
                          <span data-rs-modal-ultimate-bundle-limited-count class="rs-size-modal__ultimate-bundle-limited-count"></span>
                        </p>
                      </span>
                      <button
                        type="button"
                        class="rs-size-modal__cart-upsell-add"
                        data-rs-modal-ultimate-bundle-add
                        aria-pressed="false"
                        aria-label="{{ 'cart.ultimate_bundle.title' | t | escape }}"
                      >
                        <span class="rs-size-modal__cart-upsell-add-icon" data-rs-modal-ultimate-bundle-add-icon aria-hidden="true">+</span>
                      </button>
                    </div>
                  </div>
                {%- endif -%}
              </div>

            {%- if protection_product != blank and protection_variant != blank -%}
              <div class="rs-size-modal__cart-upsell rs-size-modal__cart-upsell--protection" data-rs-modal-protection-upsell>
                <div class="rs-size-modal__cart-upsell-row" data-rs-modal-protection-upsell-row>
                  <div class="rs-size-modal__cart-upsell-media" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 2.5L4.5 6v5.5c0 4.7 3.2 9.1 7.5 10 4.3-.9 7.5-5.3 7.5-10V6L12 2.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                      <path d="M9 12.2l2 2 4.2-4.4" stroke="#2f9e8f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>

                  <div class="rs-size-modal__cart-upsell-info">
                    <p class="rs-size-modal__cart-upsell-title">{{ protection_product.title | escape }}</p>
                    <p class="rs-size-modal__cart-upsell-price">{{ protection_variant.price | money_without_trailing_zeros }}</p>
                    {%- if protection_subtitle != blank -%}
                      <p class="rs-size-modal__cart-upsell-sub">{{ protection_subtitle | escape }}</p>
                    {%- endif -%}
                  </div>

                  <button
                    type="button"
                    class="rs-size-modal__cart-upsell-add"
                    data-rs-modal-protection-add
                    aria-pressed="false"
                    aria-label="Ajouter {{ protection_product.title | escape }}"
                    {% unless protection_variant.available %}disabled{% endunless %}
                  >
                    <span class="rs-size-modal__cart-upsell-add-icon" data-rs-modal-protection-add-icon aria-hidden="true">+</span>
                  </button>
                </div>
              </div>
            {%- endif -%}

            </div>
          </div>

          <div class="rs-size-modal__cart-footer">
            <a
              href="/checkout"
              class="rs-size-modal__cart-cta rs-size-modal__cart-cta--primary"
              data-rs-modal-cart-checkout
            >
              {{ sm_continue_checkout | escape }}
            </a>
          </div>
        </div>
      </div>

      <button type="button" class="rs-size-modal__close-fab" data-rs-size-modal-close aria-label="{{ sm_close_aria | escape }}">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
  </template>

  <script type="application/json" id="{{ modal_dom_id }}-payload">
    {
      "modalId": {{ modal_dom_id | json }},
      "sizeOptionIndex": {{ size_option_index }},
      "sizeOptionName": {{ size_option_name | json }},
      "optionNames": {{ product.options | json }},
      "productId": {{ product.id | json }},
      "productHandle": {{ product.handle | json }},
      "productTitle": {{ product.title | json }},
      "productImage": {{ product.featured_image | image_url: width: 200 | json }},
      "upsellContext": {
        "isStreetwearProduct": {{ is_streetwear_product | json }},
        "isFootwearProduct": {{ is_footwear_product | json }},
        "showUltimateBundle": {{ show_ultimate_bundle_in_modal | json }}
      },
      "expressDeliveryPromiseDefault": {{ express_delivery_promise_default | json }},
      "i18n": {
        "addToCart": {{ sm_add_to_cart | json }},
        "deliveryLabel": {{ shipping_method_label | json }},
        "expressPromiseDefault": {{ sm_express_promise_default | json }},
        "selectSizeDesktop": {{ 'products.pdp.size_modal.select_size_desktop' | t | json }},
        "selectSizeMobile": {{ 'products.pdp.size_modal.select_size_mobile' | t | json }}
      },
      "apparelUpsell": {% if apparel_upsell_product != blank and apparel_upsell_product.variants.size > 0 %}{
        "productId": {{ apparel_upsell_product.id | json }},
        "title": {{ apparel_upsell_product.title | json }},
        "image": {{ apparel_upsell_product.featured_image | image_url: width: 160 | json }},
        "sizeOptionIndex": {{ apparel_upsell_size_option_index }},
        "optionNames": {{ apparel_upsell_product.options | json }},
        "variants": [
          {%- for apparel_variant in apparel_upsell_product.variants -%}
            {% liquid
              assign apparel_variant_size_label = apparel_variant.title
              if apparel_upsell_product.options.size > 1
                assign apparel_variant_size_label = apparel_variant.options[apparel_upsell_size_option_index]
              endif
            %}
            {
              "id": {{ apparel_variant.id | json }},
              "sizeLabel": {{ apparel_variant_size_label | json }},
              "options": {{ apparel_variant.options | json }},
              "priceFormatted": {{ apparel_variant.price | money_without_trailing_zeros | json }},
              "available": {{ apparel_variant.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }{% else %}null{% endif %},
      "socksUpsell": {% if socks_product != blank and socks_product.variants.size > 0 %}{
        "productId": {{ socks_product.id | json }},
        "title": {{ socks_product.title | json }},
        "image": {{ socks_product.featured_image | image_url: width: 160 | json }},
        "variants": [
          {%- for sock_variant in socks_product.variants -%}
            {
              "id": {{ sock_variant.id | json }},
              "sizeLabel": {{ sock_variant.title | json }},
              "priceFormatted": {{ sock_variant.price | money_without_trailing_zeros | json }},
              "available": {{ sock_variant.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }{% else %}null{% endif %},
      "essentialsColorwayUpsells": {% if show_essentials_reco %}{
        "discountPercent": 10,
        "discountLabel": {{ 'cart.essentials_colorway.discount_badge' | t | json }},
        "colorways": [
          {%- assign cw_first = true -%}
          {%- assign essentials_seen_handles = ',' -%}
          {%- assign essentials_reco_handles = '' -%}
          {%- if is_essentials_short and current_essentials_color_index >= 0 -%}
            {%- assign same_color_tee = essentials_tee_handles[current_essentials_color_index] -%}
            {%- if same_color_tee != blank -%}{%- assign essentials_reco_handles = essentials_reco_handles | append: same_color_tee | append: ',' -%}{%- endif -%}
            {%- for tee_handle in essentials_tee_handles -%}
              {%- if forloop.index0 == current_essentials_color_index -%}{%- continue -%}{%- endif -%}
              {%- assign essentials_reco_handles = essentials_reco_handles | append: tee_handle | append: ',' -%}
            {%- endfor -%}
            {%- for short_handle in essentials_short_handles -%}
              {%- if short_handle == product.handle -%}{%- continue -%}{%- endif -%}
              {%- assign essentials_reco_handles = essentials_reco_handles | append: short_handle | append: ',' -%}
            {%- endfor -%}
          {%- elsif is_essentials_tee and current_essentials_color_index >= 0 -%}
            {%- for tee_handle in essentials_tee_handles -%}
              {%- if tee_handle == product.handle -%}{%- continue -%}{%- endif -%}
              {%- assign essentials_reco_handles = essentials_reco_handles | append: tee_handle | append: ',' -%}
            {%- endfor -%}
            {%- assign same_color_short = essentials_short_handles[current_essentials_color_index] -%}
            {%- if same_color_short != blank -%}{%- assign essentials_reco_handles = essentials_reco_handles | append: same_color_short | append: ',' -%}{%- endif -%}
            {%- for short_handle in essentials_short_handles -%}
              {%- if forloop.index0 == current_essentials_color_index -%}{%- continue -%}{%- endif -%}
              {%- assign essentials_reco_handles = essentials_reco_handles | append: short_handle | append: ',' -%}
            {%- endfor -%}
          {%- elsif is_footwear_product -%}
            {%- assign essentials_reco_handles = 'essentials-tee-light-oatmeal-ss22,essentials-tees-stretch-limo-ss22,' -%}
          {%- else -%}
            {%- assign essentials_reco_handles = 'essentials-tee-light-oatmeal-ss22,essentials-tees-stretch-limo-ss22,essentials-tees-dark-oatmeal-ss22,essentials-shorts-light-oatmeal-ss22,essentials-shorts-stretch-limo-ss22,' -%}
          {%- endif -%}
          {%- assign essentials_reco_handles_list = essentials_reco_handles | split: ',' -%}
          {%- for essentials_handle in essentials_reco_handles_list -%}
            {%- assign essentials_handle = essentials_handle | strip -%}
            {%- if essentials_handle == blank or essentials_handle == product.handle -%}{%- continue -%}{%- endif -%}
            {%- assign essentials_seen_key = ',' | append: essentials_handle | append: ',' -%}
            {%- if essentials_seen_handles contains essentials_seen_key -%}{%- continue -%}{%- endif -%}
            {%- assign essentials_seen_handles = essentials_seen_handles | append: essentials_handle | append: ',' -%}
            {%- assign cw_product = all_products[essentials_handle] -%}
            {%- if cw_product == blank or cw_product.variants.size == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign cw_label = cw_product.title -%}
            {%- for tee_handle in essentials_tee_handles -%}
              {%- if tee_handle == essentials_handle -%}
                {%- assign cw_label = essentials_tee_labels[forloop.index0] | append: ' Tee' -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for short_handle in essentials_short_handles -%}
              {%- if short_handle == essentials_handle -%}
                {%- assign cw_label = essentials_short_labels[forloop.index0] | append: ' Short' -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign cw_size_option_index = 0 -%}
            {%- for cw_opt in cw_product.options_with_values -%}
              {%- assign cw_opt_down = cw_opt.name | downcase -%}
              {%- if cw_opt_down == 'size' or cw_opt_down == 'taille' -%}
                {%- assign cw_size_option_index = forloop.index0 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless cw_first -%},{%- endunless -%}
            {
              "productId": {{ cw_product.id | json }},
              "handle": {{ cw_product.handle | json }},
              "label": {{ cw_label | json }},
              "title": {{ cw_product.title | json }},
              "image": {% if cw_product.featured_image != blank %}{{ cw_product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
              "variants": [
                {%- for cw_variant in cw_product.variants -%}
                  {%- liquid
                    assign cw_size_label = cw_variant.title
                    if cw_product.options.size > 0
                      assign cw_size_label = cw_variant.options[cw_size_option_index]
                    endif
                    assign cw_sale_cents = cw_variant.price | times: 90 | divided_by: 100
                  -%}
                  {
                    "id": {{ cw_variant.id | json }},
                    "sizeLabel": {{ cw_size_label | json }},
                    "image": {% if cw_variant.featured_image != blank %}{{ cw_variant.featured_image | image_url: width: 160 | json }}{% elsif cw_variant.image != blank %}{{ cw_variant.image | image_url: width: 160 | json }}{% else %}null{% endif %},
                    "priceCents": {{ cw_variant.price | json }},
                    "priceFormatted": {{ cw_variant.price | money_without_trailing_zeros | json }},
                    "salePriceCents": {{ cw_sale_cents | json }},
                    "salePriceFormatted": {{ cw_sale_cents | money_without_trailing_zeros | json }},
                    "available": {{ cw_variant.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
            {%- assign cw_first = false -%}
          {%- endfor -%}
        ]
      }{% else %}null{% endif %},
      "cartUpsells": [
        {%- assign cart_upsell_first = true -%}
        {%- for cart_upsell_handle in cart_upsell_handles -%}
          {%- assign cart_upsell_product = all_products[cart_upsell_handle] -%}
          {%- if cart_upsell_product != blank and cart_upsell_product.variants.size > 0 -%}
            {%- unless cart_upsell_first -%},{%- endunless -%}
            {
              "productId": {{ cart_upsell_product.id | json }},
              "title": {{ cart_upsell_product.title | json }},
              "image": {{ cart_upsell_product.featured_image | image_url: width: 160 | json }},
              "variants": [
                {%- for cart_upsell_variant in cart_upsell_product.variants -%}
                  {
                    "id": {{ cart_upsell_variant.id | json }},
                    "sizeLabel": {{ cart_upsell_variant.title | json }},
                    "image": {%- if cart_upsell_variant.image != blank -%}{{ cart_upsell_variant.image | image_url: width: 160 | json }}{%- else -%}null{%- endif -%},
                    "priceFormatted": {{ cart_upsell_variant.price | money_without_trailing_zeros | json }},
                    "available": {{ cart_upsell_variant.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
            {%- assign cart_upsell_first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "protectionUpsell": {% if protection_product != blank and protection_variant != blank %}{
        "productId": {{ protection_product.id | json }},
        "variantId": {{ protection_variant.id | json }},
        "title": {{ protection_product.title | json }},
        "priceFormatted": {{ protection_variant.price | money_without_trailing_zeros | json }},
        "available": {{ protection_variant.available | json }}
      }{% else %}null{% endif %},
      "signature": {% if signature_product != blank and signature_variant != blank %}{
        "variantId": {{ signature_variant.id | json }},
        "title": {{ signature_product.title | json }},
        "priceFormatted": {{ signature_variant.price | money_without_trailing_zeros | json }},
        "available": {{ signature_variant.available | json }}
      }{% else %}null{% endif %},
      "ultimateBundle": {% if ultimate_bundle_has_offer %}{
        "productId": {% if ultimate_bundle_pdp_product != blank %}{{ ultimate_bundle_pdp_product.id | json }}{% else %}null{% endif %},
        "title": {% if ultimate_bundle_pdp_product != blank %}{{ ultimate_bundle_pdp_product.title | json }}{% else %}{{ 'cart.ultimate_bundle.title' | t | json }}{% endif %},
        "colors": [
          {%- if ultimate_bundle_pdp_product != blank and ultimate_bundle_pdp_product.variants.size > 0 -%}
            {%- if ultimate_bundle_color_option_index >= 0 -%}
              {%- assign ub_color_option = ultimate_bundle_pdp_product.options_with_values[ultimate_bundle_color_option_index] -%}
              {%- for ub_color_value in ub_color_option.values -%}
                {%- liquid
                  assign ub_color_image = blank
                  assign ub_color_down = ub_color_value | downcase
                  comment
                    Use Ultimate Bundle SKU media (tee + kit + wipes collage).
                    Tee model shots only as fallback if color media missing.
                  endcomment
                  for ub_probe in ultimate_bundle_pdp_product.variants
                    if ub_probe.options[ultimate_bundle_color_option_index] == ub_color_value
                      if ub_probe.featured_image != blank
                        assign ub_color_image = ub_probe.featured_image
                        break
                      elsif ub_probe.image != blank
                        assign ub_color_image = ub_probe.image
                        break
                      endif
                    endif
                  endfor
                  if ub_color_image == blank
                    if ub_color_down contains 'oatmeal' and ultimate_bundle_tee_oatmeal.featured_image != blank
                      assign ub_color_image = ultimate_bundle_tee_oatmeal.featured_image
                    elsif ub_color_down contains 'limo' and ultimate_bundle_tee_limo.featured_image != blank
                      assign ub_color_image = ultimate_bundle_tee_limo.featured_image
                    endif
                  endif
                -%}
                {
                  "label": {{ ub_color_value | json }},
                  "image": {% if ub_color_image != blank %}{{ ub_color_image | image_url: width: 288 | json }}{% else %}null{% endif %},
                  "variants": [
                    {%- assign ub_variant_first = true -%}
                    {%- for ub_variant in ultimate_bundle_pdp_product.variants -%}
                      {%- if ub_variant.options[ultimate_bundle_color_option_index] == ub_color_value -%}
                        {%- liquid
                          assign ub_variant_image = ub_variant.featured_image | default: ub_variant.image | default: ub_color_image
                          assign ub_variant_compare = ub_variant.compare_at_price
                          if ub_variant_compare <= ub_variant.price
                            assign ub_variant_compare = 9900
                          endif
                          assign ub_variant_savings = ub_variant_compare | minus: ub_variant.price
                        -%}
                        {%- unless ub_variant_first -%},{%- endunless -%}
                        {
                          "id": {{ ub_variant.id | json }},
                          "sizeLabel": {{ ub_variant.options[ultimate_bundle_size_option_index] | default: ub_variant.title | json }},
                          "image": {% if ub_variant_image != blank %}{{ ub_variant_image | image_url: width: 288 | json }}{% else %}null{% endif %},
                          "available": {{ ub_variant.available | json }},
                          "priceCents": {{ ub_variant.price | json }},
                          "priceFormatted": {{ ub_variant.price | money_without_trailing_zeros | json }},
                          "compareAtCents": {{ ub_variant_compare | json }},
                          "compareAtFormatted": {{ ub_variant_compare | money_without_trailing_zeros | json }},
                          "savingsCents": {{ ub_variant_savings | json }},
                          "savingsFormatted": {{ ub_variant_savings | money_without_trailing_zeros | json }}
                        }
                        {%- assign ub_variant_first = false -%}
                      {%- endif -%}
                    {%- endfor -%}
                  ]
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              {
                "label": {{ ultimate_bundle_pdp_product.title | json }},
                "image": {% if ultimate_bundle_pdp_product.featured_image != blank %}{{ ultimate_bundle_pdp_product.featured_image | image_url: width: 288 | json }}{% else %}null{% endif %},
                "variants": [
                  {%- for ub_variant in ultimate_bundle_pdp_product.variants -%}
                    {%- liquid
                      assign ub_variant_compare = ub_variant.compare_at_price
                      if ub_variant_compare <= ub_variant.price
                        assign ub_variant_compare = 9900
                      endif
                      assign ub_variant_savings = ub_variant_compare | minus: ub_variant.price
                    -%}
                    {
                      "id": {{ ub_variant.id | json }},
                      "sizeLabel": {{ ub_variant.options[ultimate_bundle_size_option_index] | default: ub_variant.title | json }},
                      "available": {{ ub_variant.available | json }},
                      "priceCents": {{ ub_variant.price | json }},
                      "priceFormatted": {{ ub_variant.price | money_without_trailing_zeros | json }},
                      "compareAtCents": {{ ub_variant_compare | json }},
                      "compareAtFormatted": {{ ub_variant_compare | money_without_trailing_zeros | json }},
                      "savingsCents": {{ ub_variant_savings | json }},
                      "savingsFormatted": {{ ub_variant_savings | money_without_trailing_zeros | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }
            {%- endif -%}
          {%- else -%}
            {%- assign ub_color_first = true -%}
            {%- for ub_handle in ultimate_bundle_color_handles -%}
              {%- assign ub_color_product = all_products[ub_handle] -%}
              {%- if ub_color_product != blank and ub_color_product.variants.size > 0 -%}
                {%- unless ub_color_first -%},{%- endunless -%}
                {%- liquid
                  assign ub_color_label = ub_color_product.title
                  assign ub_color_image = ub_color_product.featured_image
                  if ub_handle == 'ultimate-bundle-light-oatmeal'
                    assign ub_color_label = 'Light Oatmeal'
                    if ub_color_image == blank and ultimate_bundle_tee_oatmeal.featured_image != blank
                      assign ub_color_image = ultimate_bundle_tee_oatmeal.featured_image
                    endif
                  elsif ub_handle == 'ultimate-bundle-stretch-limo'
                    assign ub_color_label = 'Stretch Limo'
                    if ub_color_image == blank and ultimate_bundle_tee_limo.featured_image != blank
                      assign ub_color_image = ultimate_bundle_tee_limo.featured_image
                    endif
                  endif
                -%}
                {
                  "label": {{ ub_color_label | json }},
                  "image": {% if ub_color_image != blank %}{{ ub_color_image | image_url: width: 288 | json }}{% else %}null{% endif %},
                  "variants": [
                    {%- for ub_variant in ub_color_product.variants -%}
                      {%- liquid
                        assign ub_variant_compare = ub_variant.compare_at_price
                        if ub_variant_compare <= ub_variant.price
                          assign ub_variant_compare = 9900
                        endif
                        assign ub_variant_savings = ub_variant_compare | minus: ub_variant.price
                      -%}
                      {
                        "id": {{ ub_variant.id | json }},
                        "sizeLabel": {{ ub_variant.option1 | default: ub_variant.title | json }},
                        "available": {{ ub_variant.available | json }},
                        "priceCents": {{ ub_variant.price | json }},
                        "priceFormatted": {{ ub_variant.price | money_without_trailing_zeros | json }},
                        "compareAtCents": {{ ub_variant_compare | json }},
                        "compareAtFormatted": {{ ub_variant_compare | money_without_trailing_zeros | json }},
                        "savingsCents": {{ ub_variant_savings | json }},
                        "savingsFormatted": {{ ub_variant_savings | money_without_trailing_zeros | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }
                {%- assign ub_color_first = false -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        ],
        "properties": {
          "_ultimate_bundle": "true",
          "_ultimate_bundle_test": "ultimate_bundle_v1",
          "_ultimate_bundle_variant": "bundle_4990"
        },
        "messages": {
          "added": {{ 'cart.ultimate_bundle.added' | t | json }},
          "selectSizeError": {{ 'cart.ultimate_bundle.select_size_error' | t | json }},
          "selectColorError": {{ 'cart.ultimate_bundle.select_color_error' | t | json }},
          "addError": {{ 'cart.ultimate_bundle.generic_add_error' | t | json }},
          "networkError": {{ 'cart.ultimate_bundle.network_error' | t | json }},
          "cta": {% capture ub_cta_tpl %}{{ 'cart.ultimate_bundle.cta' | t: savings: 'SAVINGS_PLACEHOLDER' }}{% endcapture %}{{ ub_cta_tpl | json }},
          "limitedOffer": {{ 'cart.ultimate_bundle.limited_offer' | t | json }},
          "limitedLeft": {% capture ub_limited_left %}{{ 'cart.ultimate_bundle.limited_left' | t: count: 'COUNT_PLACEHOLDER' }}{% endcapture %}{{ ub_limited_left | json }}
        }
      }{% else %}null{% endif %},
      "variants": [
        {% for variant in product.variants %}
          {% liquid
            assign express_available = false
            if variant.metafields.custom.express_available.value == true
              assign express_available = true
            endif

            assign variant_is_48h_stock = false
            if variant.metafields.custom.delivery_48h.value == true
              assign variant_is_48h_stock = true
            endif

            assign express_price_cents = variant.price
            assign express_price_defined = false
            if variant.metafields.custom.express_price != blank
              assign exp_mv = variant.metafields.custom.express_price.value
              if exp_mv.amount != blank
                assign express_price_cents = exp_mv.amount | times: 100 | round
                assign express_price_defined = true
              elsif exp_mv != blank
                assign exp_mv_str = exp_mv | append: '' | strip
                if exp_mv_str contains '.'
                  assign express_price_cents = exp_mv_str | times: 100 | round
                else
                  assign express_price_cents = exp_mv_str | plus: 0
                endif
                assign express_price_defined = true
              endif
            endif

            if express_price_defined == false and variant_is_48h_stock
              assign express_price_cents = variant.price
              assign express_price_defined = true
              assign express_available = true
            endif

            if express_price_defined == false
              assign express_available = false
            endif
            if express_price_defined and express_price_cents <= 0
              assign express_price_defined = false
              assign express_available = false
            endif

            assign shipping_group = ''
            if variant.metafields.custom.shipping_group.value != blank
              assign shipping_group = variant.metafields.custom.shipping_group.value | downcase
            endif

            assign delivery_estimation_text = ''
            if variant.metafields.custom.delivery_estimation_text.value != blank
              assign delivery_estimation_text = variant.metafields.custom.delivery_estimation_text.value | append: '' | strip
            endif

            assign delivery_between_text = ''
            if variant.metafields.custom.delivery_between_text.value != blank
              assign delivery_between_text = variant.metafields.custom.delivery_between_text.value | append: '' | strip
            endif

            assign express_delivery_label = ''
            if variant.metafields.custom.express_delivery_label.value != blank
              assign express_delivery_label = variant.metafields.custom.express_delivery_label.value | append: '' | strip
            endif

            assign express_custom_promise = ''
            if variant.metafields.custom.express_delivery_promise.value != blank
              assign express_custom_promise = variant.metafields.custom.express_delivery_promise.value | append: '' | strip
            elsif delivery_estimation_text != blank
              assign express_custom_promise = delivery_estimation_text
            elsif delivery_between_text != blank
              assign express_custom_promise = delivery_between_text
            endif

            comment
              48h delivery is ONLY variant.custom.delivery_48h (Bussigny stock).
              soldes_48h / show_48h_picto are campaign/picto flags and must never
              promise a 48h delivery — Nike Air Max Plus Triple Black had
              soldes_48h=true with physical_in_stock=false and was falsely
              advertising 48h on StockX sizes (e.g. 39 EU express CHF 279).
            endcomment
            assign express_is_48h = false
            if variant_is_48h_stock
              assign express_is_48h = true
              if express_custom_promise == blank
                assign express_custom_promise = '48H'
              endif
            endif

            assign size_value = variant.options[size_option_index]
            assign variant_standard_price = variant.price
            assign variant_available_for_display = variant.available
            if modal_product_is_free == false and variant_standard_price <= 0
              assign variant_available_for_display = false
              if modal_product_has_valid_prices
                assign variant_standard_price = modal_fallback_price
              endif
            endif

            capture express_price_formatted
              echo express_price_cents | money_without_trailing_zeros
            endcapture
          %}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant_available_for_display | json }},
            "options": {{ variant.options | json }},
            "sizeValue": {{ size_value | json }},
            "price": {{ variant_standard_price }},
            "priceFormatted": {{ variant_standard_price | money_without_trailing_zeros | json }},
            "compareAtPrice": {% if variant.compare_at_price > variant_standard_price and variant.compare_at_price > 0 %}{{ variant.compare_at_price }}{% else %}null{% endif %},
            "compareAtPriceFormatted": {% if variant.compare_at_price > variant_standard_price and variant.compare_at_price > 0 %}{{ variant.compare_at_price | money_without_trailing_zeros | json }}{% else %}null{% endif %},
            "expressAvailable": {{ express_available | json }},
            "expressPriceDefined": {{ express_price_defined | json }},
            "expressPriceCents": {% if express_price_defined %}{{ express_price_cents }}{% else %}null{% endif %},
            "expressPriceFormatted": {% if express_price_defined %}{{ express_price_formatted | strip | json }}{% else %}null{% endif %},
            "deliveryEstimationText": {{ delivery_estimation_text | json }},
            "expressCustomPromise": {{ express_custom_promise | json }},
            "expressIs48h": {{ express_is_48h | json }},
            "expressDeliveryLabel": {{ express_delivery_label | json }},
            "deliveryBetweenText": {{ delivery_between_text | json }},
            "shippingGroup": {{ shipping_group | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}
