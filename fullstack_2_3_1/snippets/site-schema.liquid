  "openingHoursSpecification": [
    {%- for day in schema_open_days -%}
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": {{ day | json }},
        "opens": {{ schema_opens | json }},
        "closes": {{ schema_closes | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "parentOrganization": {
    "@type": "Organization",
    "@id": {{ schema_org_id | json }}
  },
  "hasMerchantReturnPolicy": {
    "@id": {{ schema_return_policy_id | json }}
  }
  {%- comment -%}
    aggregateRating removed — Judge.me owns review/rating structured data.
  {%- endcomment -%}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ schema_website_id | json }},
  "name": {{ shop.name | json }},
  "url": {{ schema_root | json }},
  "publisher": {
    "@type": "Organization",
    "@id": {{ schema_org_id | json }}
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ schema_search_url_template | json }}
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
