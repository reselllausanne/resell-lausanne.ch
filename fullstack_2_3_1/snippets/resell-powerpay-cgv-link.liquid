{% liquid
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first

  if pages['conditions-generales-vente'] != blank
    assign cgv_cembrapay_url = pages['conditions-generales-vente'].url | append: '#cembrapay'
  else
    assign cgv_cembrapay_url = routes.root_url | append: 'pages/conditions-generales-vente#cembrapay'
  endif
%}

<p class="rs-cart__powerpay-cgv-link">
  {% if locale_base == 'de' %}
    CembraPay Facture (Kauf auf Rechnung): Bedingungen in unseren <a href="{{ cgv_cembrapay_url }}" class="link">AGB</a>.
  {% elsif locale_base == 'en' %}
    CembraPay Facture (pay by invoice): terms in our <a href="{{ cgv_cembrapay_url }}" class="link">T&amp;Cs</a>.
  {% elsif locale_base == 'it' %}
    CembraPay Facture (acquisto su fattura): condizioni nelle nostre <a href="{{ cgv_cembrapay_url }}" class="link">CGV</a>.
  {% else %}
    CembraPay Facture (achat sur facture)&nbsp;: conditions dans nos <a href="{{ cgv_cembrapay_url }}" class="link">CGV</a>.
  {% endif %}
</p>
