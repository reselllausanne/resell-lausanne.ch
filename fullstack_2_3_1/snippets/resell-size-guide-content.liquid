              <tr><td>47</td><td>12.5</td><td>11.5</td><td>30.5</td></tr>
              <tr><td>47.5</td><td>13</td><td>12</td><td>31</td></tr>
              <tr><td>48</td><td>13.5</td><td>12.5</td><td>31.5</td></tr>
