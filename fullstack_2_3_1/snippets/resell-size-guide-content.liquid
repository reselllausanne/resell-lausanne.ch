<script>
(function () {
  document.querySelectorAll('.rl-sg__brand').forEach(function (brand) {
    brand.querySelectorAll('[data-brand-tabs]').forEach(function (tabGroup) {
      var btns = tabGroup.querySelectorAll('.rl-sg__tab-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var panel = btn.dataset.tab;
          btns.forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          brand.querySelectorAll('.rl-sg__table-panel').forEach(function (p) {
            p.classList.toggle('is-active', p.dataset.panel === panel);
          });
        });
      });
    });
  });
})();
</script>
