      "@id": {{ schema_breadcrumb_id | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'breadcrumbs.home' | t | json }},
          "item": {{ schema_root | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ breadcrumb_name_2 | json }},
          "item": {{ breadcrumb_url_2 | json }}
        }
        {%- if breadcrumb_name_3 != blank -%}
