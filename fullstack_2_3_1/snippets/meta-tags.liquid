    if collection_schema_payload contains '###'
      assign collection_schema_labels = collection_schema_payload | split: '###' | first | strip
      assign collection_schema_handles = collection_schema_payload | split: '###' | last | strip
    endif
    if collection_schema_labels == blank
      assign breadcrumb_name_2 = collection.title
      assign breadcrumb_url_2 = canonical_href
    endif
  elsif request.page_type == 'article'
    assign breadcrumb_name_2 = blog.title
    assign breadcrumb_url_2 = request.origin | append: blog.url
    assign breadcrumb_name_3 = article.title
    assign breadcrumb_url_3 = canonical_href
  elsif request.page_type == 'page'
    assign breadcrumb_name_2 = page.title
    assign breadcrumb_url_2 = canonical_href
  endif
-%}

{%- if request.page_type == 'collection' and collection_schema_labels != blank -%}
  {%- liquid
    assign schema_breadcrumb_id = canonical_href | append: '#breadcrumb'
    assign schema_labels = collection_schema_labels | split: '|'
    assign schema_handles = collection_schema_handles | split: '|'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": {{ schema_breadcrumb_id | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'breadcrumbs.home' | t | json }},
          "item": {{ schema_root | json }}
        }
        {%- for schema_label in schema_labels -%}
          {%- assign schema_handle = schema_handles[forloop.index0] | default: '' | strip -%}
          {%- capture schema_item_url -%}
            {%- render 'breadcrumb-taxonomy-collection-url', taxonomy_handle: schema_handle -%}
          {%- endcapture -%}
          {%- assign schema_item_url = schema_item_url | strip -%}
          {%- if forloop.last or schema_item_url == blank -%}
            {%- assign schema_item_abs = canonical_href -%}
          {%- else -%}
            {%- assign schema_item_abs = request.origin | append: schema_item_url -%}
          {%- endif -%}
          ,{
            "@type": "ListItem",
            "position": {{ forloop.index | plus: 1 }},
            "name": {{ schema_label | json }},
            "item": {{ schema_item_abs | json }}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- elsif breadcrumb_name_2 != blank -%}
  {%- liquid
    assign schema_breadcrumb_id = canonical_href | append: '#breadcrumb'
  -%}
