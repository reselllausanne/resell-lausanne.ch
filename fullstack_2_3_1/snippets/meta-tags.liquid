<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">

{% comment %}
  TODO: Shop-level facet whitelist contract.
  Expected JSON metafield `shop.metafields.seo.facet_index_whitelist`:
  {
    "all": ["filter.v.option.color=black|sort_by=best-selling"],
    "collection-handle": ["filter.v.availability=1"]
  }
{% endcomment %}

{%- liquid
  assign seo_page_title = page_title
  assign seo_page_description = page_description
  assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
  assign locale_base = locale_iso | split: '-' | first

  if request.page_type == 'index'
    assign seo_page_description = seo_page_description | default: 'Resell Lausanne — spécialiste suisse des sneakers et streetwear authentiques. Plus de 20 000 références, livraison en Suisse et en Europe, authenticité garantie.'
  endif

  if request.page_type == 'blog'
    assign seo_page_title = 'Resell Journal — Guides sneakers & streetwear en Suisse'
    assign seo_page_description = 'Guides d\'achat, comparatifs, authenticité et conseils tailles pour sneakers et streetwear en Suisse. Rédigé par l\'équipe Resell Lausanne.'
    if locale_base == 'de'
      assign seo_page_title = 'Resell Journal — Sneaker- & Streetwear-Guides Schweiz'
      assign seo_page_description = 'Kaufberatung, Vergleiche, Authentizität und Größentipps für Sneakers und Streetwear in der Schweiz. Von Resell Lausanne.'
    elsif locale_base == 'en'
      assign seo_page_title = 'Resell Journal — Sneaker & streetwear guides Switzerland'
      assign seo_page_description = 'Buying guides, comparisons, authenticity and sizing advice for sneakers and streetwear in Switzerland. By the Resell Lausanne team.'
    endif
  endif

  if request.page_type == 'article'
    assign _bts_handle = article.handle | downcase
    case _bts_handle
      when 'chaussures-sneakers-rentree-2026'
        if locale_base == 'de'
          assign seo_page_title = 'Sneakers für die Schulanfang 2026 — Guide Resell Lausanne'
          assign seo_page_description = 'Welche Sneakers für den Schulanfang 2026? Resell Lausanne Guides für Teenager und Kinder — Trends, Komfort, Grössen und praktische Tipps für die Schweiz.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Back to School sneakers 2026 — Resell Lausanne guide'
          assign seo_page_description = 'Which sneakers for back to school 2026? Resell Lausanne guides for teens and kids — trends, comfort, sizing and practical tips for Switzerland.'
        else
          assign seo_page_title = 'Quelles sneakers choisir pour la rentrée 2026 ?'
          assign seo_page_description = 'Quelles sneakers choisir pour la rentrée 2026 ? Les guides Resell Lausanne pour ados et enfants : tendances, confort, pointures et conseils pratiques en Suisse.'
        endif
      when 'sneakers-rentree-2026-ado-fille'
        if locale_base == 'de'
          assign seo_page_title = 'Sneakers Schulanfang 2026 Teen Mädchen — Resell Lausanne'
          assign seo_page_description = 'Die besten Sneakers für Teenager-Mädchen 2026: Spezial, Samba, ASICS, P-6000, New Balance, Jordan 4. Komfort, Stil und Grössentipps für die Schweiz.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Back to school sneakers 2026 teen girls — Resell Lausanne'
          assign seo_page_description = 'Best sneakers for teen girls in 2026: Spezial, Samba, ASICS, P-6000, New Balance, Jordan 4. Comfort, style and sizing tips for Switzerland.'
        else
          assign seo_page_title = 'Sneakers rentrée 2026 ado fille — Guide Resell Lausanne'
          assign seo_page_description = 'Les meilleures sneakers pour une ado fille en 2026 : Spezial, Samba, ASICS, P-6000, New Balance, Jordan 4. Confort, style et conseils pointures en Suisse.'
        endif
      when 'sneakers-rentree-2026-ado-garcon'
        if locale_base == 'de'
          assign seo_page_title = 'Sneakers Schulanfang 2026 Teen Junge — Resell Lausanne'
          assign seo_page_description = 'Sneakers für Teenager-Jungen 2026: GEL-NYC, P-6000, Air Force 1, Jordan 4, 9060, Campus 00s. Alltag, Komfort und Grössenratgeber Schweiz.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Back to school sneakers 2026 teen boys — Resell Lausanne'
          assign seo_page_description = 'Sneakers for teen boys in 2026: GEL-NYC, P-6000, Air Force 1, Jordan 4, 9060, Campus 00s. Everyday wear, comfort and sizing for Switzerland.'
        else
          assign seo_page_title = 'Sneakers rentrée 2026 ado garçon — Guide Resell Lausanne'
          assign seo_page_description = 'Sneakers pour ado garçon en 2026 : GEL-NYC, P-6000, Air Force 1, Jordan 4, 9060, Campus 00s. Quotidien, confort et pointures en Suisse.'
        endif
      when 'chaussures-rentree-2026-fille'
        if locale_base == 'de'
          assign seo_page_title = 'Schulschuhe Sneakers 2026 Mädchen — Resell Lausanne'
          assign seo_page_description = 'Praktische Sneakers für Mädchen 2026: Air Force 1 GS, P-6000, Samba, Campus, Jordan 1 Mid, NB 530. Komfort, Autonomie und Grössen für die Schweiz.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Back to school sneakers 2026 girls — Resell Lausanne'
          assign seo_page_description = 'Practical sneakers for girls in 2026: Air Force 1 GS, P-6000, Samba, Campus, Jordan 1 Mid, NB 530. Comfort, independence and sizing in Switzerland.'
        else
          assign seo_page_title = 'Chaussures rentrée 2026 fille — Guide Resell Lausanne'
          assign seo_page_description = 'Sneakers pratiques pour une fille en 2026 : Air Force 1 GS, P-6000, Samba, Campus, Jordan 1 Mid, NB 530. Confort, autonomie et pointures en Suisse.'
        endif
      when 'chaussures-rentree-2026-garcon'
        if locale_base == 'de'
          assign seo_page_title = 'Schulschuhe Sneakers 2026 Junge — Resell Lausanne'
          assign seo_page_description = 'Sneakers für Jungen 2026: Air Force 1 GS, P-6000, Jordan 4 GS, Jordan 1 Low, Campus, GEL-NYC GS. Halt, Alltag und Grössenratgeber Schweiz.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Back to school sneakers 2026 boys — Resell Lausanne'
          assign seo_page_description = 'Sneakers for boys in 2026: Air Force 1 GS, P-6000, Jordan 4 GS, Jordan 1 Low, Campus, GEL-NYC GS. Support, daily wear and sizing in Switzerland.'
        else
          assign seo_page_title = 'Chaussures rentrée 2026 garçon — Guide Resell Lausanne'
          assign seo_page_description = 'Sneakers pour garçon en 2026 : Air Force 1 GS, P-6000, Jordan 4 GS, Jordan 1 Low, Campus, GEL-NYC GS. Maintien, quotidien et pointures en Suisse.'
        endif
    endcase
  endif

  if request.page_type == 'page'
    case page.handle
      when 'notre-concept'
        assign seo_page_title = 'Notre concept | Resell Lausanne'
        assign seo_page_description = 'Découvrez le concept de Resell Lausanne, boutique suisse spécialisée dans les sneakers, streetwear et collectibles authentiques.'
        if locale_base == 'de'
          assign seo_page_title = 'Unser Konzept | Resell Lausanne'
          assign seo_page_description = 'Entdecken Sie das Konzept von Resell Lausanne — Schweizer Shop für authentische Sneakers, Streetwear und Collectibles.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Our concept | Resell Lausanne'
          assign seo_page_description = 'Discover the Resell Lausanne concept — Swiss store for authentic sneakers, streetwear and collectibles.'
        endif
      when 'livraison', 'livraison-delais', 'faq-livraison'
        assign seo_page_title = 'Livraison & délais | Resell Lausanne'
        assign seo_page_description = 'Retrouvez les informations sur les délais de livraison Resell Lausanne en Suisse et en Europe, le suivi des commandes et les transporteurs utilisés.'
      when 'faq'
        assign seo_page_title = 'FAQ Resell Lausanne — Livraison, retours, paiement & authenticité'
        assign seo_page_description = 'Toutes les réponses à vos questions : délais de livraison, retours, paiement, authenticité et tailles. Resell Lausanne, spécialiste suisse des sneakers.'
        if locale_base == 'de'
          assign seo_page_title = 'FAQ Resell Lausanne — Versand, Retouren, Zahlung & Authentizität'
          assign seo_page_description = 'Antworten zu Versand, Lieferzeiten, Retouren, Zahlung, Authentizität und Grössen. Resell Lausanne — Schweizer Sneaker-Spezialist.'
        elsif locale_base == 'en'
          assign seo_page_title = 'FAQ Resell Lausanne — Shipping, returns, payment & authenticity'
          assign seo_page_description = 'Answers on delivery times, returns, payment, authenticity and sizing. Resell Lausanne — Swiss sneaker specialist.'
        endif
      when 'guide-des-tailles'
        assign seo_page_title = 'Guide des tailles sneakers | Resell Lausanne'
        assign seo_page_description = 'Trouvez votre pointure exacte grâce au guide des tailles Resell Lausanne : Nike, Jordan, Adidas, New Balance, ASICS et plus. Tableaux de conversion EU/US/UK.'
        if locale_base == 'de'
          assign seo_page_title = 'Sneaker-Größentabelle | Resell Lausanne'
          assign seo_page_description = 'Finden Sie Ihre genaue Schuhgröße mit dem Resell Lausanne Größenratgeber: Nike, Jordan, Adidas, New Balance, ASICS und mehr. EU/US/UK-Umrechnungstabellen.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Sneaker size guide | Resell Lausanne'
          assign seo_page_description = 'Find your exact size with the Resell Lausanne size guide: Nike, Jordan, Adidas, New Balance, ASICS and more. EU/US/UK conversion charts.'
        endif
      when 'authenticite'
        assign seo_page_title = 'Authenticité garantie | Resell Lausanne'
        assign seo_page_description = 'Chaque produit Resell Lausanne est contrôlé avant expédition. Découvrez notre processus d'authentification et notre certificat inclus.'
      when 'paiement-securise'
        assign seo_page_title = 'Paiement sécurisé | Resell Lausanne'
        assign seo_page_description = 'Paiement sécurisé par carte, Apple Pay, Twint, PostFinance et Powerpay en Suisse. Transactions chiffrées SSL, données bancaires non stockées.'
      when 'notre-processus-d-authentification'
        assign seo_page_title = 'Processus d'authentification | Resell Lausanne'
        assign seo_page_description = 'Découvrez notre processus de vérification en 5 étapes qui garantit l'authenticité de chaque paire vendue. Zéro contrefaçon, certificat inclus.'
      when 'avis-sur-resell-lausanne'
        assign seo_page_title = 'Avis clients | Resell Lausanne'
        assign seo_page_description = 'Retrouvez tous les avis vérifiés clients Resell Lausanne sur Judge.me, Trustpilot et Google. Fiabilité et satisfaction au cœur de notre service.'
        if locale_base == 'de'
          assign seo_page_title = 'Kundenbewertungen | Resell Lausanne'
          assign seo_page_description = 'Alle verifizierten Kundenbewertungen zu Resell Lausanne auf Judge.me, Trustpilot und Google. Vertrauen und Zufriedenheit stehen im Mittelpunkt unseres Service.'
        elsif locale_base == 'en'
          assign seo_page_title = 'Customer reviews | Resell Lausanne'
          assign seo_page_description = 'Read verified Resell Lausanne customer reviews on Judge.me, Trustpilot and Google. Trust and satisfaction at the heart of our service.'
        endif
      when 'demande-retour'
        assign seo_page_title = 'rl_return_request.seo_title' | t
        assign seo_page_description = 'rl_return_request.seo_description' | t
      when 'contact'
        assign seo_page_title = 'Contact | Resell Lausanne'
        assign seo_page_description = 'Contactez l'équipe Resell Lausanne par e-mail à contact@resell-lausanne.ch. Réponse sous 24 à 48 heures ouvrables.'
    endcase
  endif

  if request.page_type == 'collection'
    assign _rl_handle = collection.handle | downcase
    if locale_base == 'de'
      comment
        DE market (~63% of CH) currently receives untranslated French titles: metafield
        title_tag/description_tag hold French and Shopify does not auto-translate them.
        Generate locale-correct German titles/descriptions for every collection instead.
      endcomment
      assign seo_page_title = collection.title | append: ' kaufen in der Schweiz'
      if seo_page_title.size > 60
        assign seo_page_title = collection.title | append: ' Schweiz'
      endif
      if seo_page_title.size > 60
        assign seo_page_title = collection.title
      endif
      assign seo_page_description = blank
      case _rl_handle
        when 'asics', 'nike', 'adidas', 'new-balance', 'puma', 'salomon', 'on-running', 'on', 'reebok', 'vans', 'converse', 'jordan', 'air-jordan'
          assign _de_brand_title = collection.title | append: ' Schuhe kaufen Schweiz'
          if _de_brand_title.size <= 60
            assign seo_page_title = _de_brand_title
          endif
        when 'onitsuka-tiger', 'onitsuka', 'onitsuka-tokuten'
          assign seo_page_title = 'Onitsuka Tiger Mexico 66 & Tokuten kaufen | Resell Lausanne'
          assign seo_page_description = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano, California 78 und Mexico 66 SD in der Schweiz kaufen. Geprüfte Echtheit, Gratisversand ab 50 CHF.'
      endcase
      if seo_page_description == blank
        assign seo_page_description = collection.title | append: ' in der Schweiz online kaufen: authentische Sneakers & Streetwear, geprüfte Echtheit, schnelle Lieferung, Zertifikat inklusive.'
      endif
      assign seo_page_description = seo_page_description | truncate: 155
    elsif locale_base == 'en'
      assign seo_page_title = collection.title | append: ' — Buy in Switzerland'
      if seo_page_title.size > 60
        assign seo_page_title = collection.title | append: ' — Switzerland'
      endif
      if seo_page_title.size > 60
        assign seo_page_title = collection.title
      endif
      assign seo_page_description = blank
      case _rl_handle
        when 'onitsuka-tiger', 'onitsuka', 'onitsuka-tokuten'
          assign seo_page_title = 'Onitsuka Tiger Mexico 66 & Tokuten — Buy in Switzerland'
          assign seo_page_description = 'Shop authentic Onitsuka Tiger Mexico 66, Tokuten, Serrano, California 78 and Mexico 66 SD in Switzerland. Verified genuine, free delivery from CHF 50.'
      endcase
      if seo_page_description == blank
        assign seo_page_description = collection.title | append: ' in Switzerland: authentic sneakers & streetwear, verified genuine, fast delivery to CH and the EU, certificate included.'
      endif
      assign seo_page_description = seo_page_description | truncate: 155
    else
      if collection.metafields.global.title_tag != blank
        assign seo_page_title = collection.metafields.global.title_tag
      else
        assign seo_title = collection.title | append: ' — Sneakers & Streetwear | ' | append: shop.name
        assign seo_page_title = seo_title
      endif
      if collection.metafields.global.description_tag != blank
        assign seo_page_description = collection.metafields.global.description_tag
      elsif collection.description != blank
        assign seo_page_description = collection.description | strip_html | truncate: 155
      else
        assign seo_page_description = 'Découvrez notre sélection ' | append: collection.title | append: ' — sneakers et streetwear authentiques livrés en Suisse et en Europe. Authenticité garantie.'
      endif
    endif

    if collection.metafields.global.title_tag == blank and locale_base != 'de' and locale_base != 'en'
      case _rl_handle
        when 'air-jordan-x-travis-scott', 'travis-scott'
          assign seo_page_title = 'Travis Scott × Nike — Sneakers authentiques en Suisse | Resell Lausanne'
        when 'essentials', 'fear-of-god-essentials'
          assign seo_page_title = 'Fear of God Essentials — Hoodies, joggers, t-shirts authentiques | Resell Lausanne'
        when 'crampons-de-foot', 'crampons', 'football'
          assign seo_page_title = 'Crampons de foot — Nike, Adidas, éditions limitées | Resell Lausanne'
        when 'chrome-hearts'
          assign seo_page_title = 'Chrome Hearts — Hoodies, t-shirts, bijoux et lunettes authentiques | Resell Lausanne'
        when 'denim-tears'
          assign seo_page_title = "Denim Tears — Cotton Wreath, hoodies, t-shirts et collaborations Levi's, Stüssy, Dior | Resell Lausanne"
        when 'onitsuka-tiger', 'onitsuka', 'onitsuka-tokuten'
          assign seo_page_title = 'Onitsuka Tiger — Mexico 66, Tokuten authentiques | Resell Lausanne'
        when 'adidas-spezial', 'handball-spezial', 'trimm-trab', 'spezial'
          assign seo_page_title = 'Adidas Spezial — Handball Spezial, Trimm Trab, Wensley authentiques | Resell Lausanne'
        when 'nike-air-max-plus-tn', 'air-max-plus', 'tn', 'nike-tn'
          assign seo_page_title = 'Nike TN Air Max Plus — Hyper Blue, Voltage Purple, Corteiz, Patta | Resell Lausanne'
        when 'dunk', 'dunk-low', 'dunk-sb', 'nike-sb-dunk', 'nike-dunk'
          assign seo_page_title = 'Nike Dunk & SB Dunk — Panda, Travis Scott, Chunky Dunky, Lobster authentiques | Resell Lausanne'
        when 'supreme'
          assign seo_page_title = 'Supreme — Box Logo, collaborations Nike, North Face, Stone Island | Resell Lausanne'
        when 'off-white', 'nike-x-off-white'
          assign seo_page_title = 'Off-White — Virgil Abloh, The Ten Nike, hoodies et streetwear authentiques | Resell Lausanne'
        when 'bape', 'a-bathing-ape'
          assign seo_page_title = 'BAPE A Bathing Ape — Shark hoodie, ABC Camo, BAPE STA authentiques | Resell Lausanne'
        when 'labubu', 'pop-mart', 'the-monsters'
          assign seo_page_title = 'Labubu × Pop Mart — Peluches, vinyl et secrets The Monsters | Resell Lausanne'
        when 'air-jordan-4', 'jordan-4'
          assign seo_page_title = 'Air Jordan 4 — Bred, White Cement, Travis Scott, Off-White authentiques | Resell Lausanne'
        when 'asics-gel-kayano-14', 'gel-kayano-14', 'kayano-14'
          assign seo_page_title = 'ASICS Gel-Kayano 14 — Cream Black, White Midnight, Pink Glo, JJJJound authentiques | Resell Lausanne'
        when 'gel-nyc', 'asics-gel-nyc'
          assign seo_page_title = 'ASICS Gel-NYC — Graphite Grey, Cream Rose, Sweet Pink, Pure Silver authentiques | Resell Lausanne'
        when 'asics-double-laces', 'double-laces'
          assign seo_page_title = 'ASICS Gel-NYC Double Laces — Rose, cloud grey & pink authentiques | Resell Lausanne'
        when 'new-balance-204', 'new-balance-204l', 'nb-204l'
          assign seo_page_title = 'New Balance 204L — Mushroom Arid Stone, Kith & coloris authentiques | Resell Lausanne'
        when 'new-balance-1000'
          assign seo_page_title = 'New Balance 1000 — Sneakers authentiques en Suisse | Resell Lausanne'
        when 'gel-1130', 'asics-gel-1130'
          assign seo_page_title = 'ASICS Gel-1130 — Sneakers running lifestyle authentiques | Resell Lausanne'
      endcase
    endif
    if collection.metafields.global.description_tag == blank and locale_base != 'de' and locale_base != 'en'
      case _rl_handle
        when 'air-jordan-x-travis-scott', 'travis-scott'
          assign seo_page_description = 'Achetez vos sneakers Travis Scott en Suisse : Jordan 1 Low Mocha, Reverse Mocha, Olive, Black Phantom, Jumpman Jack, Nike SB Dunk Low. Authentifiées, livrées rapidement.'
        when 'essentials', 'fear-of-god-essentials'
          assign seo_page_description = 'Hoodies, joggers, sweatpants, t-shirts et crewnecks Fear of God Essentials authentiques. Livraison rapide en Suisse, paiement en plusieurs fois.'
        when 'crampons-de-foot', 'crampons', 'football'
          assign seo_page_description = 'Crampons de foot Nike Mercurial, Tiempo, Phantom et Adidas Predator, F50, Copa. Modèles FG, SG, AG, TF authentiques, éditions limitées. Livrés en Suisse.'
        when 'chrome-hearts'
          assign seo_page_description = "Chrome Hearts authentiques en Suisse : hoodies, t-shirts Cross, jeans, bijoux argent 925, lunettes optiques. Authentification multi-points, livraison gratuite."
        when 'denim-tears'
          assign seo_page_description = "Denim Tears Tremaine Emory en Suisse : jeans Cotton Wreath, hoodies, t-shirts et collaborations Levi's, Stüssy, Converse, Dior. Authentifiés et livrés rapidement."
        when 'onitsuka-tiger', 'onitsuka', 'onitsuka-tokuten'
          assign seo_page_description = 'Onitsuka Tiger Mexico 66, Tokuten, Serrano, California 78, Mexico 66 SD et collaborations Naked, Mihara Yasuhiro authentiques. Livraison gratuite dès 50 CHF.'
        when 'adidas-spezial', 'handball-spezial', 'trimm-trab', 'spezial'
          assign seo_page_description = 'Adidas Spezial authentiques : Handball Spezial, Trimm Trab, Wensley, Munchen, Adimatic, Albrecht. Programme Gary Aspden, nubuck premium, livrés en Suisse.'
        when 'nike-air-max-plus-tn', 'air-max-plus', 'tn', 'nike-tn'
          assign seo_page_description = "Nike TN Air Max Plus authentiques : Hyper Blue, Voltage Purple, Volt, Triple Black, Atlanta, Marseille, Corteiz, Patta, Skepta. Livraison gratuite dès 50 CHF."
        when 'dunk', 'dunk-low', 'dunk-sb', 'nike-sb-dunk', 'nike-dunk'
          assign seo_page_description = "Nike Dunk Low et SB Dunk authentiques : Panda, Syracuse, Travis Scott, Ben & Jerry's Chunky Dunky, Lobster, Pigeon, Off-White, Supreme, Tiffany. Livrés en Suisse."
        when 'supreme'
          assign seo_page_description = 'Supreme authentiques en Suisse : Box Logo hoodie, t-shirts, accessoires et collaborations Nike, North Face, Stone Island, Levi’s. Authentifiés, livrés rapidement.'
        when 'off-white', 'nike-x-off-white'
          assign seo_page_description = 'Off-White Virgil Abloh authentiques en Suisse : Nike The Ten (Air Jordan 1, AF1, Dunk Low, Air Max 90/97), hoodies Arrows, Caravaggio, Out of Office, Industrial Belt.'
        when 'bape', 'a-bathing-ape'
          assign seo_page_description = 'BAPE A Bathing Ape authentiques : Shark hoodie, ABC Camo, BAPE STA, Tiger hoodie, Baby Milo et collaborations Nike, Adidas, Louis Vuitton. Livrés en Suisse.'
        when 'labubu', 'pop-mart', 'the-monsters'
          assign seo_page_description = 'Labubu × Pop Mart authentiques en Suisse : peluches Macaron, Big Into Energy, Have a Seat, vinyl secrets, Zimomo, Mokoko. Livraison gratuite, certificat inclus.'
        when 'air-jordan-4', 'jordan-4'
          assign seo_page_description = 'Air Jordan 4 authentiques en Suisse : Bred, White Cement, Military Black, Travis Scott Cactus Jack, Off-White, Union LA, A Ma Maniére, PSG. Livraison gratuite dès 50 CHF.'
        when 'asics-gel-kayano-14', 'gel-kayano-14', 'kayano-14'
          assign seo_page_description = 'ASICS Gel-Kayano 14 authentiques : White Black Midnight, Cream Black, Pink Glo, JJJJound, Kiko Kostadinov, Awake NY. Livraison gratuite dès 50 CHF.'
        when 'gel-nyc', 'asics-gel-nyc'
          assign seo_page_description = 'ASICS Gel-NYC authentiques en Suisse : Graphite Grey Black, Cream Rose Water, Cream Sweet Pink, Pure Silver. Hybride Gel-Nimbus 9 / MC Plus V / Cumulus 16.'
        when 'asics-double-laces', 'double-laces'
          assign seo_page_description = 'ASICS Gel-NYC double lacets authentiques en Suisse : Cream Rose Water, Sweet Pink, Cloud Grey, Pink Glo. Deux jeux de lacets, livraison gratuite, certificat inclus.'
        when 'new-balance-204', 'new-balance-204l', 'nb-204l'
          assign seo_page_description = 'New Balance 204L authentiques en Suisse : Mushroom Arid Stone, Silver Metallic Black, Kith Pink. Semelle ABZORB, livraison gratuite, certificat inclus.'
        when 'gel-1130', 'asics-gel-1130'
          assign seo_page_description = 'ASICS Gel-1130 authentiques en Suisse : sneakers running lifestyle, Y2K, collaborations confidentielles. Livraison gratuite, certificat inclus.'
      endcase
    endif

    if current_page != 1
      if locale_base == 'de'
        assign seo_page_description = collection.title | append: ' — Seite ' | append: current_page | append: ' | Weitere authentische Sneakers & Streetwear bei Resell Lausanne.'
      elsif locale_base == 'en'
        assign seo_page_description = collection.title | append: ' — Page ' | append: current_page | append: ' | More authentic sneakers & streetwear at Resell Lausanne.'
      else
        assign seo_page_description = collection.title | append: ' — Page ' | append: current_page | append: ' | Suite de la sélection authentique sur Resell Lausanne.'
      endif
      assign seo_page_description = seo_page_description | truncate: 155
    endif
  endif

  assign rl_pdp_seo_boosted = false
  if request.page_type == 'product'
    assign _ph = product.handle | downcase
    assign _pt = product.title | downcase
    assign _is_asics_rose = false
    if _ph contains 'gel-nyc'
      if _ph contains 'rose' or _ph contains 'pink' or _ph contains 'sweet-pink' or _ph contains 'barely-rose' or _ph contains 'mineral-beige-pink'
        assign _is_asics_rose = true
      endif
    endif

    if _is_asics_rose
      assign seo_page_title = product.title | append: ' — ASICS Rose Gel-NYC authentique Suisse'
      assign seo_page_description = product.title | append: ' (ASICS rose, Gel-NYC) authentique en Suisse. Tailles EU, livraison gratuite, Twint & Alma 2×–4×. Contrôle d\'authenticité Resell Lausanne.'
      assign rl_pdp_seo_boosted = true
    elsif _ph contains 'double-lace' or _ph contains 'double-laces'
      assign seo_page_title = product.title | append: ' — ASICS Double Laces authentique Suisse'
      assign seo_page_description = product.title | append: ' (ASICS Gel-NYC double lacets) authentique en Suisse. Coloris rose & pink, livraison gratuite, paiement Twint & Alma. Resell Lausanne.'
      assign rl_pdp_seo_boosted = true
    elsif _ph contains 'tokuten'
      assign seo_page_title = product.title | append: ' — Onitsuka Tiger Tokuten authentique Suisse'
      assign seo_page_description = 'Achetez ' | append: product.title | append: ' authentique en Suisse. Onitsuka Tiger Tokuten vérifiée, tailles EU, livraison gratuite, Twint & Alma. Resell Lausanne.'
      assign rl_pdp_seo_boosted = true
    elsif _ph contains 'margiela-replica' or _pt contains 'gats' or _pt contains 'german army trainer'
      assign seo_page_title = product.title | append: ' — Margiela GATS Replica authentique Suisse'
      assign seo_page_description = product.title | append: ' (Margiela GATS, German Army Trainer) authentique en Suisse. Replica MM6 vérifiée, livraison gratuite, Twint & Alma. Resell Lausanne.'
      assign rl_pdp_seo_boosted = true
    endif
  endif

  if request.page_type == 'product' and product.vendor != blank and rl_pdp_seo_boosted == false
    unless product.title contains product.vendor
      assign seo_page_title = product.vendor | append: ' ' | append: seo_page_title
    endunless
  endif

  assign og_title = seo_page_title | default: shop.name
  if request.page_type == 'collection' and current_page != 1
    assign og_title = og_title | append: ' – Page ' | append: current_page
  endif
  assign canonical_href = canonical_url
  if canonical_href == blank
    assign canonical_href = request.origin | append: request.path
  endif
  if request.page_type == 'index' and request.path == '/'
    assign canonical_href = request.origin
  endif
  assign og_url = canonical_href
  assign og_type = 'website'
  assign og_description = seo_page_description | default: shop.description | default: shop.name
  assign robots_content = ''

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign custom_canonicals = shop.metafields.seo.canonicals.value
  if custom_canonicals != blank
    for canonical in custom_canonicals
      if request.path == canonical.url and canonical.origin_url != blank
        assign canonical_href = canonical.origin_url
        break
      endif
    endfor
  endif

  if request.page_type == 'collection'
    assign _rl_collection_handle = collection.handle | downcase
    case _rl_collection_handle
      when 'travis-scott'
        assign canonical_href = request.origin | append: '/collections/air-jordan-x-travis-scott'
      when 'crampons', 'football'
        assign canonical_href = request.origin | append: '/collections/crampons-de-foot'
      when 'new-balance-204'
        assign canonical_href = request.origin | append: '/collections/new-balance-204l'
    endcase
  endif

  assign has_query_candidate = false
  assign query_signature = ''
  assign signature_parts = ''
  assign raw_query_string = request.query_string | default: ''
  if raw_query_string != blank
    assign query_parts = raw_query_string | split: '&'
    for query_part in query_parts
      assign query_part_clean = query_part | strip
      if query_part_clean == blank
        continue
      endif
      assign pair = query_part_clean | split: '='
      assign key = pair.first | downcase
      if key == 'page' or key == 'view' or key == 'fbclid' or key == 'gclid' or key == '_fd' or key == 'pb' or key == 'preview_theme_id' or key == 'section_id' or key contains 'utm_'
        continue
      endif

      assign has_query_candidate = true
      if signature_parts != blank
        assign signature_parts = signature_parts | append: '||'
      endif
      assign signature_parts = signature_parts | append: query_part_clean
    endfor
  endif
  if signature_parts != blank
    assign query_signature = signature_parts | split: '||' | sort | join: '|'
  endif

  if request.page_type == 'collection' and has_query_candidate
    assign whitelist_payload = shop.metafields.seo.facet_index_whitelist.value
    assign allowed_signatures = blank
    assign clean_collection_canonical = canonical_href
    if clean_collection_canonical == blank
      assign clean_collection_canonical = request.origin | append: collection.url
    endif
    if clean_collection_canonical contains '?'
      assign clean_collection_canonical = clean_collection_canonical | split: '?' | first
    endif

    if whitelist_payload != blank
      if whitelist_payload[collection.handle] != blank
        assign allowed_signatures = whitelist_payload[collection.handle]
      elsif whitelist_payload.all != blank
        assign allowed_signatures = whitelist_payload.all
      else
        assign allowed_signatures = whitelist_payload
      endif
    endif

    assign facet_signature_allowed = false
    if allowed_signatures != blank
      for allowed in allowed_signatures
        assign allowed_signature = allowed.signature | default: allowed.query | default: allowed
        if allowed_signature == query_signature
          assign facet_signature_allowed = true
          break
        endif
      endfor
    endif

    if facet_signature_allowed
      assign canonical_href = request.origin | append: request.path | append: '?' | append: raw_query_string
    else
      assign canonical_href = clean_collection_canonical
      assign robots_content = 'noindex,follow'
    endif
  endif

  if request.page_type == 'search'
    assign canonical_href = request.origin | append: routes.search_url
    assign robots_content = 'noindex,follow'
  endif

  if request.page_type == 'collection' and collection.handle == 'all'
    assign robots_content = 'noindex,follow'
  endif

  if request.page_type == 'page' and raw_query_string contains 'category='
    assign robots_content = 'noindex,follow'
  endif

  assign request_url_string = request.url | default: ''
  if request.page_type == 'page' and request_url_string contains 'category='
    assign robots_content = 'noindex,follow'
  endif
  if page.handle == 'faq' and request_url_string contains 'category='
    assign robots_content = 'noindex,follow'
  endif

  if page.handle == 'demande-retour'
    assign robots_content = 'noindex,follow'
  endif


  comment
    Pagination canonical: Shopify's `canonical_url` already includes `?page=N`
    for paginated collection/blog pages. Do NOT append manually — that produced
    invalid canonicals like `/collections/x?page=2?page=2` (Ahrefs: canonical
    points to redirect/invalid URL).
  endcomment

  assign no_indexes = shop.metafields.seo.no_indexes.value
  if no_indexes != blank
    for noindex in no_indexes
      if request.path == noindex.url
        assign robots_content = 'noindex,nofollow'
        break
      endif
    endfor
  endif

  assign og_url = canonical_href
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- liquid
  assign og_locale = request.locale.iso_code | default: 'fr-CH' | replace: '-', '_'
  assign og_img_w = 1200
  assign og_img_h = 630
  if request.page_type == 'product' and product.featured_image != blank
    assign og_img_raw = product.featured_image | image_url: width: 1200, height: 630, crop: 'center'
  elsif page_image != blank
    assign og_img_raw = page_image | image_url: width: 1200, height: 630, crop: 'center'
  elsif settings.share_image != blank
    assign og_img_raw = settings.share_image | image_url: width: 1200, height: 630, crop: 'center'
  elsif settings.logo != blank
    assign og_img_raw = settings.logo | image_url: width: 1200, height: 630, crop: 'center'
  endif
  comment
    Build absolute https URL. In production `image_url` returns an absolute
    `https://cdn.shopify.com/...` URL kept as-is. In dev the Shopify CLI proxy
    rewrites every recognised CDN URL in the response back to a relative
    `/cdn/shop/...` path; the static share-image fallback below ensures the
    og:image always passes the `^https?://` validator check locally.
  endcomment
  assign og_img_abs = blank
  if og_img_raw != blank
    assign og_img_prefix2 = og_img_raw | slice: 0, 2
    if og_img_raw contains '://'
      assign og_img_abs = og_img_raw
    elsif og_img_prefix2 == '//'
      assign og_img_abs = og_img_raw | prepend: 'https:'
    else
      assign og_img_host = shop.url | default: 'https://www.resell-lausanne.ch'
      assign og_img_abs = og_img_raw | prepend: og_img_host
    endif
  endif
  assign og_img_has_scheme = false
  if og_img_abs contains '://'
    assign og_img_has_scheme = true
  endif
  comment
    On dev / staging (Shopify CLI proxies via *.myshopify.com or *.shopifypreview.com)
    the CLI rewrites every recognised Shopify CDN image URL in the response body
    back to a relative `/cdn/shop/...` path. Force a static absolute share image
    so the og:image tag still passes the `^https?://` validator check locally.
    On the primary production domain the dynamic `og_img_abs` from above is kept.
  endcomment
  assign og_host_check = request.host | default: ''
  assign og_fallback_asset = 'logo-fullstack.png' | asset_url
  if settings.logo != blank
    assign og_fallback_asset = settings.logo | image_url: width: 1200, height: 630, crop: 'center'
  elsif settings.share_image != blank
    assign og_fallback_asset = settings.share_image | image_url: width: 1200, height: 630, crop: 'center'
  endif
  unless og_fallback_asset contains '://'
    if og_fallback_asset contains '//'
      assign og_fallback_asset = og_fallback_asset | prepend: 'https:'
    else
      assign og_fallback_asset = og_fallback_asset | prepend: 'https://www.resell-lausanne.ch'
    endif
  endunless
  if og_host_check contains 'myshopify.com' or og_host_check contains 'shopifypreview.com' or og_host_check contains '127.0.0.1' or og_host_check contains 'localhost'
    assign og_img_abs = og_fallback_asset
  elsif og_img_has_scheme == false
    assign og_img_abs = og_fallback_asset
  endif
-%}
<meta property="og:locale" content="{{ og_locale }}">
{%- if og_img_abs != blank %}
  <meta property="og:image" content="{{ og_img_abs }}">
  <meta property="og:image:secure_url" content="{{ og_img_abs }}">
  <meta property="og:image:width" content="{{ og_img_w }}">
  <meta property="og:image:height" content="{{ og_img_h }}">
{% endif %}

{%- liquid
  assign schema_root = shop.url | default: request.origin
  if schema_root contains 'myshopify.com' or schema_root contains 'shopifypreview.com' or schema_root contains '127.0.0.1'
    assign schema_root = 'https://www.resell-lausanne.ch'
  endif
  assign schema_root_last_char = schema_root | slice: -1, 1
  if schema_root_last_char == '/'
    assign schema_root = schema_root | append: 'X' | remove: '/X'
  endif

  assign schema_org_id = 'https://www.resell-lausanne.ch/#organization'
  assign schema_website_id = schema_root | append: '/#website'
  assign schema_lb_id = schema_root | append: '/#localbusiness'

  assign schema_business_street = shop.address.street | default: 'Chemin de Bas-de-Plan 6'
  assign schema_business_city = shop.address.city | default: 'Bussigny'
  assign schema_business_zip = shop.address.zip | default: '1030'
  assign schema_business_region = shop.address.province_code | default: 'VD'
  assign schema_business_country = shop.address.country_code | default: 'CH'
  if schema_business_country.size != 2
    assign schema_business_country = 'CH'
  endif
  assign schema_business_lat = '46.5530'
  assign schema_business_lng = '6.5561'

  assign schema_opens = '10:00'
  assign schema_closes = '19:00'
  assign schema_open_days = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday' | split: ','

  assign schema_returns_policy_url = 'https://www.resell-lausanne.ch/pages/politique-de-retour'
  assign schema_return_policy_id = 'https://www.resell-lausanne.ch/#merchant-return-policy'
  assign schema_price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

  if settings.logo
    assign schema_logo_raw = settings.logo | image_url: width: 600
  else
    assign schema_logo_raw = 'logo-fullstack.png' | asset_url
  endif

  assign schema_logo_url = schema_logo_raw
  if schema_logo_url contains '//'
    unless schema_logo_url contains '://'
      assign schema_logo_url = schema_logo_url | prepend: 'https:'
    endunless
  endif
  if schema_logo_url contains 'shopifypreview.com' or schema_logo_url contains 'myshopify.com'
    assign schema_logo_cdn_parts = schema_logo_url | split: '/cdn/shop/'
    if schema_logo_cdn_parts.size > 1
      assign schema_logo_url = schema_root | append: '/cdn/shop/' | append: schema_logo_cdn_parts.last
    endif
  else
    unless schema_logo_url contains '://'
      assign schema_logo_url = schema_root | append: schema_logo_url
    endunless
  endif

  comment
    Site-level aggregateRating variables removed. Judge.me owns review/rating
    structured data; theme Organization/LocalBusiness no longer emit ratings.
  endcomment

  assign schema_search_url_template = schema_root | append: '/search?q={search_term_string}'
-%}
{% render 'site-schema',
  schema_org_id: schema_org_id,
  schema_website_id: schema_website_id,
  schema_lb_id: schema_lb_id,
  schema_root: schema_root,
  schema_logo_url: schema_logo_url,
  schema_business_street: schema_business_street,
  schema_business_city: schema_business_city,
  schema_business_zip: schema_business_zip,
  schema_business_region: schema_business_region,
  schema_business_country: schema_business_country,
  schema_business_lat: schema_business_lat,
  schema_business_lng: schema_business_lng,
  schema_opens: schema_opens,
  schema_closes: schema_closes,
  schema_open_days: schema_open_days,
  schema_returns_policy_url: schema_returns_policy_url,
  schema_return_policy_id: schema_return_policy_id,
  schema_search_url_template: schema_search_url_template
%}

{%- if request.page_type == 'product' -%}
  {% liquid
    assign schema_product_id = canonical_href | append: '#product'

    assign selected_variant = product.selected_or_first_available_variant
    assign schema_gtin = selected_variant.barcode | default: product.metafields.custom.gtin.value
    assign schema_mpn = selected_variant.sku | default: product.metafields.custom.mpn.value
    assign schema_condition = 'https://schema.org/NewCondition'
    assign raw_condition = product.metafields.custom.condition_label.value | downcase
    if raw_condition contains 'used' or raw_condition contains 'occasion'
      assign schema_condition = 'https://schema.org/UsedCondition'
    elsif raw_condition contains 'refurb'
      assign schema_condition = 'https://schema.org/RefurbishedCondition'
    endif

    comment
      Product-level aggregateRating removed — Judge.me owns review/rating
      structured data. Theme Product schema must not emit standalone Review
      or AggregateRating to avoid "Missing field 'itemReviewed'" Google errors.
    endcomment

    assign schema_product_description = product.description | strip_html | strip
    if rl_pdp_seo_boosted and seo_page_description != blank
      assign schema_product_description = seo_page_description
    endif

    capture schema_price_snapshot
      render 'rs-product-price-snapshot', product: product
    endcapture
    assign schema_price_parts = schema_price_snapshot | strip | split: '|'
    assign schema_product_genuine_free = false
    assign schema_offer_price_current = 0
    if schema_price_parts[6] == '1'
      assign schema_product_genuine_free = true
    endif
    if schema_price_parts[7] == '1'
      assign schema_offer_price_current = schema_price_parts[0] | plus: 0
    elsif schema_price_parts[8] == '1'
      assign schema_offer_price_current = schema_price_parts[2] | plus: 0
    endif
  %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ schema_product_id | json }},
      "name": {{ product.title | json }},
      "url": {{ canonical_href | json }},
      "description": {{ schema_product_description | json }},
      "image": [
        {%- for media in product.media limit: 10 -%}
          {%- if media.preview_image != blank -%}
            {%- if forloop.first == false -%},{%- endif -%}
            {{ media.preview_image | image_url: width: 2048 | prepend: 'https:' | json }}
          {%- endif -%}
        {%- endfor -%}
      ],
      {%- if selected_variant.sku != blank -%}"sku": {{ selected_variant.sku | json }},{%- endif -%}
      {%- if schema_gtin != blank -%}"gtin": {{ schema_gtin | json }},{%- endif -%}
      {%- if schema_mpn != blank -%}"mpn": {{ schema_mpn | json }},{%- endif -%}
      {%- if product.metafields.custom.color != blank -%}"color": {{ product.metafields.custom.color.value | json }},{%- endif -%}
      "additionalProperty": [
        {%- if product.metafields.custom.color != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Couleur",
          "value": {{ product.metafields.custom.color.value | json }}
        },
        {%- endif -%}
        {%- if product.metafields.custom.gender != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Genre",
          "value": {{ product.metafields.custom.gender.value | json }}
        },
        {%- endif -%}
        {%- if product.metafields.custom.style_code != blank -%}
        {
          "@type": "PropertyValue",
          "name": "Code style",
          "value": {{ product.metafields.custom.style_code.value | json }}
        },
        {%- endif -%}
        {
          "@type": "PropertyValue",
          "name": "Taille",
          "value": {{ selected_variant.title | json }}
        }
      ],
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": [
        {%- assign schema_offer_rendered = 0 -%}
        {%- for v in product.variants -%}
          {%- liquid
            capture schema_effective_price_raw
              render 'rs-variant-effective-price', variant: v
            endcapture
            assign schema_effective_price = schema_effective_price_raw | strip | plus: 0
            assign schema_variant_valid = false
            if schema_product_genuine_free and v.available and schema_effective_price == 0
              assign schema_variant_valid = true
            elsif v.available and schema_effective_price > 0
              assign schema_variant_valid = true
            endif
          -%}
          {%- unless schema_variant_valid -%}
            {%- continue -%}
          {%- endunless -%}
          {%- assign schema_offer_rendered = schema_offer_rendered | plus: 1 -%}
          {%- unless schema_offer_rendered == 1 -%},{%- endunless -%}
          {
            "@type": "Offer",
            {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
            "price": "{{ schema_effective_price | divided_by: 100.0 }}",
            "priceCurrency": "CHF",
            "priceValidUntil": {{ schema_price_valid_until | json }},
            "availability": "https://schema.org/InStock",
            "itemCondition": {{ schema_condition | json }},
            "url": "{{ schema_root }}{{ product.url }}?variant={{ v.id }}",
            "hasMerchantReturnPolicy": {
              "@id": {{ schema_return_policy_id | json }}
            },
            {%- liquid
              assign v_has_express = false
              if v.metafields.custom.express_price != blank
                assign exp_mv_schema = v.metafields.custom.express_price.value
                if exp_mv_schema.amount != blank
                  assign exp_amt_schema = exp_mv_schema.amount | times: 1
                  if exp_amt_schema > 0
                    assign v_has_express = true
                  endif
                else
                  assign exp_str_schema = exp_mv_schema | append: '' | strip
                  if exp_str_schema != '' and exp_str_schema != '0'
                    assign v_has_express = true
                  endif
                endif
              endif
            -%}
            "shippingDetails": [
              {
                "@type": "OfferShippingDetails",
                "name": "Livraison standard",
                "shippingDestination": {
                  "@type": "DefinedRegion",
                  "addressCountry": ["CH", "FR", "DE", "IT", "BE", "NL", "AT"]
                },
                "shippingRate": {
                  "@type": "MonetaryAmount",
                  "value": "0",
                  "currency": "CHF"
                },
                "deliveryTime": {
                  "@type": "ShippingDeliveryTime",
                  "handlingTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 0,
                    "maxValue": 1,
                    "unitCode": "DAY"
                  },
                  "transitTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 5,
                    "maxValue": 10,
                    "unitCode": "DAY"
                  }
                }
              }
              {%- if v_has_express -%}
              ,
              {
                "@type": "OfferShippingDetails",
                "name": "Livraison express",
                "shippingDestination": {
                  "@type": "DefinedRegion",
                  "addressCountry": ["CH", "FR", "DE", "IT", "BE", "NL", "AT"]
                },
                "shippingRate": {
                  "@type": "MonetaryAmount",
                  "value": "0",
                  "currency": "CHF"
                },
                "deliveryTime": {
                  "@type": "ShippingDeliveryTime",
                  "handlingTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 0,
                    "maxValue": 1,
                    "unitCode": "DAY"
                  },
                  "transitTime": {
                    "@type": "QuantitativeValue",
                    "minValue": 2,
                    "maxValue": 5,
                    "unitCode": "DAY"
                  }
                }
              }
              {%- endif -%}
            ]
          }
        {%- endfor -%}
      ]
    }
  </script>

  {% if schema_price_parts[7] == '1' or schema_price_parts[8] == '1' %}
    <meta property="og:price:amount" content="{{ schema_offer_price_current | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {% endif %}
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif -%}

{%- if request.page_type == 'page' and page.handle == 'notre-concept' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": {{ seo_page_title | json }},
      "url": {{ canonical_href | json }},
      "description": {{ seo_page_description | json }}
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'page' -%}
  {%- if page.handle == 'redaction' or page.handle == 'auteur' or page.handle == 'author' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": {{ seo_page_title | default: 'Rédaction Resell Lausanne' | json }},
      "url": {{ canonical_href | json }},
      "description": "Équipe éditoriale Resell Lausanne — articles sneakers et streetwear pour le marché suisse."
    }
  </script>
  {%- endif -%}
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_img_abs != blank %}<meta name="twitter:image" content="{{ og_img_abs }}">{%- endif -%}

{%- liquid
  comment
    Title assembly. The brand suffix (" – {shop.name}") is only appended when it
    keeps the full <title> ≤ 60 chars. Previously it was appended unconditionally
    (unless the title already contained the shop name), which re-inflated every
    trimmed collection title and thousands of product titles back over 60 chars
    (Ahrefs "Title too long"). Google shows the site name separately in SERPs and
    truncates ~60 chars anyway, so a brand suffix that would overflow adds no value.
  endcomment
  assign _title_base = seo_page_title | default: page_title
  assign _brand_suffix = ' – ' | append: shop.name
  assign _title_with_brand = _title_base | append: _brand_suffix
  assign _append_brand = false
  unless _title_base contains shop.name
    assign _title_with_brand_len = _title_with_brand | size
    if _title_with_brand_len <= 60
      assign _append_brand = true
    endif
  endunless
-%}
<title>
  {{ _title_base }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if _append_brand %} &ndash; {{ shop.name }}{% endif -%}
</title>

<link rel="canonical" href="{{ canonical_href }}">
{% if robots_content != blank %}
  <meta name="robots" content="{{ robots_content }}">
{% endif %}

{%- liquid
  comment
    Gate hreflang emission. Custom hreflang lives in `snippets/hreflang-tags.liquid`
    and Shopify's native hreflang is stripped in `content-for-header.liquid`.
    Skip hreflang on:
      - noindex pages (collection=all, search, ?category=, demande-retour, facets)
      - 404 pages (Shopify returns canonical=/404 + hreflang to /404 otherwise)
      - alias collections whose canonical is rewritten to a different handle
        (would emit hreflang → non-canonical)
  endcomment
  assign rl_emit_hreflang = true
  if robots_content contains 'noindex'
    assign rl_emit_hreflang = false
  endif
  if request.page_type == 'not_found' or template_name == '404'
    assign rl_emit_hreflang = false
  endif
  if request.page_type == 'collection'
    assign _rl_alias_handle = collection.handle | downcase
    if _rl_alias_handle == 'travis-scott' or _rl_alias_handle == 'crampons' or _rl_alias_handle == 'football'
      assign rl_emit_hreflang = false
    endif
  endif
-%}
{%- if rl_emit_hreflang -%}
  {% render 'hreflang-tags' %}
{%- endif -%}
{%- if page.handle == 'faq' -%}
<script>
  (function () {
    try {
      if (window.location && window.location.search && /(?:[?&])category=/.test(window.location.search)) {
        var existing = document.querySelector('meta[name="robots"]');
        if (existing) {
          existing.setAttribute('content', 'noindex,follow');
        } else {
          var m = document.createElement('meta');
          m.setAttribute('name', 'robots');
          m.setAttribute('content', 'noindex,follow');
          document.head.appendChild(m);
        }
      }
    } catch (e) {}
  })();
</script>
{%- endif -%}

{%- liquid
