    (function () {
      var loaded = false;
      function loadPdpCardModule() {
        if (loaded) return;
        loaded = true;
        import({{ 'product-card.js' | asset_url | json }});
      }
      document.addEventListener('pointerdown', loadPdpCardModule, { once: true, passive: true });
      window.addEventListener('scroll', loadPdpCardModule, { once: true, passive: true });
      if ('requestIdleCallback' in window) {
