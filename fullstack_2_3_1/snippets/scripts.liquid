</script>
<script>
  (function () {
    function getActiveLocalePrefix() {
      const match = window.location.pathname.match(/^\/([a-z]{2})(?:\/|$)/i);
      if (!match) return '';
      const code = (match[1] || '').toLowerCase();
      if (!code || code === 'fr') return '';
      return `/${code}`;
    }

    function shouldSkipLink(anchor, url) {
      if (!anchor || !url) return true;
      if (anchor.hasAttribute('data-no-locale-lock')) return true;
      if (anchor.matches && anchor.matches('link[rel="llms-txt"], link[rel="alternate"][type="text/markdown"]')) return true;
      if (anchor.getAttribute('href') === null) return true;
      if (url.origin !== window.location.origin) return true;
      if (url.pathname === '/llms.txt' || url.pathname === '/agents.md') return true;
      if (url.pathname.indexOf('/cdn/') !== -1) return true;
      const rawHref = anchor.getAttribute('href') || '';
      if (
        rawHref.startsWith('#') ||
        rawHref.startsWith('mailto:') ||
        rawHref.startsWith('tel:') ||
        rawHref.startsWith('javascript:') ||
        rawHref.startsWith('data:') ||
        rawHref.startsWith('https://') ||
        rawHref.startsWith('http://') ||
        rawHref.startsWith('//')
      ) {
        return true;
      }
      return false;
    }

    function isNonLocalizablePath(pathname) {
      if (!pathname || pathname[0] !== '/') return true;
      if (pathname === '/llms.txt' || pathname === '/agents.md') return true;
      if (pathname.indexOf('/cdn/') !== -1) return true;
      var blockedPrefixes = [
        '/cdn/',
        '/checkouts/',
        '/cart',
        '/apps/',
        '/services/',
        '/tools/',
        '/community/',
        '/account',
        '/policies/',
        '/wpm/',
        '/web-pixels/',
      ];
      return blockedPrefixes.some(function (blocked) {
        return pathname === blocked.replace(/\/$/, '') || pathname.indexOf(blocked) === 0;
      });
    }

    function applyLocalePrefixToPath(pathname, prefix) {
      if (!prefix || !pathname || pathname[0] !== '/') return pathname;
      if (isNonLocalizablePath(pathname)) return pathname;
      if (pathname === prefix || pathname.indexOf(`${prefix}/`) === 0) return pathname;
      if (/^\/[a-z]{2}(\/|$)/i.test(pathname)) return pathname;
      return `${prefix}${pathname}`;
    }

    function localizeAnchorHref(anchor, prefix) {
      if (!prefix || !anchor) return false;
      let url;
      try {
        url = new URL(anchor.href, window.location.origin);
      } catch (e) {
        return false;
      }
      if (shouldSkipLink(anchor, url)) return false;
      const localizedPathname = applyLocalePrefixToPath(url.pathname, prefix);
      if (localizedPathname === url.pathname) return false;
      anchor.href = `${localizedPathname}${url.search}${url.hash}`;
      return true;
    }

    function normalizeAllLinks(prefix) {
      if (!prefix) return;
      Array.from(document.links).forEach(function (anchor) {
        localizeAnchorHref(anchor, prefix);
      });
    }

    const localePrefix = getActiveLocalePrefix();
    if (!localePrefix) return;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        normalizeAllLinks(localePrefix);
      });
    } else {
      normalizeAllLinks(localePrefix);
    }

    const pendingNodes = new Set();
    let flushHandle = 0;

    function flushLocalizedNodes() {
      flushHandle = 0;
      pendingNodes.forEach(function (node) {
        if (!(node instanceof Element)) return;
        if (node.matches && node.matches('a[href]')) {
          localizeAnchorHref(node, localePrefix);
        }
        if (node.querySelectorAll) {
          node.querySelectorAll('a[href]').forEach(function (anchor) {
            localizeAnchorHref(anchor, localePrefix);
          });
        }
      });
      pendingNodes.clear();
    }

    function queueLocalizedNode(node) {
      if (!(node instanceof Element)) return;
      pendingNodes.add(node);
      if (flushHandle) return;
      if ('requestIdleCallback' in window) {
        flushHandle = requestIdleCallback(flushLocalizedNodes, { timeout: 700 });
      } else {
        flushHandle = setTimeout(flushLocalizedNodes, 80);
      }
    }

    const observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(queueLocalizedNode);
      });
    });
    observer.observe(document.body || document.documentElement, { childList: true, subtree: true });

    document.addEventListener(
      'click',
      function (event) {
        const anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
        if (!anchor) return;
        let url;
        try {
          url = new URL(anchor.href, window.location.origin);
        } catch (e) {
          return;
        }
        if (shouldSkipLink(anchor, url)) return;
        const localizedPathname = applyLocalePrefixToPath(url.pathname, localePrefix);
        if (localizedPathname === url.pathname) return;
        event.preventDefault();
        window.location.assign(`${localizedPathname}${url.search}${url.hash}`);
      },
      true
    );
  })();
</script>
