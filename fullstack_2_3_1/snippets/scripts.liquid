<link rel="modulepreload" fetchpriority="low" href="{{ 'events.js' | asset_url }}">
{%- endunless -%}

<script type="module" src="{{ 'header.js' | asset_url }}"></script>
{%- if template.name == 'index' -%}
  <script type="module">
    (function () {
      var loaded = false;
      function loadHomeProductModules() {
        if (loaded) return;
        loaded = true;
        import({{ 'product-card.js' | asset_url | json }});
        import({{ 'product-price.js' | asset_url | json }});
      }
      document.addEventListener('pointerdown', loadHomeProductModules, { once: true, passive: true });
      window.addEventListener('scroll', loadHomeProductModules, { once: true, passive: true });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadHomeProductModules, { timeout: 4500 });
      } else {
        setTimeout(loadHomeProductModules, 2500);
      }
    })();
  </script>
{%- elsif template.name == 'product' -%}
