{%- comment -%}
  Load slider engine only when a slider surface exists.
  Keeps non-slider pages lighter while preserving slider behavior where needed.
{%- endcomment -%}
{%- unless template.name == 'index' -%}
  <script type="module">
    (async function () {
      const hasSliderSurface = () =>
        Boolean(document.querySelector('slider-component, .splide, [data-ref="main-slider"]'));

      let loaded = false;
      async function loadSliderModules() {
        if (loaded) return;
        loaded = true;
        await import({{ 'splide.js' | asset_url | json }});
        await import({{ 'slider.js' | asset_url | json }});
      }

      if (hasSliderSurface()) {
        await loadSliderModules();
        return;
      }

      const observer = new MutationObserver(async function () {
        if (!hasSliderSurface()) return;
        observer.disconnect();
        await loadSliderModules();
      });

      observer.observe(document.body || document.documentElement, { childList: true, subtree: true });
      setTimeout(function () {
        observer.disconnect();
      }, 5000);
    })();
  </script>
{%- endunless -%}

{% if settings.activate_wishlist %}
  <script type="module">
    (function () {
      const src = {{ 'wishlist.js' | asset_url | json }};
      let loaded = false;
      let loading = false;

      function loadWishlist() {
        if (loaded || loading) return;
        loading = true;
        import(src)
          .then(() => {
            loaded = true;
          })
          .catch(() => {})
          .finally(() => {
            loading = false;
          });
      }

      function hasWishlistSurface() {
        return Boolean(
          document.querySelector(
            '[data-rl-action="wishlist"], [data-ref="wishlist-drawer"], [data-add-to-wishlist], .swish-add-to-wishlist'
          )
        );
      }

      function onIntent(event) {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (
          target.closest(
            '[data-rl-action="wishlist"], [data-add-to-wishlist], .swish-add-to-wishlist, [href*="liste-de-souhaits"]'
          )
        ) {
          loadWishlist();
        }
      }

      document.addEventListener('pointerdown', onIntent, true);
      document.addEventListener('focusin', onIntent, true);

      if (hasWishlistSurface()) {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadWishlist, { timeout: 3000 });
        } else {
          setTimeout(loadWishlist, 1500);
        }
      }
    })();
  </script>
{% endif %}

<script type="module">
  (function () {
    const modules = [
      {
        key: 'toast-notification',
        src: {{ 'toast-notification.js' | asset_url | json }},
        selector: 'toast-notification',
        idle: true,
      },
      {
        key: 'accordion',
        src: {{ 'accordion.js' | asset_url | json }},
        selector: 'accordion-component, .main-collection__faq details, .rte details',
        idle: true,
      },
      {
        key: 'quantity-selector',
        src: {{ 'quantity-selector.js' | asset_url | json }},
        selector: 'quantity-selector, .quantity-selector',
        idle: true,
      },
      {
        key: 'dropdown',
        src: {{ 'dropdown.js' | asset_url | json }},
        selector: 'dropdown-component, [data-ref=\"dropdown\"]',
        idle: true,
      },
      {
        key: 'popup',
        src: {{ 'popup.js' | asset_url | json }},
        selector: 'dialog-component, [data-ref=\"dialog\"], [data-popup]',
        idle: true,
      },
    ];

    const loaded = new Set();
    const loading = new Set();

    function loadModule(mod) {
      if (!mod || loaded.has(mod.key) || loading.has(mod.key)) return;
      loading.add(mod.key);
      import(mod.src)
        .then(() => {
          loaded.add(mod.key);
        })
        .catch(() => {})
        .finally(() => {
          loading.delete(mod.key);
        });
    }

    function hasSurface(mod) {
      if (!mod || !mod.selector) return false;
      return Boolean(document.querySelector(mod.selector));
    }

    function idleLoad() {
      modules.forEach((mod) => {
        if (mod.idle && hasSurface(mod)) loadModule(mod);
      });
    }

    function intentLoad(target) {
      if (!(target instanceof Element)) return;
      modules.forEach((mod) => {
        if (loaded.has(mod.key) || loading.has(mod.key)) return;
        if (target.closest(mod.selector)) loadModule(mod);
      });
    }

    document.addEventListener(
      'pointerdown',
      (event) => {
        intentLoad(event.target);
      },
      true
    );

    document.addEventListener(
      'focusin',
      (event) => {
        intentLoad(event.target);
      },
      true
    );

    function scheduleDeepIdleLoad() {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(idleLoad, { timeout: 8000 });
      } else {
        setTimeout(idleLoad, 6000);
      }
    }

    if (document.readyState === 'complete') {
      setTimeout(scheduleDeepIdleLoad, 3000);
    } else {
      window.addEventListener(
        'load',
        function () {
          setTimeout(scheduleDeepIdleLoad, 3000);
        },
        { once: true }
      );
    }
  })();
</script>

