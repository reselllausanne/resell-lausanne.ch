<div
  class="
    cart-progress-bar
    {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
    {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
    {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
  "
  style="--margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;"
  {% if request.visual_preview_mode %}
    data-visual-preview-mode
  {% endif %}
  {{ block.shopify_attributes }}
>
  {% liquid
    assign phrase = ''
    assign progress_value_1 = 0
    assign progress_value_2 = 0
    assign progress_value_3 = 0
    assign step1_label = block.settings.step1_label
    assign step2_label = block.settings.step2_label
    assign step3_label = block.settings.step3_label
    assign shipping_unlocked = false
    assign cart_cents = cart.items_subtotal_price | default: cart.total_price | times: 1.0
    assign step1_value = 0
  %}

  {% capture check_icon %}
    {% render 'icon', icon: 'check' %}
  {% endcapture %}

  {% if block.settings.progress_bar_based_on == 'value' %}
    {% comment %}
      Theme setting step*_value = major units (50 = CHF 50).
      cart.total_price / cart.items_subtotal_price = cents (5000 = CHF 50).
      ALWAYS scale settings ×100 before compare. Never compare 50 to cart cents.
      Fill = cart/threshold (progress toward free ship), NOT remaining %.
    {% endcomment %}
    {% assign threshold_major_1 = block.settings.step1_value | default: 0 | abs %}
    {% assign threshold_major_2 = block.settings.step2_value | default: 0 | abs %}
    {% assign threshold_major_3 = block.settings.step3_value | default: 0 | abs %}
    {% assign step1_value = threshold_major_1 | times: 100.0 %}
    {% assign step2_value = threshold_major_2 | times: 100.0 %}
    {% assign step3_value = threshold_major_3 | times: 100.0 %}
    {% comment %} Subtotal after line discounts; matches free-shipping spend better than total w/ fees. {% endcomment %}
    {% assign cart_cents = cart.items_subtotal_price | default: cart.total_price | times: 1.0 %}

    {% assign use_step2 = false %}
    {% if threshold_major_2 > 0 and step2_value > step1_value %}
      {% assign use_step2 = true %}
    {% endif %}
    {% assign use_step3 = false %}
    {% if use_step2 and threshold_major_3 > 0 and step3_value > step2_value %}
      {% assign use_step3 = true %}
    {% endif %}

    {% if step1_value > 0 %}
      {% if cart_cents < step1_value %}
        {% comment %} Below free-shipping threshold: remaining copy + partial fill {% endcomment %}
        {% assign progress_value_1 = cart_cents | times: 100.0 | divided_by: step1_value %}
        {% if progress_value_1 > 100 %}
          {% assign progress_value_1 = 100 %}
        {% endif %}
        {% if progress_value_1 < 0 %}
          {% assign progress_value_1 = 0 %}
        {% endif %}
        {% assign missing_cents = step1_value | minus: cart_cents %}
        {% assign missing_value = missing_cents | money_with_currency %}
        {% if block.settings.step1_text != blank %}
          {% assign phrase = block.settings.step1_text | replace: '#', missing_value %}
        {% endif %}
      {% elsif use_step2 == false %}
        {% comment %} Single-step gauge: at/above threshold → completed + full {% endcomment %}
        {% assign progress_value_1 = 100 %}
        {% assign shipping_unlocked = true %}
        {% assign phrase = block.settings.step_completed_text %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
      {% elsif cart_cents < step2_value %}
        {% assign progress_value_1 = 100 %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% assign progress_remainder = cart_cents | minus: step1_value %}
        {% assign step_value_range_2 = step2_value | minus: step1_value %}
        {% if step_value_range_2 > 0 %}
          {% assign progress_value_2 = progress_remainder | times: 100.0 | divided_by: step_value_range_2 %}
        {% else %}
          {% assign progress_value_2 = 100 %}
        {% endif %}
        {% assign missing_cents = step2_value | minus: cart_cents %}
        {% assign missing_value = missing_cents | money_with_currency %}
        {% if block.settings.step2_text != blank %}
          {% assign phrase = block.settings.step2_text | replace: '#', missing_value %}
        {% endif %}
      {% elsif use_step3 and cart_cents < step3_value %}
        {% assign progress_value_1 = 100 %}
        {% assign progress_value_2 = 100 %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% if step2_label != blank %}
          {% assign step2_label = step2_label | append: check_icon %}
        {% endif %}
        {% assign progress_remainder = cart_cents | minus: step2_value %}
        {% assign step_value_range_3 = step3_value | minus: step2_value %}
        {% if step_value_range_3 > 0 %}
          {% assign progress_value_3 = progress_remainder | times: 100.0 | divided_by: step_value_range_3 %}
        {% else %}
          {% assign progress_value_3 = 100 %}
        {% endif %}
        {% assign missing_cents = step3_value | minus: cart_cents %}
        {% assign missing_value = missing_cents | money_with_currency %}
        {% if block.settings.step3_text != blank %}
          {% assign phrase = block.settings.step3_text | replace: '#', missing_value %}
        {% endif %}
      {% else %}
        {% assign progress_value_1 = 100 %}
        {% assign progress_value_2 = 100 %}
        {% assign progress_value_3 = 100 %}
        {% assign shipping_unlocked = true %}
        {% assign phrase = block.settings.step_completed_text %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% if step2_label != blank %}
          {% assign step2_label = step2_label | append: check_icon %}
        {% endif %}
        {% if step3_label != blank %}
          {% assign step3_label = step3_label | append: check_icon %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% elsif block.settings.progress_bar_based_on == 'quantity' %}
    {% assign step1_quantity = block.settings.step1_quantity %}
    {% assign step2_quantity = block.settings.step2_quantity %}
    {% assign step3_quantity = block.settings.step3_quantity %}

    {% assign number_of_products = 0 %}
    {% if block.settings.collection != blank %}
      {% for item in cart.items %}
        {% for item_collection in item.product.collections %}
          {% if item_collection == block.settings.collection %}
            {% assign number_of_products = number_of_products | plus: item.quantity %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      {% assign number_of_products = cart.item_count %}
    {% endif %}

    {% assign use_qty_step2 = false %}
    {% if step2_quantity != blank and step2_quantity > 0 and step2_quantity > step1_quantity %}
      {% assign use_qty_step2 = true %}
    {% endif %}
    {% assign use_qty_step3 = false %}
    {% if use_qty_step2 and step3_quantity != blank and step3_quantity > 0 and step3_quantity > step2_quantity %}
      {% assign use_qty_step3 = true %}
    {% endif %}

    {% if step1_quantity > 0 %}
      {% if number_of_products < step1_quantity %}
        {% assign progress_value_1 = number_of_products | times: 100.0 | divided_by: step1_quantity %}
        {% assign missing_value = step1_quantity | minus: number_of_products %}
        {% assign phrase = block.settings.step1_text | replace: '#', missing_value %}
      {% elsif use_qty_step2 == false %}
        {% assign progress_value_1 = 100 %}
        {% assign shipping_unlocked = true %}
        {% assign phrase = block.settings.step_completed_text %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
      {% elsif number_of_products < step2_quantity %}
        {% assign progress_value_1 = 100 %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% assign quantity_in_this_step = number_of_products | minus: step1_quantity %}
        {% assign needed_quantity_in_this_step = step2_quantity | minus: step1_quantity %}
        {% if needed_quantity_in_this_step > 0 %}
          {% assign progress_value_2 = quantity_in_this_step | times: 100.0 | divided_by: needed_quantity_in_this_step %}
        {% else %}
          {% assign progress_value_2 = 100 %}
        {% endif %}
        {% assign missing_value = step2_quantity | minus: number_of_products %}
        {% assign phrase = block.settings.step2_text | replace: '#', missing_value %}
      {% elsif use_qty_step3 and number_of_products < step3_quantity %}
        {% assign progress_value_1 = 100 %}
        {% assign progress_value_2 = 100 %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% if step2_label != blank %}
          {% assign step2_label = step2_label | append: check_icon %}
        {% endif %}
        {% assign quantity_in_this_step = number_of_products | minus: step2_quantity %}
        {% assign needed_quantity_in_this_step = step3_quantity | minus: step2_quantity %}
        {% if needed_quantity_in_this_step > 0 %}
          {% assign progress_value_3 = quantity_in_this_step | times: 100.0 | divided_by: needed_quantity_in_this_step %}
        {% else %}
          {% assign progress_value_3 = 100 %}
        {% endif %}
        {% assign missing_value = step3_quantity | minus: number_of_products %}
        {% assign phrase = block.settings.step3_text | replace: '#', missing_value %}
      {% else %}
        {% assign progress_value_1 = 100 %}
        {% assign progress_value_2 = 100 %}
        {% assign progress_value_3 = 100 %}
        {% assign shipping_unlocked = true %}
        {% assign phrase = block.settings.step_completed_text %}
        {% if step1_label != blank %}
          {% assign step1_label = step1_label | append: check_icon %}
        {% endif %}
        {% if step2_label != blank %}
          {% assign step2_label = step2_label | append: check_icon %}
        {% endif %}
        {% if step3_label != blank %}
          {% assign step3_label = step3_label | append: check_icon %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}

  {% assign show_step1 = false %}
  {% if block.settings.progress_bar_based_on == 'value'
    and block.settings.step1_value != null
    and block.settings.step1_value
    and block.settings.step1_value != 0
  %}
    {% assign show_step1 = true %}
  {% elsif block.settings.progress_bar_based_on == 'quantity'
    and block.settings.step1_quantity != null
    and block.settings.step1_quantity
    and block.settings.step1_quantity != 0
  %}
    {% assign show_step1 = true %}
  {% endif %}

  {% if show_step1 %}
    <div
      class="cart-progress-bar__container appear-animation appear-delay-1{% if shipping_unlocked %} is-complete{% endif %}"
      data-progress="{{ progress_value_1 | round }}"
      data-cart-cents="{{ cart_cents | round }}"
      data-threshold-cents="{{ step1_value | round }}"
      data-shipping-unlocked="{{ shipping_unlocked }}"
    >
      {% if phrase != blank %}
        <p class="cart-progress-bar__label">{{ phrase }}</p>
      {% endif %}
      <div class="cart-progress-bar__bar-container">
        <div class="cart-progress-bar__progress-group">
          <div
            class="cart-progress-bar__progress cart-progress-bar__progress_1"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="{{ progress_value_1 | round }}"
          >
            <span class="cart-progress-bar__fill" style="width: {{ progress_value_1 }}%;"></span>
          </div>

          {% if step1_label != blank -%}
            <span class="cart-progress-bar__step-label">{{ step1_label }}</span>
          {%- endif %}
        </div>
        {% assign show_step2 = false %}

        {% if block.settings.progress_bar_based_on == 'value'
          and block.settings.step2_value != null
          and block.settings.step2_value
          and block.settings.step2_value != 0
          and use_step2
        %}
          {% assign show_step2 = true %}
        {% elsif block.settings.progress_bar_based_on == 'quantity'
          and block.settings.step2_quantity != null
          and block.settings.step2_quantity
          and block.settings.step2_quantity != 0
          and use_qty_step2
        %}
          {% assign show_step2 = true %}
        {% endif %}

        {% if show_step2 %}
          <div class="cart-progress-bar__progress-group">
            <div
              class="cart-progress-bar__progress cart-progress-bar__progress_2"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="{{ progress_value_2 | round }}"
            >
              <span class="cart-progress-bar__fill" style="width: {{ progress_value_2 }}%;"></span>
            </div>

            {% if step2_label != blank -%}
              <span class="cart-progress-bar__step-label">{{ step2_label }}</span>
            {% endif %}
          </div>
        {% endif %}
        {% assign show_step3 = false %}

        {% if block.settings.progress_bar_based_on == 'value'
          and block.settings.step3_value != null
          and block.settings.step3_value
          and block.settings.step3_value != 0
          and use_step3
        %}
          {% assign show_step3 = true %}
        {% elsif block.settings.progress_bar_based_on == 'quantity'
          and block.settings.step3_quantity != null
          and block.settings.step3_quantity
          and block.settings.step3_quantity != 0
          and use_qty_step3
        %}
          {% assign show_step3 = true %}
        {% endif %}

        {% if show_step3 %}
          <div class="cart-progress-bar__progress-group">
            <div
              class="cart-progress-bar__progress cart-progress-bar__progress_3"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="{{ progress_value_3 | round }}"
            >
              <span class="cart-progress-bar__fill" style="width: {{ progress_value_3 }}%;"></span>
            </div>

            {% if step3_label != blank -%}
              <span class="cart-progress-bar__step-label">{{ step3_label }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {%- if block.settings.progress_bar_based_on == 'value' and block.settings.step1_value > 0 -%}
        {%- assign shipping_threshold_money = block.settings.step1_value | times: 100.0 | money_without_trailing_zeros -%}
        <p class="cart-progress-bar__footnote">
          Gratuite dès {{ shipping_threshold_money }} en Suisse
        </p>
      {%- endif -%}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:progress_bar",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "select",
      "id": "progress_bar_based_on",
      "label": "t:progress_bar_based_on",
      "options": [
        {
          "value": "value",
          "label": "t:cart_value"
        },
        {
          "value": "quantity",
          "label": "t:cart_quantity"
        }
      ],
      "default": "value"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:collection",
      "info": "t:progress_bar_collection_info"
    },
    {
      "type": "header",
      "content": "t:progress_bar_step1"
    },
    {
      "type": "text",
      "id": "step1_text",
      "label": "t:progress_bar_step_text",
      "default": "t:progress_bar_step1_text_default",
      "info": "t:progress_bar_step_text_info"
    },
    {
      "type": "number",
      "id": "step1_value",
      "label": "t:step_value",
      "default": 30,
      "info": "Major units (50 = CHF 50). Theme multiplies ×100 for cart cents.",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'value' }}"
    },
    {
      "type": "number",
      "id": "step1_quantity",
      "label": "t:step_value",
      "default": 3,
      "visible_if": "{{ block.settings.progress_bar_based_on == 'quantity' }}"
    },
    {
      "type": "text",
      "id": "step1_label",
      "label": "t:progress_bar_step_label"
    },
    {
      "type": "header",
      "content": "t:progress_bar_step2"
    },
    {
      "type": "text",
      "id": "step2_text",
      "label": "t:progress_bar_step_text",
      "info": "t:progress_bar_step_text_info"
    },
    {
      "type": "number",
      "id": "step2_value",
      "label": "t:step_value",
      "info": "t:progress_bar_step_value_info",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'value' }}"
    },
    {
      "type": "number",
      "id": "step2_quantity",
      "label": "t:step_value",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'quantity' }}"
    },
    {
      "type": "text",
      "id": "step2_label",
      "label": "t:progress_bar_step_label"
    },
    {
      "type": "header",
      "content": "t:progress_bar_step3"
    },
    {
      "type": "text",
      "id": "step3_text",
      "label": "t:progress_bar_step_text",
      "info": "t:progress_bar_step_text_info"
    },
    {
      "type": "number",
      "id": "step3_value",
      "label": "t:step_value",
      "info": "t:progress_bar_step_value_info",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'value' }}"
    },
    {
      "type": "number",
      "id": "step3_quantity",
      "label": "t:step_value",
      "visible_if": "{{ block.settings.progress_bar_based_on == 'quantity' }}"
    },
    {
      "type": "text",
      "id": "step3_label",
      "label": "t:progress_bar_step_label"
    },
    {
      "type": "header",
      "content": "t:progress_bar_completed"
    },
    {
      "type": "text",
      "id": "step_completed_text",
      "label": "t:progress_bar_completed_phrase",
      "default": "t:progress_bar_completed_default_phrase",
      "info": "t:progress_bar_default_phrase_info"
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:progress_bar",
      "category": "t:offers"
    }
  ]
}
{% endschema %}
