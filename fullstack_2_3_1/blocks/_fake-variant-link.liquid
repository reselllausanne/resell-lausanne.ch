{% if block.settings.link != blank and block.settings.text != blank %}
  <a
    href="{{ block.settings.link }}"
    class="fake-variant-picker__variant {% if request.path == block.settings.link %}fake-variant-picker__variant--selected{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </a>
{% endif %}

{% schema %}
{
  "name": "t:fake_variant_link",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:text",
      "default": "t:product"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:link"
    }
  ],
  "presets": [
    {
      "name": "t:fake_variant_link",
      "category": "t:product_form",
      "settings": {
        "text": "t:product",
        "link": "#"
      }
    }
  ]
}
{% endschema %}
