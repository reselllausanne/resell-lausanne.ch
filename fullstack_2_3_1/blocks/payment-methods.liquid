<div
  class="
    payment-methods
    {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
    {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
    {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
  "
  style="
    --margin-top: {{ block.settings.margin_top }}px;
    --margin-bottom: {{ block.settings.margin_bottom }}px;
    --icon-size: {{ block.settings.icon_size }}px;
    --alignment: {{ block.settings.alignment_desktop }};
    --alignment-mobile: {{ block.settings.alignment_mobile }};
  "
  {{ block.shopify_attributes }}
  {% if request.visual_preview_mode %}
    data-visual-preview-mode
  {% endif %}
>
  {% if block.settings.show_heading %}
    <p class="payment-methods__label">{{ block.settings.heading | escape }}</p>
  {% endif %}
  <span class="payment-methods__icons">
  {% liquid
    assign pay_id_prefix = 'pi-' | append: block.id | append: '-'
    assign pay_id_token = 'id="pi-'
    assign pay_id_replacement = 'id="' | append: pay_id_prefix
  %}
  {% if settings.force_icons_display == false %}
    {%- for type in shop.enabled_payment_types -%}
      {%- assign pay_svg = type | payment_type_svg_tag -%}
      {%- assign pay_svg = pay_svg | replace: pay_id_token, pay_id_replacement -%}
      {{ pay_svg }}
    {%- endfor -%}
  {% else %}
    {% if settings.show_visa %}
      {%- assign pay_svg = 'visa' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_master %}
      {%- assign pay_svg = 'master' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_maestro %}
      {%- assign pay_svg = 'maestro' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_apple_pay %}
      {%- assign pay_svg = 'apple_pay' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_google_pay %}
      {%- assign pay_svg = 'google_pay' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_paypal %}
      {%- assign pay_svg = 'paypal' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_klarna %}
      {%- assign pay_svg = 'klarna' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_shopify_pay %}
      {%- assign pay_svg = 'shopify_pay' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_american_express %}
      {%- assign pay_svg = 'american_express' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_diners_club %}
      {%- assign pay_svg = 'diners_club' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_discover %}
      {%- assign pay_svg = 'discover' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_twint %}
      {%- assign pay_svg = 'twint' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}

    {% if settings.show_bancontact %}
      {%- assign pay_svg = 'bancontact' | payment_type_svg_tag -%}
      {{ pay_svg | replace: pay_id_token, pay_id_replacement }}
    {% endif %}
  {% endif %}
  </span>
</div>

{% schema %}
{
  "name": "t:payment_methods",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Moyens de paiement",
      "visible_if": "{{ block.settings.show_heading }}"
    },
    {
      "type": "header",
      "content": "t:icons"
    },
    {
      "type": "paragraph",
      "content": "t:payment_methods_info"
    },
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "select",
      "id": "alignment_desktop",
      "label": "t:alignment_desktop",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" }
      ],
      "visible_if": "{{ block.settings.show_on_display != 'mobile_only' }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:alignment_mobile",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:flex-start" },
        { "value": "center", "label": "t:centered" },
        { "value": "flex-end", "label": "t:flex-end" }
      ],
      "visible_if": "{{ block.settings.show_on_display != 'desktop_only' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:icon_size",
      "min": 30,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 35
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:payment_methods",
      "category": "t:footer",
      "settings": {}
    }
  ]
}
{% endschema %}
