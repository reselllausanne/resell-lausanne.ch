<script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>

{% liquid
  assign product = closest.product | default: product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
%}

{% if product.has_only_default_variant == false %}
  {% liquid
    assign locale_iso = request.locale.iso_code | default: localization.language.iso_code | default: 'fr' | downcase
    assign locale_base = locale_iso | split: '-' | first
    assign selection_modal_id = 'size-selection-modal-' | append: section.id
    assign size_selector_label = product.metafields.custom.size_selector_label.value | default: 'Select your size'
    assign size_guide_label = 'Size guide'
    assign size_guide_url = '/pages/guide-des-tailles'
    if pages['guide-des-tailles'] != blank
      assign size_guide_url = pages['guide-des-tailles'].url
    endif
    assign add_to_cart_label = 'products.add_to_cart' | t
    if locale_base == 'fr'
      assign size_selector_label = product.metafields.custom.size_selector_label.value | default: 'Sélectionnez votre taille'
      assign size_guide_label = 'Guide des tailles'
    elsif locale_base == 'de'
      assign size_selector_label = product.metafields.custom.size_selector_label.value | default: 'Wahle deine groesse'
      assign size_guide_label = 'Grossentabelle'
    endif
    capture fit_note_inline
      render 'rs-product-fit-note', product: product
    endcapture
    assign fit_note_inline = fit_note_inline | strip
    assign show_fit_size_guide_link = true
    capture rs_is_sealed_flag
      render 'rs-product-is-sealed-collectible', product: product
    endcapture
    if rs_is_sealed_flag != blank
      assign show_fit_size_guide_link = false
    endif
    assign has_size_modal = false
    assign is_direct_atc = false
    assign size_option_index = -1
    assign size_option_values_count = 0
    assign numeric_option_index = -1
    assign numeric_option_matches = 0
    assign largest_option_values_count = 0

    for option in product.options_with_values
      assign option_values_count = option.values | size
      if option_values_count > largest_option_values_count
        assign largest_option_values_count = option_values_count
      endif

      assign option_has_numeric_value = false
      for option_value in option.values
        assign option_value_token = option_value | append: '' | strip
        assign option_value_token_clean = option_value_token | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: ' ' | remove: '.' | remove: ',' | remove: '/' | remove: '-'
        if option_value_token != blank and option_value_token_clean == blank
          assign option_has_numeric_value = true
          break
        endif
      endfor

      if option_has_numeric_value
        assign numeric_option_matches = numeric_option_matches | plus: 1
        assign numeric_option_index = forloop.index0
      endif
    endfor

    if product.options_with_values.size == 1
      assign size_option_index = 0
    elsif numeric_option_matches == 1
      assign size_option_index = numeric_option_index
    elsif largest_option_values_count > 1
      for option in product.options_with_values
        if option.values.size == largest_option_values_count
          assign size_option_index = forloop.index0
          break
        endif
      endfor
    endif

    if size_option_index >= 0
      assign has_size_modal = true
      for option in product.options_with_values
        if forloop.index0 == size_option_index
          assign size_option_values_count = option.values | size
          break
        endif
      endfor
      if size_option_values_count == 1
        capture rs_express_pricing_flag
          render 'rs-product-has-express-pricing', product: product
        endcapture
        assign rs_express_pricing_flag = rs_express_pricing_flag | strip
        unless rs_express_pricing_flag == 'true'
          assign is_direct_atc = true
        endunless
      endif
    endif
    capture variant_picker_class
      if block.settings.additional_class != blank
        echo block.settings.additional_class
        echo ' '
      endif
      if has_size_modal
        echo 'rs-size-modal-source-picker'
      endif
    endcapture
    assign variant_picker_class = variant_picker_class | strip
  %}
  <variant-picker
    data-product-url="{{ product.url }}"
    {% if is_direct_atc %}data-rs-direct-atc-product{% endif %}
    style="
      --margin-top: {{ block.settings.margin_top }}px;
      --margin-bottom: {{ block.settings.margin_bottom }}px;
    "
    {% if variant_picker_class != blank %}
      class="{{ variant_picker_class }}"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-visual-preview-mode
    {% endif %}
  >
    {% comment %}
      TODO: Product contract.
      Optional metafield with fallback:
      - product.custom.size_selector_label (single_line_text) for localized modal trigger text.
    {% endcomment %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

    <div class="variant-picker__options">
      {% for option in product.options_with_values %}
        {% liquid
          assign is_size_option = false
          if forloop.index0 == size_option_index
            assign is_size_option = true
            assign has_size_modal = true
          endif
        %}
        {% if block.settings.variant_picker_type == 'selects' %}
          <div class="variant-picker__option">
            {% if block.settings.show_option_name and is_size_option == false %}
              <div class="variant-picker__option-name variant_label">
                <span>{{ option.name }} :</span>

                {% # theme-check-disable %}
                {% content_for 'block', type: '_product-variant-popup', id: 'product-variant-popup', option: option %}
                {% # theme-check-enable %}
              </div>
            {% endif %}

            {% if is_size_option %}
              <div class="rs-size-modal__native-size" hidden>
                <div class="select-wrapper select-wrapper--full-width">
                  <select
                    name="option-{{ option.name }}"
                    class="select select--full-width"
                  >
                    {% for value in option.values %}
                      <option
                        value="{{ value }}"
                        {% if value.available == false %}
                          aria-disabled="true"
                        {% endif %}
                        data-option-value-id="{{ value.id }}"
                        {% if value.variant.id %}
                          data-variant-id="{{ value.variant.id }}"
                        {% endif %}
                        {% if value.selected %}
                          selected
                        {% endif %}
                      >
                        {{ value }}
                        {% if value.available == false %}
                          ({{ 'products.sold_out' | t }})
                        {% endif %}
                      </option>
                    {% endfor %}
                  </select>
                  <div class="select-wrapper__icon">
                    {% render 'icon', icon: 'keyboard_arrow_down' %}
                  </div>
                </div>
              </div>
              {% if is_direct_atc %}
                <div class="rs-size-modal__trigger-wrap rs-size-modal__trigger-wrap--direct-atc">
                  <button
                    type="button"
                    class="rs-size-modal__trigger rs-size-modal__trigger--direct-atc"
                    data-rs-direct-atc
                    data-rs-size-modal-target="{{ selection_modal_id }}"
                  >
                    {{ add_to_cart_label }}
                  </button>
                  <div class="rs-size-modal__fit-note-box{% unless show_fit_size_guide_link %} rs-size-modal__fit-note-box--no-guide{% endunless %}">
                    <p class="rs-size-modal__fit-note-inline">{{ fit_note_inline | escape }}</p>
                    {% if show_fit_size_guide_link %}
                      <a
                        class="rs-size-modal__fit-note-link"
                        href="{{ size_guide_url }}"
                      >
                        {{ size_guide_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="rs-size-modal__trigger-wrap">
                  <button
                    type="button"
                    class="rs-size-modal__trigger"
                    data-rs-size-modal-open="{{ selection_modal_id }}"
                    aria-controls="{{ selection_modal_id }}"
                    aria-haspopup="dialog"
                  >
                    {{ size_selector_label }}
                  </button>
                  <div class="rs-size-modal__fit-note-box{% unless show_fit_size_guide_link %} rs-size-modal__fit-note-box--no-guide{% endunless %}">
                    <p class="rs-size-modal__fit-note-inline">{{ fit_note_inline | escape }}</p>
                    {% if show_fit_size_guide_link %}
                      <a
                        class="rs-size-modal__fit-note-link"
                        href="{{ size_guide_url }}"
                      >
                        {{ size_guide_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% else %}
              <div class="select-wrapper select-wrapper--full-width">
                <select
                  name="option-{{ option.name }}"
                  class="select select--full-width"
                >
                  {% for value in option.values %}
                    <option
                      value="{{ value }}"
                      {% if value.available == false %}
                        aria-disabled="true"
                      {% endif %}
                      data-option-value-id="{{ value.id }}"
                      {% if value.variant.id %}
                        data-variant-id="{{ value.variant.id }}"
                      {% endif %}
                      {% if value.selected %}
                        selected
                      {% endif %}
                    >
                      {{ value }}
                      {% if value.available == false %}
                        ({{ 'products.sold_out' | t }})
                      {% endif %}
                    </option>
                  {% endfor %}
                </select>
                <div class="select-wrapper__icon">
                  {% render 'icon', icon: 'keyboard_arrow_down' %}
                </div>
              </div>
            {% endif %}
          </div>
        {% elsif block.settings.variant_picker_type == 'buttons' %}
          <fieldset class="variant-picker__option">
            {% if block.settings.show_option_name and is_size_option == false %}
              <div class="variant-picker__option-name variant_label">
                <span>{{ option.name }} :</span>

                {% # theme-check-disable %}
                {% content_for 'block', type: '_product-variant-popup', id: 'product-variant-popup', option: option %}
                {% # theme-check-enable %}
              </div>
            {% endif %}

            {% if is_size_option %}
              <div class="rs-size-modal__native-size" hidden>
                <div class="variant-picker__option-values">
                  {% liquid
                    assign native_swatches_count = option.values | map: 'swatch' | compact | size

                    assign custom_product_metafields_swatches_count = 0
                    for color in product.metafields.custom.colors.value
                      for value in option.values
                        if color.label == value
                          assign custom_product_metafields_swatches_count = custom_product_metafields_swatches_count | plus: 1
                        endif
                      endfor
                    endfor
                    for i in (1..5)
                      assign metafield_color_key = 'colors' | append: i
                      assign metafield_colors = product.metafields.custom[metafield_color_key].value
                      for color in metafield_colors
                        for value in option.values
                          if color.label == value
                            assign custom_product_metafields_swatches_count = custom_product_metafields_swatches_count | plus: 1
                          endif
                        endfor
                      endfor
                    endfor

                    assign custom_variants_metafields_swatches_count = 0
                    for product_variant in product.variants
                      if product_variant.metafields.color.hexcode != blank or product_variant.metafields.color.image != blank
                        assign custom_variants_metafields_swatches_count = custom_variants_metafields_swatches_count | plus: 1
                      endif
                    endfor

                    if block.settings.show_swatches
                      if native_swatches_count > 0
                        render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'native', swatches_for_product_card: false

                      elsif custom_product_metafields_swatches_count > 0
                        render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'custom_product_metafields', swatches_for_product_card: false

                      elsif custom_variants_metafields_swatches_count > 0
                        render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'custom_variants_metafields', swatches_for_product_card: false

                      else
                        for value in option.values
                          render 'product-option-value-button', option: option, value: value
                        endfor
                      endif
                    else
                      for value in option.values
                        render 'product-option-value-button', option: option, value: value
                      endfor
                    endif
                  %}
                </div>
              </div>
              {% if is_direct_atc %}
                <div class="rs-size-modal__trigger-wrap rs-size-modal__trigger-wrap--direct-atc">
                  <button
                    type="button"
                    class="rs-size-modal__trigger rs-size-modal__trigger--direct-atc"
                    data-rs-direct-atc
                    data-rs-size-modal-target="{{ selection_modal_id }}"
                  >
                    {{ add_to_cart_label }}
                  </button>
                  <div class="rs-size-modal__fit-note-box{% unless show_fit_size_guide_link %} rs-size-modal__fit-note-box--no-guide{% endunless %}">
                    <p class="rs-size-modal__fit-note-inline">{{ fit_note_inline | escape }}</p>
                    {% if show_fit_size_guide_link %}
                      <a
                        class="rs-size-modal__fit-note-link"
                        href="{{ size_guide_url }}"
                      >
                        {{ size_guide_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="rs-size-modal__trigger-wrap">
                  <button
                    type="button"
                    class="rs-size-modal__trigger"
                    data-rs-size-modal-open="{{ selection_modal_id }}"
                    aria-controls="{{ selection_modal_id }}"
                    aria-haspopup="dialog"
                  >
                    {{ size_selector_label }}
                  </button>
                  <div class="rs-size-modal__fit-note-box{% unless show_fit_size_guide_link %} rs-size-modal__fit-note-box--no-guide{% endunless %}">
                    <p class="rs-size-modal__fit-note-inline">{{ fit_note_inline | escape }}</p>
                    {% if show_fit_size_guide_link %}
                      <a
                        class="rs-size-modal__fit-note-link"
                        href="{{ size_guide_url }}"
                      >
                        {{ size_guide_label }}
                      </a>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% else %}
              <div class="variant-picker__option-values">
                {% liquid
                  assign native_swatches_count = option.values | map: 'swatch' | compact | size

                  assign custom_product_metafields_swatches_count = 0
                  for color in product.metafields.custom.colors.value
                    for value in option.values
                      if color.label == value
                        assign custom_product_metafields_swatches_count = custom_product_metafields_swatches_count | plus: 1
                      endif
                    endfor
                  endfor
                  for i in (1..5)
                    assign metafield_color_key = 'colors' | append: i
                    assign metafield_colors = product.metafields.custom[metafield_color_key].value
                    for color in metafield_colors
                      for value in option.values
                        if color.label == value
                          assign custom_product_metafields_swatches_count = custom_product_metafields_swatches_count | plus: 1
                        endif
                      endfor
                    endfor
                  endfor

                  assign custom_variants_metafields_swatches_count = 0
                  for product_variant in product.variants
                    if product_variant.metafields.color.hexcode != blank or product_variant.metafields.color.image != blank
                      assign custom_variants_metafields_swatches_count = custom_variants_metafields_swatches_count | plus: 1
                    endif
                  endfor

                  if block.settings.show_swatches
                    if native_swatches_count > 0
                      render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'native', swatches_for_product_card: false

                    elsif custom_product_metafields_swatches_count > 0
                      render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'custom_product_metafields', swatches_for_product_card: false

                    elsif custom_variants_metafields_swatches_count > 0
                      render 'product-swatches', option: option, swatches_size: block.settings.swatches_size, swatches_rounded: block.settings.swatches_rounded, swatch_source: 'custom_variants_metafields', swatches_for_product_card: false

                    else
                      for value in option.values
                        render 'product-option-value-button', option: option, value: value
                      endfor
                    endif
                  else
                    for value in option.values
                      render 'product-option-value-button', option: option, value: value
                    endfor
                  endif
                %}
              </div>
            {% endif %}
          </fieldset>
        {% endif %}
      {% endfor %}
    </div>

    <script type="application/json">
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-picker>
{% else %}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
{% endif %}

{% schema %}
{
  "name": "t:product_variant_picker",
  "tag": null,
  "blocks": [],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_option_name",
      "label": "t:show_option_name",
      "default": true
    },
    {
      "type": "select",
      "id": "variant_picker_type",
      "label": "t:variant_picker_type",
      "options": [
        {
          "value": "buttons",
          "label": "t:buttons"
        },
        {
          "value": "selects",
          "label": "t:selects"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:show_swatches",
      "default": true,
      "visible_if": "{{ block.settings.variant_picker_type == 'buttons' }}",
      "info": "t:show_swatches_info"
    },
    {
      "type": "select",
      "id": "swatches_size",
      "label": "t:swatches_size",
      "options": [
        {
          "value": "small",
          "label": "t:small"
        },
        {
          "value": "normal",
          "label": "t:normal"
        },
        {
          "value": "big",
          "label": "t:big"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.show_swatches and block.settings.variant_picker_type == 'buttons' }}"
    },
    {
      "type": "checkbox",
      "id": "swatches_rounded",
      "label": "t:swatches_rounded",
      "default": true,
      "visible_if": "{{ block.settings.show_swatches and block.settings.variant_picker_type == 'buttons' }}"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide link",
      "default": false,
      "info": "Deprecated — use Guide des tailles inside the size selection modal."
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 10,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:product_variant_picker",
      "category": "t:product_form"
    }
  ]
}
{% endschema %}
