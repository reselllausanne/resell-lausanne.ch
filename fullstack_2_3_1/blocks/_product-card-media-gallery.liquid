{% doc %}
  Affiche une galerie de médias pour une carteproduit.
{% enddoc %}

{% assign product = closest.product -%}

{% liquid
  # Détermine l'image à afficher en priorité selon la variante filtrée
  assign selected_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media

  if selected_variant.featured_media != blank
    assign featured_media = selected_variant.featured_media
  endif
  if featured_media != blank
    assign pdp_preload_image_url = featured_media.preview_image | image_url: width: 1000
  endif

  assign is_search_context = false
  assign disable_card_slider = false
  if request.page_type == 'search'
    assign is_search_context = true
    assign card_image_width = 260
    assign card_image_widths = '180, 260, 360'
    assign card_slider_extra_media_limit = 0
    assign disable_card_slider = true
  elsif request.page_type == 'collection'
    assign card_image_width = 420
    assign card_image_widths = '280, 420, 560, 720'
    assign card_slider_extra_media_limit = 0
    assign disable_card_slider = true
  else
    assign card_image_width = 600
    assign card_image_widths = '300, 450, 600, 750, 900'
    assign card_slider_extra_media_limit = 99
  endif
  assign card_image_sizes = '(min-width: 750px) 25vw, 50vw'

  # PLP: fixed ratio so every card same height (adapt follows each file → misaligned grid)
  assign card_media_ratio_setting = block.settings.media_ratio
  if request.page_type == 'collection'
    assign card_media_ratio_setting = '4 / 3'
  endif

  assign defer_card_slider_init = false
  if request.page_type == 'collection' or request.page_type == 'search'
    assign defer_card_slider_init = true
  endif

  assign card_priority_rank = 0
  if request.page_type == 'collection'
    for priority_product in collection.products limit: 4
      if priority_product.id == product.id
        assign card_priority_rank = forloop.index
        break
      endif
    endfor
  elsif request.page_type == 'search'
    assign priority_product_count = 0
    for priority_result in search.results
      if priority_result.object_type == 'product'
        assign priority_product_count = priority_product_count | plus: 1
        if priority_product_count <= 1 and priority_result.id == product.id
          assign card_priority_rank = priority_product_count
          break
        endif
        if priority_product_count >= 1
          break
        endif
      endif
    endfor
  endif

  assign card_image_loading = 'lazy'
  assign card_image_fetchpriority = 'auto'
  assign card_image_preload = false
  assign card_image_decoding = 'async'
  if card_priority_rank > 0
    assign card_image_loading = 'eager'
  endif
  if card_priority_rank == 1
    assign card_image_fetchpriority = 'high'
    assign card_image_decoding = 'sync'
  elsif request.page_type == 'collection' and card_priority_rank <= 4
    assign card_image_fetchpriority = 'low'
  endif
%}

<product-card-media-gallery
  class="
    product-card-media-gallery-block
    {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
    {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
    {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
  "
  {{ block.shopify_attributes }}
  {% if request.visual_preview_mode %}
    data-visual-preview-mode
  {% endif %}
>
  {% if block.settings.show_slider and product.media.size > 1 and disable_card_slider == false %}
    <slider-component
      data-per-page-mobile="1"
      data-per-page-desktop="1"
      data-gap="5"
      data-show-arrows="true"
      data-show-pagination="false"
      data-show-arrows-mobile="true"
      data-show-pagination-mobile="false"
      data-rewind="false"
      data-auto-height="false"
      style="--margin-top: 0px; --margin-bottom: 0px;"
      class="product-card-media-gallery"
      {% if defer_card_slider_init %}
        data-defer-init
      {% endif %}
    >
      <div class="splide" role="group" data-ref="main-slider">
        <div class="splide__arrows">
          <button class="splide__arrow splide__arrow--prev">
            {% render 'icon', icon: 'arrow_back' %}
          </button>
          <button class="splide__arrow splide__arrow--next">
            {% render 'icon', icon: 'arrow_forward' %}
          </button>
        </div>

        <div class="splide__track">
          <ul class="splide__list">
            {% comment %} Affiche l'image de la variante sélectionnée en premier {% endcomment %}
            <li
              class="
                splide__slide
                product-card-media-gallery__media
                {%- if block.settings.media_rounded %} product-card-media-gallery__media--rounded{% endif -%}
              "
            >
              {% if card_media_ratio_setting == 'adapt' %}
                {% assign ratio = featured_media.aspect_ratio %}
              {% else %}
                {% assign ratio = card_media_ratio_setting %}
              {% endif %}

              <a href="{{ product.url }}" class="product-card-media-gallery__link" tabindex="-1" aria-label="{{ product.title | escape }}"{% if pdp_preload_image_url != blank %} data-pdp-preload="{{ pdp_preload_image_url }}"{% endif %}>
                {% render 'product-media',
                  alt_fallback: product.title,
                  media: featured_media,
                  show_video: false,
                  ratio: ratio,
                loading: card_image_loading,
                fetchpriority: card_image_fetchpriority,
                preload: card_image_preload,
                decoding: card_image_decoding,
                  image_width: card_image_width,
                  widths: card_image_widths,
                  sizes: card_image_sizes
                %}
              </a>
            </li>

            {% comment %} Puis les autres médias (en excluant celui déjà affiché) {% endcomment %}
            {% assign extra_media_count = 0 %}
            {% for media in product.media %}
              {% if extra_media_count >= card_slider_extra_media_limit %}
                {% break %}
              {% endif %}
              {% if media.id != featured_media.id %}
                <li
                  class="
                    splide__slide
                    product-card-media-gallery__media
                    {%- if block.settings.media_rounded %} product-card-media-gallery__media--rounded{% endif -%}
                  "
                >
                  {% if card_media_ratio_setting == 'adapt' %}
                    {% assign ratio = media.aspect_ratio %}
                  {% else %}
                    {% assign ratio = card_media_ratio_setting %}
                  {% endif %}

                  <a href="{{ product.url }}" class="product-card-media-gallery__link" tabindex="-1" aria-label="{{ product.title | escape }}"{% if pdp_preload_image_url != blank %} data-pdp-preload="{{ pdp_preload_image_url }}"{% endif %}>
                    {% render 'product-media',
                      alt_fallback: product.title,
                      media: media,
                      show_video: false,
                      ratio: ratio,
                      loading: 'lazy',
                      image_width: card_image_width,
                      widths: card_image_widths,
                      sizes: card_image_sizes
                    %}
                  </a>
                </li>
                {% assign extra_media_count = extra_media_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </slider-component>
  {% else %}
    <a
      href="{{ product.url }}"
      class="
        product-card-media-gallery__link
        product-card-media-gallery__media
        {%- if block.settings.media_rounded %} product-card-media-gallery__media--rounded{% endif -%}
      "
      aria-label="{{ product.title | escape }}"
      {% if pdp_preload_image_url != blank %}data-pdp-preload="{{ pdp_preload_image_url }}"{% endif %}
    >
      {% if card_media_ratio_setting == 'adapt' %}
        {% assign ratio = featured_media.aspect_ratio %}
      {% else %}
        {% assign ratio = card_media_ratio_setting %}
      {% endif %}

      {% render 'product-media',
        alt_fallback: product.title,
        media: featured_media,
        show_video: false,
        ratio: ratio,
        loading: card_image_loading,
        fetchpriority: card_image_fetchpriority,
        preload: card_image_preload,
        decoding: card_image_decoding,
        image_width: card_image_width,
        widths: card_image_widths,
        sizes: card_image_sizes
      %}
    </a>
  {% endif %}

  {% if block.settings.show_badges %}
    {% render 'product-card-promotional-pictos', product: product %}
    {% render 'product-badges', product: product, skip_sales_badge: true %}
  {% endif %}

  {% if settings.activate_wishlist %}
    <div class="product-card-media-gallery__add-to-wishlist-button">
      {% render 'add-to-wishlist-button', product: product, small: true, border: false, block: block %}
    </div>
  {% endif %}
</product-card-media-gallery>

{% stylesheet %}
  .product-card-media-gallery-block {
    position: relative;
  }

  .product-card-media-gallery__link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .main-search__products-grid .product-card-promotional-pictos__picto {
    top: 6px;
  }

  .product-card-media-gallery .splide__slide {
    margin-right: var(--card-padding) !important;
  }

  .product-card-media-gallery .splide__arrow {
    background-color: transparent;
    border: none;
  }

  .product-card-media-gallery[data-rl-deferred-slider='true'] .splide__arrow {
    opacity: 0;
    pointer-events: none;
  }

  .product-card-media-gallery__media {
    height: auto;
  }

  .product-card-media-gallery__media .product-media {
    background-color: rgb(var(--color-background-rgb, 255 255 255));
  }

  .main-collection__products-grid .product-card-media-gallery__media .product-media img {
    object-fit: contain;
    object-position: center;
  }

  .main-search__products-grid .product-card-media-gallery__media {
    height: auto;
  }

  .product-card-media-gallery__media--rounded {
    border-radius: var(--card-border-radius);
    overflow: hidden;
  }

  .product-card.card .product-card-media-gallery__media--rounded {
    border-radius: calc(var(--card-border-radius) - (var(--card-padding) * 0.5));
  }

  .slider-component--65-percent product-card-media-gallery .splide__list {
    width: 100%;
  }

  .product-card-media-gallery__add-to-wishlist-button {
    position: absolute;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    bottom: var(--padding-xs);
    right: var(--padding-xs);
    background-color: transparent;
  }

  .product-card-media-gallery__add-to-wishlist-button .button {
    background-color: transparent;
  }

  @media (width > 750px) {
    product-card-media-gallery .splide__arrow,
    product-card-media-gallery .splide__arrow:disabled {
      opacity: 0;
      transition: opacity 0.2s ease-in-out;
    }

    product-card:hover product-card-media-gallery .splide__arrow {
      opacity: 1;
    }

    product-card:hover product-card-media-gallery .splide__arrow:disabled {
      opacity: 0.5;
    }

    .product-card-media-gallery__add-to-wishlist-button {
      opacity: 0;
      transition: opacity 0.2s ease-in-out;
    }

    .product-card:hover .product-card-media-gallery__add-to-wishlist-button {
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_card_gallery",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_slider",
      "label": "t:show_slider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "media_rounded",
      "label": "t:media_rounded",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:show_badges",
      "default": true
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:media_ratio",
      "options": [
        { "value": "1 / 1", "label": "t:square" },
        { "value": "4 / 5", "label": "t:portrait" },
        { "value": "4 / 3", "label": "t:landscape" },
        { "value": "adapt", "label": "t:adapt" }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:badges"
    },
    {
      "type": "paragraph",
      "content": "SOLDES picto: custom.soldes_48h. 48h picto: in-stock custom.delivery_48h (wins over express). Express picto: in-stock express_price / express_available when no 48h."
    },
    {
      "type": "paragraph",
      "content": "t:product_card_gallery_badges_info"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:product_card_gallery",
      "category": "t:product"
    }
  ]
}
{% endschema %}
