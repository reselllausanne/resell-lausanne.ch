<script src="{{ "cross-sell.js" | asset_url }}" type="module"></script>

{% liquid
  assign bundle_products = block.settings.products

  if request.visual_preview_mode
    assign bundle_products = collections.all.products | where: 'available'
  endif

  # calcul des prix des produits
  assign price = 0
  assign compare_at_price = 0
  assign bundle_size = 0
  assign all_available = true

  for bundle_product in bundle_products
    capture bundle_price_snapshot
      render 'rs-product-price-snapshot', product: bundle_product
    endcapture
    assign bundle_price_parts = bundle_price_snapshot | strip | split: '|'
    assign bundle_current_present = bundle_price_parts[7]
    assign bundle_current_price = 0
    assign bundle_current_compare = 0
    if bundle_current_present == '1'
      assign bundle_current_price = bundle_price_parts[0] | plus: 0
      assign bundle_current_compare = bundle_price_parts[1] | plus: 0
    endif

    # check si le produit est disponible
    if bundle_product.selected_or_first_available_variant.available == false or bundle_current_present == false
      assign all_available = false
    endif

    if forloop.index == 1
      assign first_product = bundle_product
    endif

    assign bundle_size = bundle_size | plus: 1
    assign price = price | plus: bundle_current_price

    if bundle_current_compare > bundle_current_price and bundle_current_compare > 0
      assign compare_at_price = compare_at_price | plus: bundle_current_compare
    else
      assign compare_at_price = compare_at_price | plus: bundle_current_price
    endif

    if request.visual_preview_mode and forloop.first and block.settings.title != 'Bundle'
      break
    endif
  endfor

  # check si le block.settings.image est vide
  assign show_dynamic_variant_image = true

  if block.settings.image != blank
    assign show_dynamic_variant_image = false
  endif

  if bundle_size > 1
    assign show_dynamic_variant_image = false
  endif
%}

{% if bundle_size > 0 %}
  <cross-sell-component
    data-dynamic-variant-image="{{ show_dynamic_variant_image }}"
    data-product-handle="{{ first_product.handle }}"
    style="
      --margin-top: {{ block.settings.margin_top }}px;
      --margin-bottom: {{ block.settings.margin_bottom }}px;
      --image-width: {{ block.settings.image_width }}px;
    "
    class="
      cross-sell--{{ block.settings.display_mode }}
      {%- if block.settings.show_on_display == 'desktop_only' %} mobile-hide{% endif -%}
      {%- if block.settings.show_on_display == 'mobile_only' %} desktop-hide{% endif -%}
      {%- if block.settings.additional_class != blank %} {{ block.settings.additional_class }}{% endif -%}
    "
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-visual-preview-mode
    {% endif %}
  >
    <div
      class="cross-sell card{% if block.settings.show_card_border %} card--with-border{% endif %} color-{{ block.settings.color_scheme }}{% if block.settings.show_image == false %} cross-sell--no-image{% endif %}"
    >
      {% if block.settings.show_image %}
        {% assign image_src = '' %}
        {% assign image_alt = '' %}

        {%- if block.settings.image != blank -%}
          {% assign image_src = block.settings.image %}
          {% assign image_alt = block.settings.image.alt %}
        {%- else -%}
          {%- if first_product.selected_or_first_available_variant.featured_image != blank -%}
            {% assign image_src = first_product.selected_or_first_available_variant.featured_image %}
            {% assign image_alt = first_product.selected_or_first_available_variant.featured_image.alt %}
          {%- else -%}
            {% assign image_src = first_product.featured_image %}
            {% assign image_alt = first_product.featured_image.alt %}
          {%- endif -%}
        {%- endif -%}

        <img
          class="cross-sell__image"
          src="{{ image_src | image_url: width: 300 }}"
          width="100"
          height="auto"
          loading="lazy"
          alt="{{ image_alt }}"
          data-ref="cross-sell-image"
        >
      {% endif %}

      <div class="cross-sell__content">
        <div class="cross-sell__heading">
          <div class="cross-sell__title-and-description">
            <p class="cross-sell__title">
              {% if block.settings.title != blank %}
                {{ block.settings.title }}
              {% else %}
                {{ first_product.title }}
              {% endif %}
            </p>

            {% if block.settings.price_position == 'below_title' %}
              {% render 'price', price: price, compare_price: compare_at_price, sales_badge: 'none' %}
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="cross-sell__description">
                {{ block.settings.description }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.price_position == 'next_to_title' %}
            {% render 'price', price: price, compare_price: compare_at_price, sales_badge: 'none' %}
          {% endif %}
        </div>

        <div class="cross-sell__actions">
          <div class="cross-sell__selects">
            {% for bundle_product in bundle_products %}
              <div class="cross-sell__select{% if bundle_product.variants.size == 1 %} hidden{% endif %}">
                {% if block.settings.show_options_label %}
                  <label class="cross-sell__select-label">
                    {% for option in bundle_product.options_with_values %}
                      {{ option.name -}}
                      {%- if forloop.last == false %} / {% endif %}
                      {%- if forloop.last %}:{% endif %}
                    {% endfor -%}
                  </label>
                {% endif %}

                <div class="select-wrapper select-wrapper--full-width">
                  <select
                    name="cross-sell__select-{{ bundle_product.id }}"
                    class="select select--full-width select--small"
                    {% if bundle_product.id %}
                      id="{{ bundle_product.id }}"
                    {% endif %}
                    data-handle="{{ bundle_product.handle }}"
                    data-ref="variant-select"
                    data-price="{{ bundle_current_price }}"
                    data-compare-at-price="{{ bundle_current_compare }}"
                  >
                    {% for variant in bundle_product.variants %}
                      {%- capture bundle_variant_effective_price_raw -%}
                        {% render 'rs-variant-effective-price', variant: variant %}
                      {%- endcapture -%}
                      {%- assign bundle_variant_effective_price = bundle_variant_effective_price_raw | strip | plus: 0 -%}
                      {%- if variant.available and bundle_variant_effective_price > 0 -%}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ bundle_variant_effective_price }}"
                          data-compare-at-price="{% if variant.compare_at_price > bundle_variant_effective_price and variant.compare_at_price > 0 %}{{ variant.compare_at_price }}{% else %}{{ bundle_variant_effective_price }}{% endif %}"
                          {% if variant.featured_image != blank %}
                            data-image="{{ variant.featured_image | image_url: width: 300 }}"
                          {% endif %}
                        >
                          {{ variant.title }}
                        </option>
                      {% endif %}
                    {% endfor %}
                  </select>

                  <div class="select-wrapper__icon">
                    {% render 'icon', icon: 'keyboard_arrow_down' %}
                  </div>
                </div>
              </div>

              {% if forloop.first and request.visual_preview_mode and block.settings.title != 'Bundle' %}
                {% break %}
              {% endif %}
            {% endfor %}
          </div>

          <div class="cross-sell__form" data-ref="add-to-cart-form">
            <button
              data-ref="add-to-cart-button"
              class="button button--small{% if block.settings.button_content_type == 'icon' and block.settings.price_position != 'inside_cart_add_button' %} button--icon-only{% endif %}"
              {% if all_available == false %}
                disabled
              {% endif %}
            >
              <span class="button__content">
                {%- if all_available == false -%}
                  {% if block.settings.button_content_type == 'icon' %}
                    {% render 'icon', icon: 'block' %}
                  {% else %}
                    {{ 'products.add_to_cart_unavailable' | t }}
                  {% endif %}
                {%- else -%}
                  {% if block.settings.button_content_type == 'icon' %}
                    {% render 'icon', icon: block.settings.button_content_icon %}
                  {% else %}
                    {{ 'products.add' | t }}
                  {% endif %}

                  {% if block.settings.price_position == 'inside_cart_add_button' %}
                    <span class="button__separator">|</span>

                    {% render 'price', price: price, compare_price: compare_at_price, sales_badge: 'none' %}
                  {% endif %}
                {%- endif -%}
              </span>

              {% render 'loading-spinner' %}
            </button>
          </div>
        </div>
      </div>
    </div>
  </cross-sell-component>
{% endif %}

{% schema %}
{
  "name": "t:cross_sell",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "show_on_display",
      "label": "t:show_on_display",
      "default": "desktop_and_mobile",
      "options": [
        { "value": "desktop_and_mobile", "label": "t:desktop_and_mobile" },
        { "value": "desktop_only", "label": "t:desktop_only" },
        { "value": "mobile_only", "label": "t:mobile_only" }
      ]
    },
    {
      "type": "header",
      "content": "t:style"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:display_mode",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "t:row"
        },
        {
          "value": "column",
          "label": "t:column"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_card_border",
      "label": "t:show_card_border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:products",
      "info": "t:cross_sell_products_info"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:title_optional"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:description_optional"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:show_image",
      "default": true
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:image_width",
      "default": 75,
      "min": 60,
      "max": 90,
      "step": 5,
      "unit": "px",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:image_optional",
      "info": "t:image_cross_sell_optional_info",
      "visible_if": "{{ block.settings.show_image }}"
    },
    {
      "type": "checkbox",
      "id": "show_options_label",
      "label": "t:show_options_label",
      "default": false
    },
    {
      "type": "select",
      "id": "price_position",
      "label": "t:cross_sell_price_position",
      "options": [
        { "value": "next_to_title", "label": "t:next_to_title" },
        { "value": "below_title", "label": "t:below_title" },
        { "value": "inside_cart_add_button", "label": "t:inside_cart_add_button" }
      ],
      "default": "next_to_title"
    },
    {
      "type": "select",
      "id": "button_content_type",
      "label": "t:button_content_type",
      "options": [
        { "value": "text", "label": "t:text" },
        { "value": "icon", "label": "t:icon" }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "button_content_icon",
      "label": "t:icon",
      "options": [
        { "value": "local_mall", "label": "t:icons_list.local_mall" },
        { "value": "garden_cart", "label": "t:icons_list.garden_cart" },
        { "value": "shopping_cart", "label": "t:icons_list.shopping_cart" },
        { "value": "shop", "label": "t:icons_list.shop" },
        { "value": "work", "label": "t:icons_list.work" },
        { "value": "money_bag", "label": "t:icons_list.money_bag" },
        { "value": "luggage", "label": "t:icons_list.luggage" },
        { "value": "shopping_bag", "label": "t:icons_list.shopping_bag" },
        { "value": "shopping_basket", "label": "t:icons_list.shopping_basket" },
        { "value": "shopping_bag_speed", "label": "t:icons_list.shopping_bag_speed" },
        { "value": "store", "label": "t:icons_list.store" },
        { "value": "storefront", "label": "t:icons_list.storefront" },
        { "value": "add", "label": "t:icons_list.add" },
        { "value": "bolt", "label": "t:icons_list.bolt" }
      ],
      "default": "add",
      "visible_if": "{{ block.settings.button_content_type == 'icon' }}"
    },
    {
      "type": "header",
      "content": "t:margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:margin_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:margin_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:advanced_settings"
    },
    {
      "type": "text",
      "id": "additional_class",
      "label": "t:additional_class",
      "info": "t:additional_class_info"
    },
    {
      "type": "header",
      "content": "t:go_further"
    },
    {
      "type": "paragraph",
      "content": "t:go_further_description"
    }
  ],
  "presets": [
    {
      "name": "t:cross_sell",
      "category": "t:cross_sell_and_upsell"
    },
    {
      "name": "t:cross_sell_column",
      "category": "t:cross_sell_and_upsell",
      "settings": {
        "display_mode": "column"
      }
    },
    {
      "name": "t:up_sell",
      "category": "t:cross_sell_and_upsell",
      "settings": {
        "title": "t:cross_sell_bundle_title_default",
        "description": "t:cross_sell_bundle_description_default"
      }
    }
  ]
}
{% endschema %}
