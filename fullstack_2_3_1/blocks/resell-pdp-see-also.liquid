{% liquid
  assign rl_product = closest.product | default: product
%}
{% render 'product-pdp-crawl-links', product: rl_product %}

{% stylesheet %}
  .rl-pdp-explore {
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid rgb(0 0 0 / 8%);
  }

  .rl-pdp-explore__label {
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 55%);
  }

  .rl-pdp-explore__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rl-pdp-explore__link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 12px;
    border: 1px solid rgb(0 0 0 / 12%);
    border-radius: 999px;
    color: inherit;
    font-size: 0.8125rem;
    line-height: 1.2;
    text-decoration: none;
    background: rgb(255 255 255);
  }

  .rl-pdp-explore__link:hover {
    border-color: rgb(0 0 0 / 28%);
    text-decoration: none;
  }

  .rl-pdp-explore__link--cta {
    border-color: rgb(0 0 0 / 85%);
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "À voir aussi",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "À voir aussi",
      "category": "Product"
    }
  ]
}
{% endschema %}
