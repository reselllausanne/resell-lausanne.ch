            "text_style": "h3",
            "font_weight": 400,
            "alignment": "center",
            "alignment_mobile": "center",
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
        "nl_desc": {
          "type": "text",
          "settings": {
            "show_on_display": "desktop_and_mobile",
            "text": "<p>Et obtiens 10 CHF sur ta première commande.</p>",
            "text_style": "paragraph",
            "font_weight": 400,
            "alignment": "center",
            "alignment_mobile": "center",
            "margin_top": 0,
            "margin_bottom": 0
          }
        },
